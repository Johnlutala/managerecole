
{% extends 'base.html.twig' %}

{% block title %}Parents{% endblock %}

{% block body %}
    <div class="wrapper">
        <div class="content-page">
            <div class="container-fluid">

                {# MESSAGES FLASH #}
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type in ['success', 'danger', 'warning'] ? type : 'info' }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {# TITRE DE PAGE #}
                <div class="page-title-head d-flex align-items-center mb-3">
                    <div class="flex-grow-1">
                        <h4 class="fs-xl fw-bold m-0">Tous les parents</h4>
                    </div>

                    <div class="text-end">
                        <ol class="breadcrumb m-0 py-0">
                            <li class="breadcrumb-item">
                                <a href="javascript:void(0);">ADMIN</a>
                            </li>
                            <li class="breadcrumb-item active">
                                <a href="{{ path('app_parents_index') }}">Parents</a>
                            </li>
                        </ol>
                    </div>
                </div>

                {# TABLEAU DES PARENTS #}
                <div data-table data-table-rows-per-page="8" class="card">

                    <div class="card-header border-light d-flex justify-content-between align-items-center">
                        <div class="app-search">
                            <input
                                data-table-search
                                type="search"
                                class="form-control"
                                placeholder="Rechercher..."
                            >
                            <i data-lucide="search" class="app-search-icon text-muted"></i>
                        </div>

                        {% if is_granted('ROLE_ADMIN') %}
                            <button
                                type="button"
                                class="btn btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#addModal"
                            >
                                <i class="ti ti-plus me-1"></i>
                                Ajouter
                            </button>
                        {% endif %}
                    </div>

                    <div class="table-responsive">
                        <table class="table table-custom table-centered table-hover w-100 mb-0">

                            <thead class="bg-light bg-opacity-25 thead-sm">
                                <tr class="text-uppercase fs-xxs">
                                    <th>#</th>
                                    <th>Nom</th>
                                    <th>Postnom</th>
                                    <th>Prénom</th>
                                    <th>Tuteur</th>
                                    <th>E-mail</th>
                                    <th>Compte</th>
                                    <th class="text-center">Nombre d'élèves</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                {% for parent in parents %}
                                    <tr>
                                        <td>{{ loop.index }}</td>
                                        <td>{{ parent.nom }}</td>
                                        <td>{{ parent.postnom }}</td>
                                        <td>{{ parent.prenom }}</td>
                                        <td>{{ parent.type }}</td>
                                        <td>{{ parent.email ?: '—' }}</td>

                                        <td>
                                            {% if parent.user %}
                                                <span class="badge {{ parent.user.enabled ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary' }}">
                                                    {{ parent.user.enabled ? 'Actif' : 'Fermé' }}
                                                </span>
                                            {% else %}
                                                <span class="badge bg-warning-subtle text-warning">
                                                    Aucun compte
                                                </span>
                                            {% endif %}
                                        </td>

                                        <td class="text-center">
                                            {{ parent.eleve|length }}
                                        </td>

                                        <td>
                                            <div class="d-flex justify-content-center gap-1">

                                                <a
                                                    href="{{ path('app_parents_show', {id: parent.id}) }}"
                                                    class="btn btn-default btn-icon btn-sm rounded-circle"
                                                    title="Voir"
                                                >
                                                    <i class="ti ti-eye fs-lg"></i>
                                                </a>

                                                {% if is_granted('ROLE_ADMIN') %}
                                                    <a
                                                        href="{{ path('app_parents_edit', {id: parent.id}) }}"
                                                        class="btn btn-default btn-icon btn-sm rounded-circle"
                                                        title="Modifier"
                                                    >
                                                        <i class="ti ti-edit fs-lg"></i>
                                                    </a>

                                                    <button
                                                        type="button"
                                                        class="btn btn-default btn-icon btn-sm rounded-circle"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#accountModal-parent-{{ parent.id }}"
                                                        title="Gérer les identifiants"
                                                        aria-label="Gérer les identifiants de {{ parent.nom }}"
                                                    >
                                                        <i class="ti ti-key fs-lg"></i>
                                                    </button>
                                                {% endif %}

                                            </div>
                                        </td>
                                    </tr>

                                {% else %}
                                    <tr>
                                        <td colspan="9" class="text-center py-5 text-muted">
                                            Aucun enregistrement trouvé.
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>

                        </table>
                    </div>

                    {# PAGINATION #}
                    <div class="card-footer border-0 d-flex justify-content-between align-items-center">
                        <div data-table-pagination-info></div>
                        <div data-table-pagination></div>
                    </div>

                </div>

                {# MODALES DE GESTION DES COMPTES #}
                {% if is_granted('ROLE_ADMIN') %}
                    {% for parent in parents %}
                        {% include 'account/_manage_modal.html.twig' with {
                            accountType: 'parent',
                            accountId: parent.id,
                            accountLabel: 'Parent',
                            displayName: parent.prenom ~ ' ' ~ parent.nom,
                            username: 'PAR' ~ parent.id,
                            email: parent.email,
                            accountUser: parent.user,
                            routePrefix: 'app_parents',
                            returnTo: 'index'
                        } %}
                    {% endfor %}
                {% endif %}

            </div>
        </div>
    </div>

    {# MODALE D'AJOUT D'UN PARENT #}
    {% if is_granted('ROLE_ADMIN') %}
        <div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">

                    {{ form_start(form) }}

                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="addModalLabel">
                            Nouveau parent
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>

                    <div class="modal-body">
                        {% include 'crud/_form_fields.html.twig' with {form: form} %}
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                            Annuler
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>
                            Enregistrer
                        </button>
                    </div>

                    {{ form_end(form) }}

                </div>
            </div>
        </div>
    {% endif %}

{% endblock %}
