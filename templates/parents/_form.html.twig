{{ form_start(form) }}

<div class="row g-3">

    {# ==================== IDENTITÉ ==================== #}

    <div class="col-12">
        <h5 class="border-bottom pb-2 mb-3">
            <i class="ti ti-user me-1"></i>
            Informations personnelles
        </h5>
    </div>

    <div class="col-md-4">
        {{ form_row(form.nom, {
            label: 'Nom',
            attr: {
                class: 'form-control',
                placeholder: 'Nom'
            }
        }) }}
    </div>

    <div class="col-md-4">
        {{ form_row(form.postnom, {
            label: 'Postnom',
            attr: {
                class: 'form-control',
                placeholder: 'Postnom'
            }
        }) }}
    </div>

    <div class="col-md-4">
        {{ form_row(form.prenom, {
            label: 'Prénom',
            attr: {
                class: 'form-control',
                placeholder: 'Prénom'
            }
        }) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.telephone, {
            label: 'Téléphone',
            attr: {
                class: 'form-control',
                placeholder: 'Numéro de téléphone'
            }
        }) }}
    </div>

    <div class="col-md-4">
        {{ form_row(form.email, {
            label: 'Adresse e-mail',
            attr: {
                class: 'form-control',
                placeholder: 'exemple@email.com'
            }
        }) }}
    </div>

    <div class="col-md-4">
        {{ form_row(form.adresse, {
            label: 'Adresse',
            attr: {
                class: 'form-control',
                placeholder: 'Adresse'
            }
        }) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.profession, {
            label: 'Profession',
            attr: {
                class: 'form-control',
                placeholder: 'Profession'
            }
        }) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.type, {
            label: 'Type de parent',
            attr: {
                class: 'form-control',
                placeholder: 'Père, Mère, Tuteur...'
            }
        }) }}
    </div>
    

    {# ==================== BOUTONS ==================== #}

    <div class="col-12 mt-4">

        <div class="d-flex justify-content-end gap-2">

            <a
                href="{{ path('app_parents_index') }}"
                class="btn btn-light"
            >

                <i class="ti ti-x me-1"></i>
                Annuler

            </a>

            <button type="submit" class="btn btn-primary">

                <i class="ti ti-device-floppy me-1"></i>
                {{ button_label|default('Enregistrer') }}

            </button>

        </div>

    </div>

</div>

{{ form_end(form) }}
