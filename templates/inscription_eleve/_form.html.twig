{{ form_start(form, {attr: { class: 'w-100'}}) }}


<div class="card border mb-3">

    <div class="card-header">
        <h5 class="card-title mb-0">
            <i class="ti ti-file-description me-2"></i>
            Informations de l'inscription
        </h5>
    </div>

    <div class="card-body">

        <div class="row g-3">

            {# Référence #}
            <div class="col-md-6">
                {{ form_row(form.reference, {
                    label: 'Matricule / référence',
                    attr: {
                        class: 'form-control',
                        placeholder: 'Ex. INS-2026-001'
                    }
                }) }}
            </div>

            {# Type d'inscription #}
            <div class="col-md-6">
                {{ form_row(form.typeInscription, {
                    label: "Type d'élève",
                    attr: {
                        class: 'form-select'
                    }
                }) }}
            </div>

        </div>

    </div>

</div>


