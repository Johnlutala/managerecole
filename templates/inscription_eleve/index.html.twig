{% extends 'base.html.twig' %}
{% block title %}Inscriptions des élèves{% endblock %}
{% block body %}
<div class="wrapper"><div class="content-page"><div class="container-fluid">
  <div class="page-title-head d-flex align-items-center"><div class="flex-grow-1"><h4 class="fs-xl fw-bold m-0">Inscriptions des élèves</h4><p class="text-muted mb-0">Demandes à valider avant la création définitive de l'élève.</p></div></div>
  {% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type == 'success' ? 'success' : 'info' }}">{{ message }}</div>{% endfor %}{% endfor %}
  <div data-table data-table-rows-per-page="8" class="card"><div class="card-header border-light d-flex justify-content-between"><div class="app-search"><input data-table-search type="search" class="form-control" placeholder="Rechercher..."></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#inscriptionModal"><i class="ti ti-plus me-1"></i>Nouvelle inscription</button></div>
  <div class="table-responsive"><table class="table table-custom table-centered table-hover w-100 mb-0"><thead class="bg-light bg-opacity-25 thead-sm"><tr class="text-uppercase fs-xxs"><th>Référence</th><th>Élève</th><th>Classe</th><th>Type</th><th>Statut</th><th class="text-center">Actions</th></tr></thead><tbody>{% for item in inscription_eleves %}<tr><td>{{ item.reference ?: '—' }}</td><td>{{ item.nom }} {{ item.postnom }} {{ item.prenom }}</td><td>{{ item.classe ? item.classe.nom : '—' }}</td><td><span class="badge badge-soft-info">{{ item.typeInscription ?: '—' }}</span></td><td><span class="badge badge-soft-{{ item.statut == 'validee' ? 'success' : 'warning' }}">{{ item.statut|replace({'_': ' '})|title }}</span></td><td><div class="d-flex justify-content-center gap-1"><a href="{{ path('app_inscription_eleve_show', {id: item.id}) }}" class="btn btn-default btn-icon btn-sm rounded-circle"><i class="ti ti-eye fs-lg"></i></a><a href="{{ path('app_inscription_eleve_edit', {id: item.id}) }}" class="btn btn-default btn-icon btn-sm rounded-circle"><i class="ti ti-edit fs-lg"></i></a>{% if item.statut != 'validee' %}<form method="post" action="{{ path('app_inscription_eleve_validate', {id: item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('validate' ~ item.id) }}"><button class="btn btn-success btn-sm">Valider</button></form>{% endif %}</div></td></tr>{% else %}<tr><td colspan="6" class="text-center py-5 text-muted">Aucune demande d'inscription.</td></tr>{% endfor %}</tbody></table></div><div class="card-footer border-0 d-flex justify-content-between"><div data-table-pagination-info></div><div data-table-pagination></div></div></div>
</div></div></div>
<div class="modal fade" id="inscriptionModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">{{ form_start(form, {attr: {id: 'inscription-form', novalidate: 'novalidate'}}) }}<div class="modal-header"><div><h5 class="modal-title">Inscription élève</h5><small class="text-muted">Les informations seront sauvegardées comme demande en attente de validation.</small></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">
<div class="d-flex align-items-center gap-2 mb-4 step-meter">{% for label in ['Recherche', 'Élève', 'Parent / tuteur', 'Scolarité'] %}<span class="step-chip {{ loop.first ? 'is-active' : '' }}" data-step-chip="{{ loop.index }}"><b>{{ loop.index }}</b><small>{{ label }}</small></span>{% endfor %}</div>
<div class="form-step" data-form-step="1"><div class="alert alert-light border">Commencez par identifier l'élève. Pour un ancien élève, saisissez son matricule puis lancez la recherche.</div><div class="row g-3"><div class="col-md-6">{{ form_row(form.typeInscription) }}</div><div class="col-md-6">{{ form_row(form.reference) }}<button class="btn btn-outline-primary btn-sm mt-1" type="button" id="lookup-student">Rechercher dans la base</button></div></div><div id="lookup-result" class="mt-3"></div></div>
<div class="form-step d-none" data-form-step="2"><h6>Identité de l'élève</h6><div class="row g-3"><div class="col-md-4">{{ form_row(form.nom) }}</div><div class="col-md-4">{{ form_row(form.postnom) }}</div><div class="col-md-4">{{ form_row(form.prenom) }}</div><div class="col-md-4">{{ form_row(form.sexe) }}</div><div class="col-md-4">{{ form_row(form.dateNaissance) }}</div><div class="col-md-4">{{ form_row(form.lieuNaissance) }}</div><div class="col-md-6">{{ form_row(form.nationalite) }}</div><div class="col-md-6">{{ form_row(form.telephone) }}</div><div class="col-12">{{ form_row(form.adresse) }}</div></div></div>
<div class="form-step d-none" data-form-step="3"><h6>Parent ou tuteur légal</h6><div class="row g-3"><div class="col-md-4">{{ form_row(form.nomParent) }}</div><div class="col-md-4">{{ form_row(form.postnomParent) }}</div><div class="col-md-4">{{ form_row(form.prenomParent) }}</div><div class="col-md-4">{{ form_row(form.telephoneParent) }}</div><div class="col-md-4">{{ form_row(form.emailParent) }}</div><div class="col-md-4">{{ form_row(form.lienParental) }}</div><div class="col-md-6">{{ form_row(form.professionParent) }}</div><div class="col-md-6">{{ form_row(form.adresseParent) }}</div></div></div>
<div class="form-step d-none" data-form-step="4"><h6>Affectation scolaire</h6><div class="row g-3"><div class="col-md-6">{{ form_row(form.etablissement) }}</div><div class="col-md-6">{{ form_row(form.anneeScolaire) }}</div><div class="col-md-4">{{ form_row(form.section) }}</div><div class="col-md-4">{{ form_row(form.classe) }}</div><div class="col-md-4">{{ form_row(form.options) }}</div></div><div class="alert alert-info mt-3 mb-0">Après l'enregistrement, utilisez le bouton <strong>Valider</strong> dans la liste pour créer ou mettre à jour l'élève et enregistrer le parent.</div></div>
</div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button><button type="button" class="btn btn-secondary d-none" data-step-prev>Précédent</button><button type="button" class="btn btn-primary" data-step-next>Suivant</button><button type="submit" class="btn btn-success d-none" data-step-save>Enregistrer la demande</button></div>{{ form_end(form) }}</div></div></div>
<style>.step-chip{display:flex;align-items:center;gap:.45rem;color:#98a6ad}.step-chip b{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:#e9ecef}.step-chip small{font-weight:600}.step-chip.is-active{color:#0d6efd}.step-chip.is-active b{background:#0d6efd;color:#fff}</style>
<script>document.addEventListener('DOMContentLoaded',()=>{let step=1;const form=document.querySelector('#inscription-form'),show=n=>{step=n;document.querySelectorAll('[data-form-step]').forEach(x=>x.classList.toggle('d-none',+x.dataset.formStep!==n));document.querySelectorAll('[data-step-chip]').forEach(x=>x.classList.toggle('is-active',+x.dataset.stepChip===n));document.querySelector('[data-step-prev]').classList.toggle('d-none',n===1);document.querySelector('[data-step-next]').classList.toggle('d-none',n===4);document.querySelector('[data-step-save]').classList.toggle('d-none',n!==4)};document.querySelector('[data-step-next]').onclick=()=>{const inputs=[...document.querySelector(`[data-form-step="${step}"]`).querySelectorAll('input,select')];if(inputs.some(x=>!x.checkValidity())){form.classList.add('was-validated');return}show(step+1)};document.querySelector('[data-step-prev]').onclick=()=>show(step-1);document.querySelector('#lookup-student').onclick=async()=>{const ref=document.querySelector('#inscription_eleve_reference').value,result=document.querySelector('#lookup-result');if(!ref){result.innerHTML='<span class="text-danger">Saisissez un matricule.</span>';return}const data=await fetch(`{{ path('app_inscription_eleve_lookup') }}?reference=${encodeURIComponent(ref)}`).then(r=>r.json());if(!data.found){result.innerHTML='<span class="text-warning">Aucun élève trouvé : poursuivez comme nouvel élève.</span>';return}Object.entries(data.eleve).forEach(([k,v])=>{const el=document.querySelector(`#inscription_eleve_${k}`);if(el&&v!==null)el.value=v});document.querySelector('#inscription_eleve_typeInscription').value='ancien';result.innerHTML='<span class="text-success">Élève existant trouvé : ses informations ont été récupérées.</span>'};});</script>
{% endblock %}
