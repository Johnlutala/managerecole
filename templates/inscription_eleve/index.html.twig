{% extends 'base.html.twig' %}
{% block title %}Inscriptions des élèves{% endblock %}
{% block body %}
  <div class="wrapper">
    <div class="content-page">
      <div class="container-fluid">
        <div class="page-title-head d-flex align-items-center">
          <div class="flex-grow-1">
            <h4 class="fs-xl fw-bold m-0">Inscriptions des élèves</h4>
            <p class="text-muted mb-0">Demandes à valider avant la création définitive de l'élève.</p>
          </div>
        </div>
        {% for type, messages in app.flashes %}{% for message in messages %}
            <div class="alert alert-{{ type == 'success' ? 'success' : 'info' }}">{{ message }}

            </div>{% endfor %}{% endfor %}
        <div data-table data-table-rows-per-page="8" class="card">
          <div class="card-header border-light d-flex justify-content-between">
            <div class="app-search">
              <input data-table-search type="search" class="form-control" placeholder="Rechercher...">
            </div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#inscriptionModal">
              <i class="ti ti-plus me-1"></i>Nouvelle inscription</button>
          </div>

          <div class="table-responsive">
            <table class="table table-custom table-centered table-hover w-100 mb-0">
              <thead class="bg-light bg-opacity-25 thead-sm">
                <tr class="text-uppercase fs-xxs">
                  <th></th>
                  <th>Élève</th>
                  <th>Classe</th>
                  <th>Ecole</th>
                  <th>Année Scolaire</th>
                  <th>Type</th>
                  <th>Statut</th>
                  <th>Etat</th>
                  <th class="text-center">Actions</th>
                </tr>
              </thead>
              <tbody>{% for item in inscription_eleves %}
                  <tr>
                    <td>{{ loop.index }}</td>
                    <td>{{ item.nom }} {{ item.postnom }} {{ item.prenom }}</td>
                    <td>
                      {{ item.classe ? item.classe.nom : '—' }}
                    </td>
                    <td>
                      {{ item.etablissement ? item.etablissement.nom : '—' }}
                    </td>
                    <td>
                      {{ item.anneeScolaire ? item.anneeScolaire.libelle : '—' }}
                    </td>
                    <td>
                      <span class="badge badge-soft-info">
                        {{ item.typeInscription ?: '—' }}
                      </span>
                    </td>
                    <td><span class="badge badge-soft-info">
                        {{ item.typeInscription ?: '—' }}</span>
                    </td>
                    <td><span class="badge badge-soft-{{ item.statut == 'validee' ? 'success' : 'warning' }}">
                        {{ item.statut|replace({'_': ' '})|title }}</span>
                    </td>
                    
                    <td>
                      <div class="d-flex justify-content-center gap-1">
                        <a href="{{ path('app_inscription_eleve_show', {id: item.id}) }}" class="btn btn-default btn-icon btn-sm rounded-circle">
                          <i class="ti ti-eye fs-lg"></i></a>
                        <a href="{{ path('app_inscription_eleve_edit', {id: item.id}) }}" class="btn btn-default btn-icon btn-sm rounded-circle">
                          <i class="ti ti-edit fs-lg"></i></a>
                        {% if item.statut != 'validee' %}
                          <form
                            method="post"
                            action="{{ path('app_inscription_eleve_validate', {id: item.id}) }}"
                            class="form-validation-inscription"
                            data-eleve="{{ item.nom }} {{ item.postnom }} {{ item.prenom }}"
                          >
                            <input type="hidden" name="_token"
                              value="{{ csrf_token('validate' ~ item.id) }}"
                            >

                            <button type="submit" class="btn btn-success btn-sm">
                              <i class="fas fa-check-circle"></i> Valider
                            </button>
                          </form>
                        {% endif %}
                      </div>
                    </td>
                  </tr>
                {% else %}
                  <tr>
                    <td colspan="6" class="text-center py-5 text-muted">Aucune demande d'inscription.</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          <div class="card-footer border-0 d-flex justify-content-between">
            <div data-table-pagination-info></div>
            <div data-table-pagination></div>
          </div>
        </div>
      </div>
    </div>
  </div>


  <div class="modal fade" id="inscriptionModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
      <div class="modal-content">
        {{ form_start(form, {attr: {id: 'inscription-form', novalidate: 'novalidate'}}) }}
        <div class="modal-header"><div><h5 class="modal-title">Inscription élève</h5>
            <small class="text-muted">Les informations seront sauvegardées comme demande en attente de validation.</small>
          </div><button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div><div class="modal-body">
          <div class="d-flex align-items-center gap-2 mb-4 step-meter">
            {% for label in ['Recherche', 'Élève', 'Parent / tuteur', 'Scolarité'] %}
              <span class="step-chip {{ loop.first ? 'is-active' : '' }}" data-step-chip="{{ loop.index }}"><b>
                  {{ loop.index }}</b><small>{{ label }}</small></span>{% endfor %}</div>
      
        
          <div class="form-step" data-form-step="1">

            <div class="mb-3">
              <h6 class="mb-1">Type d'inscription</h6>
              <p class="text-muted mb-0">
                Sélectionnez le type d'élève à inscrire.
              </p>
            </div>

            {# Champ Symfony conservé mais masqué #}
            <div class="d-none">
              {{ form_row(form.typeInscription) }}
            </div>

            <div class="enrollment-types">

              {# Ancien élève #}
              <div class="enrollment-type">

                <input
                  type="radio"
                  name="inscription_type_choice"
                  id="type-ancien"
                  value="ancien"
                >

                <label for="type-ancien" class="enrollment-option">

                  <div class="enrollment-option-icon">
                    <i class="ti ti-user-search"></i>
                  </div>

                  <div class="enrollment-option-text">
                    <strong>Ancien élève</strong>
                    <span>Élève déjà enregistré</span>
                  </div>

                  <div class="enrollment-option-check">
                    <i class="ti ti-check"></i>
                  </div>

                </label>
              </div>


              {# Nouvel élève #}
              <div class="enrollment-type">
                <input type="radio" name="inscription_type_choice" id="type-nouveau" value="nouveau">
                <label for="type-nouveau" class="enrollment-option">
                  <div class="enrollment-option-icon">
                    <i class="ti ti-user-plus"></i>
                  </div>
                  <div class="enrollment-option-text">
                    <strong>Nouvel élève</strong>
                    <span>Créer une nouvelle fiche</span>
                  </div>
                  <div class="enrollment-option-check">
                    <i class="ti ti-check"></i>
                  </div>

                </label>
              </div>

            </div>


            {# ============================= #}
            {# RECHERCHE ANCIEN ÉLÈVE         #}
            {# ============================= #}

            <div id="ancien-eleve-search" class="d-none mt-4">
              <div class="student-search-box">
                <div class="student-search-header">
                  <div class="student-search-icon">
                    <i class="ti ti-search"></i>
                  </div>
                  <div>
                    <h6>Rechercher l'élève</h6>
                    <p>
                      Entrez le matricule ou la référence de l'élève.
                    </p>
                  </div>

                </div>
                <div class="row g-3 align-items-end">

                  <div class="col-md-8">
                    <label class="form-label">
                      Matricule / Référence
                    </label>

                    {{ form_widget(form.reference, {
                        attr: { class: 'form-control form-control-lg',placeholder: 'Rechercher par son : Matricule, Nom ou encore Postnom' }
                    }) }}
                  </div>
                  <div class="col-md-4">
                    <button
                      type="button"
                      id="lookup-student"
                      class="btn btn-primary btn-lg w-100"
                    >
                      <i class="ti ti-search me-1"></i>
                      Rechercher
                    </button>
                  </div>
                </div>
                <div id="lookup-result" class="mt-3"></div>
              </div>
            </div>
          </div>

          <div class="form-step d-none" data-form-step="2">
            <h6>Identité de l'élève</h6><div class="row g-3">
              <div class="col-md-4">{{ form_row(form.nom) }}</div>
              <div class="col-md-4">{{ form_row(form.postnom) }}</div>
              <div class="col-md-4">{{ form_row(form.prenom) }}</div>
              <div class="col-md-4">{{ form_row(form.sexe) }}</div>
              <div class="col-md-4">{{ form_row(form.dateNaissance) }}</div>
              <div class="col-md-4">{{ form_row(form.lieuNaissance) }}</div>
              <div class="col-md-4">
    {{ form_label(form.email) }}

    {{ form_widget(form.email, {
        attr: {
            'data-check-url': path('app_inscription_eleve_verifier_email'),
            'aria-describedby': 'email-feedback'
        }
    }) }}

    <div id="email-feedback"
         class="small mt-1"
         aria-live="polite">
    </div>

    {{ form_errors(form.email) }}
</div>
              <div class="col-md-4">{{ form_row(form.telephone) }}</div>
              <div class="col-4">{{ form_row(form.adresse) }}</div>
            </div>
          </div>
          <div class="form-step d-none" data-form-step="3">
            <h6>Parent ou tuteur légal</h6>
            <div class="row g-3">
              <div class="col-md-4">{{ form_row(form.nomParent) }}</div>
              <div class="col-md-4">{{ form_row(form.postnomParent) }}</div>
              <div class="col-md-4">{{ form_row(form.prenomParent) }}</div>
              <div class="col-md-4">{{ form_row(form.telephoneParent) }}</div>
              <div class="col-md-4">{{ form_row(form.emailParent) }}</div>
              <div class="col-md-4">{{ form_row(form.lienParental) }}</div>
              <div class="col-md-6">{{ form_row(form.professionParent) }}</div>
              <div class="col-md-6">{{ form_row(form.adresseParent) }}</div>
            </div>
          </div>
          <div class="form-step d-none" data-form-step="4">
            <h6>Affectation scolaire</h6>

            <div class="row g-3">

              {# 1. Établissement #}
              <div class="col-md-6">
                {{ form_row(form.etablissement) }}
              </div>

              <div class="col-md-6">
                {{ form_row(form.anneeScolaire) }}
              </div>
              <div class="col-md-4">
                {{ form_row(form.section) }}
              </div>
              <div class="col-md-4">
                {{ form_row(form.classe) }}
              </div>
              <div class="col-md-4">
                {{ form_row(form.options) }}
              </div>

            </div>

            <div class="alert alert-info mt-3 mb-0">
              <i class="ti ti-info-circle me-1"></i>
              Après l'enregistrement, utilisez le bouton
              <strong>Valider</strong> dans la liste pour créer ou mettre à jour
              l'élève et enregistrer le parent.
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
          <button type="button" class="btn btn-secondary d-none" data-step-prev>Précédent</button>
          <button type="button" class="btn btn-primary" data-step-next>Suivant</button>
          <button type="submit" class="btn btn-success d-none" data-step-save>Enregistrer</button>
        </div>{{ form_end(form) }}</div>
    </div>
  </div>
  <style>
    .step-chip {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      color: #98a6ad;
    }
    .step-chip b {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: #e9ecef;
    }

    .step-chip small {
      font-weight: 600;
    }
    .step-chip.is-active {
      color: #0d6efd;
    }
    .step-chip.is-active b {
      background: #0d6efd;
      color: #fff;
    }
    .inscription-choice {
      cursor: pointer;
    }

    .enrollment-types {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .enrollment-type {
      position: relative;
    }

    .enrollment-type input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .enrollment-option {
      display: flex;
      align-items: center;
      gap: 14px;
      min-height: 78px;
      padding: 14px 16px;

      border: 1px solid #e5e7eb;
      border-radius: 10px;
      background: #fff;

      cursor: pointer;

      transition: all 0.2s ease;
    }

    .enrollment-option:hover {
      border-color: #b8c4d1;
      background: #f8fafc;
    }

    .enrollment-option-icon {
      width: 44px;
      height: 44px;
      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 9px;

      background: #f1f5f9;
      color: #64748b;

      font-size: 20px;

      transition: all 0.2s ease;
    }

    .enrollment-option-text {
      flex: 1;

      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .enrollment-option-text strong {
      color: #1e293b;
      font-size: 14px;
      font-weight: 600;
    }

    .enrollment-option-text span {
      color: #94a3b8;
      font-size: 12px;
    }

    .enrollment-option-check {
      width: 21px;
      height: 21px;

      display: flex;
      align-items: center;
      justify-content: center;

      border: 1px solid #d1d5db;
      border-radius: 50%;

      color: transparent;
      font-size: 11px;

      transition: all 0.2s ease;
    }

    .enrollment-type input:checked + .enrollment-option {
      border-color: #0d6efd;
      background: #f8fbff;
    }

    .enrollment-type input:checked + .enrollment-option .enrollment-option-icon {
      background: #0d6efd;
      color: #fff;
    }

    .enrollment-type input:checked + .enrollment-option .enrollment-option-check {
      border-color: #0d6efd;
      background: #0d6efd;
      color: #fff;
    }

    /* ========================= */
    /* RECHERCHE ANCIEN ÉLÈVE    */
    /* ========================= */

    .student-search-box {
      padding: 20px;

      border: 1px solid #e5e7eb;
      border-radius: 12px;

      background: #f8fafc;
    }

    .student-search-header {
      display: flex;
      align-items: center;
      gap: 12px;

      margin-bottom: 18px;
    }

    .student-search-icon {
      width: 40px;
      height: 40px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 9px;

      background: #eaf2ff;
      color: #0d6efd;

      font-size: 18px;
    }

    .student-search-header h6 {
      margin: 0 0 3px;
      font-size: 14px;
      font-weight: 600;
      color: #1e293b;
    }

    .student-search-header p {
      margin: 0;
      font-size: 12px;
      color: #64748b;
    }

    #ancien-eleve-search {
      animation: searchBoxIn 0.2s ease;
    }

    @keyframes searchBoxIn {
      from {
        opacity: 0;
        transform: translateY(-5px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 700px) {
      .enrollment-types {
        grid-template-columns: 1fr;
      }
    }
  </style>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      let step = 1;

      const form = document.querySelector("#inscription-form");

      const nextButton = document.querySelector("[data-step-next]");
      const prevButton = document.querySelector("[data-step-prev]");
      const saveButton = document.querySelector("[data-step-save]");

      const typeAncien = document.querySelector("#type-ancien");
      const typeNouveau = document.querySelector("#type-nouveau");

      const ancienSearch = document.querySelector("#ancien-eleve-search");

      const typeInscription = document.querySelector(
        "#inscription_eleve_typeInscription",
      );

      const lookupButton = document.querySelector("#lookup-student");
      const referenceInput = document.querySelector("#inscription_eleve_reference");
      const lookupResult = document.querySelector("#lookup-result");

      const show = (n) => {
        step = n;

        document.querySelectorAll("[data-form-step]").forEach((x) => {
          x.classList.toggle("d-none", +x.dataset.formStep !== n);
        });

        document.querySelectorAll("[data-step-chip]").forEach((x) => {
          x.classList.toggle("is-active", +x.dataset.stepChip === n);
        });

        prevButton.classList.toggle("d-none", n === 1);
        nextButton.classList.toggle("d-none", n === 4);
        saveButton.classList.toggle("d-none", n !== 4);
      };

      show(1);
      typeAncien.addEventListener("change", () => {
        typeInscription.value = "ancien";
        ancienSearch.classList.remove("d-none");
        nextButton.disabled = true;
        lookupResult.innerHTML = "";
      });

      typeNouveau.addEventListener("change", () => {
        typeInscription.value = "nouveau";

        // Pas besoin de recherche
        ancienSearch.classList.add("d-none");

        // On peut directement passer au Step 2
        nextButton.disabled = false;

        lookupResult.innerHTML = "";
      });

      nextButton.addEventListener("click", () => {
        if (step === 1) {
          // Aucun choix
          if (!typeAncien.checked && !typeNouveau.checked) {
            return;
          }
          if (typeAncien.checked && nextButton.disabled) {
            return;
          }
        }

        const currentStep = document.querySelector(`[data-form-step="${step}"]`);
        const inputs = [...currentStep.querySelectorAll("input, select, textarea")];

        if (inputs.some((x) => !x.checkValidity())) {
          form.classList.add("was-validated");

          return;
        }
        show(step + 1);
      });

      prevButton.addEventListener("click", () => {
        show(step - 1);

        if (step === 1) {
          if (typeNouveau.checked) {
            nextButton.disabled = false;
          }

          if (typeAncien.checked) {
            nextButton.disabled = true;
          }
        }
      });

      lookupButton.addEventListener("click", async () => {
        const ref = referenceInput.value.trim();
        if (!ref) {
          lookupResult.innerHTML = `
                <div class="alert alert-warning mb-0">
                    <i class="ti ti-alert-circle me-1"></i>
                    Veuillez saisir un matricule ou une référence.
                </div>
            `;

          nextButton.disabled = true;

          referenceInput.focus();

          return;
        }

        lookupButton.disabled = true;
        nextButton.disabled = true;
        lookupButton.innerHTML = `
            <span
                class="spinner-border spinner-border-sm me-2"
                role="status"
                aria-hidden="true"
            ></span>
            Recherche...
        `;

        lookupResult.innerHTML = "";

        try {
          const response = await fetch(
            `{{ path('app_inscription_eleve_lookup') }}?reference=${encodeURIComponent(ref)}`,
          );

          if (!response.ok) {
            throw new Error("Erreur serveur");
          }

          const data = await response.json();
          if (!data.found) {
            lookupResult.innerHTML = `
                    <div class="alert alert-danger mb-0">
                        <i class="ti ti-user-x me-1"></i>
                        Aucun élève ne correspond à cette référence.
                    </div>
                `;

            nextButton.disabled = true;

            return;
          }

          Object.entries(data.eleve).forEach(([k, v]) => {
            const el = document.querySelector(`#inscription_eleve_${k}`);

            if (el && v !== null) {
              el.value = v;
            }
          });

          typeInscription.value = "ancien";

          lookupResult.innerHTML = `
                <div class="alert alert-success mb-0">
                    <i class="ti ti-circle-check me-1"></i>
                    Élève existant trouvé. Ses informations ont été récupérées.
                </div>
            `;
          /* Maintenant seulement, on autorise le passage au Step 2.*/
          nextButton.disabled = false;
        } catch (error) {
          console.error(error);

          lookupResult.innerHTML = `
                <div class="alert alert-danger mb-0">
                    <i class="ti ti-alert-circle me-1"></i>
                    Une erreur est survenue pendant la recherche.
                    Veuillez réessayer.
                </div>
            `;

          nextButton.disabled = true;
        } finally {
          lookupButton.disabled = false;
          lookupButton.innerHTML = `
                <i class="ti ti-search me-1"></i>
                Rechercher
            `;
        }
      });
    });

    document.addEventListener("DOMContentLoaded", function () {
      const ecoleSelect = document.querySelector(
        "#inscription_eleve_etablissement",
      );

      const anneeSelect = document.querySelector(
        "#inscription_eleve_anneeScolaire",
      );

      const sectionSelect = document.querySelector("#inscription_eleve_section");

      const classeSelect = document.querySelector("#inscription_eleve_classe");

      const optionSelect = document.querySelector("#inscription_eleve_options");

      if (
        !ecoleSelect ||
        !anneeSelect ||
        !sectionSelect ||
        !classeSelect ||
        !optionSelect
      ) {
        return;
      }

      /**
       * Vider un select
       */
      function resetSelect(select, placeholder) {
        select.innerHTML = "";

        const option = document.createElement("option");
        option.value = "";
        option.textContent = placeholder;

        select.appendChild(option);
        select.value = "";
      }

      /**
       * Charger les données dans un select
       */
      async function loadData(url, select, placeholder, labelField) {
        resetSelect(select, "Chargement...");
        select.disabled = true;

        try {
          const response = await fetch(url, {
            headers: {
              "X-Requested-With": "XMLHttpRequest",
              Accept: "application/json",
            },
          });

          if (!response.ok) {
            throw new Error("Erreur HTTP : " + response.status);
          }

          const data = await response.json();

          resetSelect(select, placeholder);

          data.forEach(function (item) {
            const option = document.createElement("option");

            option.value = item.id;
            option.textContent = item[labelField];

            select.appendChild(option);
          });

          select.disabled = data.length === 0;
        } catch (error) {
          console.error("Erreur chargement :", error);

          resetSelect(select, "Erreur de chargement");
          select.disabled = true;
        }
      }

      ecoleSelect.addEventListener("change", function () {
        const ecoleId = this.value;

        console.log("École sélectionnée :", ecoleId);

        // On remet les champs suivants à zéro
        resetSelect(anneeSelect, "Sélectionner une année scolaire");

        resetSelect(sectionSelect, "Sélectionner une section");

        resetSelect(classeSelect, "Sélectionner une classe");

        resetSelect(optionSelect, "Sélectionner une option");

        anneeSelect.disabled = true;
        sectionSelect.disabled = true;
        classeSelect.disabled = true;
        optionSelect.disabled = true;

        if (!ecoleId) {
          return;
        }

        // Chargement des années scolaires
        loadData(
          "{{ path('app_inscription_eleve_ajax_annees', {'ecole': '__ID__'}) }}".replace(
            "__ID__",
            ecoleId,
          ),
          anneeSelect,
          "Sélectionner une année scolaire",
          "libelle",
        );
      });

      anneeSelect.addEventListener("change", function () {
        const anneeId = this.value;
        const ecoleId = ecoleSelect.value;

        console.log("Année scolaire sélectionnée :", anneeId);

        // Réinitialiser les champs suivants
        resetSelect(sectionSelect, "Sélectionner une section");

        resetSelect(classeSelect, "Sélectionner une classe");

        resetSelect(optionSelect, "Sélectionner une option");

        sectionSelect.disabled = true;
        classeSelect.disabled = true;
        optionSelect.disabled = true;

        if (!anneeId || !ecoleId) {
          return;
        }

        // Les sections sont liées à l'école
        loadData(
          "{{ path('app_inscription_eleve_ajax_sections', {'ecole': '__ID__'}) }}".replace(
            "__ID__",
            ecoleId,
          ),
          sectionSelect,
          "Sélectionner une section",
          "nom",
        );
      });

      sectionSelect.addEventListener("change", function () {
        const sectionId = this.value;

        console.log("Section sélectionnée :", sectionId);

        // Réinitialiser classe et option
        resetSelect(classeSelect, "Sélectionner une classe");

        resetSelect(optionSelect, "Sélectionner une option");

        classeSelect.disabled = true;
        optionSelect.disabled = true;

        if (!sectionId) {
          return;
        }

        // Charger les classes de cette section
        loadData(
          "{{ path('app_inscription_eleve_ajax_classes', {'section': '__ID__'}) }}".replace(
            "__ID__",
            sectionId,
          ),
          classeSelect,
          "Sélectionner une classe",
          "nom",
        );
      });

      classeSelect.addEventListener("change", function () {
        const classeId = this.value;

        console.log("Classe sélectionnée :", classeId);

        // Réinitialiser les options
        resetSelect(optionSelect, "Sélectionner une option");

        optionSelect.disabled = true;

        if (!classeId) {
          return;
        }

        // Vérifier la section
        const selectedSection = sectionSelect.options[sectionSelect.selectedIndex];

        if (!selectedSection) {
          return;
        }

        const sectionNom = selectedSection.textContent.trim().toLowerCase();

        if (
          sectionNom === "primaire" ||
          sectionNom === "c.o" ||
          sectionNom === "co"
        ) {
          resetSelect(optionSelect, "Aucune option pour cette section");

          optionSelect.disabled = true;

          return;
        }

        // Charger les options de la classe
        loadData(
          "{{ path('app_inscription_eleve_ajax_options', {'classe': '__ID__'}) }}".replace(
            "__ID__",
            classeId,
          ),
          optionSelect,
          "Sélectionner une option",
          "nom",
        );
      });

      const form = document.querySelector("#inscription-form");

      if (form) {
        form.addEventListener("submit", function () {
          console.log("École :", ecoleSelect.value);

          console.log("Année scolaire :", anneeSelect.value);

          console.log("Section :", sectionSelect.value);

          console.log("Classe :", classeSelect.value);

          console.log("Option :", optionSelect.value);

          // Réactiver avant l'envoi
          anneeSelect.disabled = false;
          sectionSelect.disabled = false;
          classeSelect.disabled = false;
          optionSelect.disabled = false;
        });
      }
    });
  </script>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.form-validation-inscription').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                event.preventDefault();

                const nomEleve = form.dataset.eleve || 'cet élève';

                Swal.fire({
                    title: 'Confirmer la validation ?',
                    html: `
                        <p>Vous êtes sur le point de valider l'inscription de :</p>
                        <strong>${nomEleve}</strong>
                        <p class="mt-3">
                            <i class="fas fa-exclamation-triangle text-warning"></i>
                            Cette action permettra d'enregistrer l'élève et son parent
                            dans le système et de confirmer l'inscription.
                        </p>
                        <p>Voulez-vous continuer ?</p>
                    `,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fas fa-check"></i> Oui, valider',
                    cancelButtonText: 'Annuler',
                    reverseButtons: true,
                    focusCancel: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    });



    // Champ pour controler e-mail automatique
    document.addEventListener('DOMContentLoaded', function () {
   const emailInput = document.getElementById('inscription_eleve_email');
   const feedback = document.getElementById('email-feedback');

    if (!emailInput || !feedback) {
        console.error('Champ email ou zone de message introuvable.');
        return;
    }

    const checkUrl = emailInput.dataset.checkUrl;
    let controller = null;

    function afficherMessage(message, type) {
        feedback.textContent = message;

        feedback.className = 'small mt-1';

        emailInput.classList.remove('is-valid', 'is-invalid');

        if (type === 'success') {
            feedback.classList.add('text-success');
            emailInput.classList.add('is-valid');
            emailInput.style.color = 'green';
        } else if (type === 'error') {
            feedback.classList.add('text-danger');
            emailInput.classList.add('is-invalid');
            emailInput.style.color = 'red';
        } else {
            feedback.classList.add('text-muted');
            emailInput.style.color = '';
        }
    }

    async function verifierEmail() {
        const email = emailInput.value.trim();

        // Annuler une éventuelle vérification précédente.
        if (controller) {
            controller.abort();
            controller = null;
        }

        emailInput.classList.remove('is-valid', 'is-invalid');
        emailInput.style.color = '';
        feedback.textContent = '';

        // Ne rien vérifier si le champ est vide.
        if (email === '') {
            return;
        }

        // Vérifier d'abord le format de l'adresse.
        if (!emailInput.checkValidity()) {
            afficherMessage(
                'Veuillez saisir une adresse e-mail valide.',
                'error'
            );
            return;
        }

        if (!checkUrl) {
            afficherMessage(
                'La route de vérification est introuvable.',
                'error'
            );
            return;
        }

        controller = new AbortController();
        const currentController = controller;

        afficherMessage('Vérification en cours...', 'loading');

        try {
            const url = new URL(checkUrl, window.location.origin);
            url.searchParams.set('email', email);

            const response = await fetch(url.toString(), {
                method: 'GET',
                headers: {
                    'Accept': 'application/json'
                },
                signal: currentController.signal
            });

            if (!response.ok) {
                throw new Error(`Erreur HTTP ${response.status}`);
            }

            const data = await response.json();

            // Ignorer la réponse si le contenu du champ a changé.
            if (emailInput.value.trim() !== email) {
                return;
            }

            if (data.available === true) {
                afficherMessage(
                    'Cette adresse e-mail est disponible.',
                    'success'
                );
            } else if (data.available === false) {
                afficherMessage(
                    data.message || 'Cette adresse e-mail est déjà utilisée.',
                    'error'
                );
            } else {
                throw new Error('Réponse inattendue du serveur.');
            }

        } catch (error) {
            if (error.name === 'AbortError') {
                return;
            }

            console.error('Erreur de vérification email :', error);

            afficherMessage(
                'Impossible de vérifier cette adresse. Réessayez.',
                'error'
            );
        } finally {
            if (controller === currentController) {
                controller = null;
            }
        }
    }

    // Vérification dès que l'utilisateur quitte le champ.
    emailInput.addEventListener('blur', verifierEmail);

    // Effacer le résultat précédent dès que l'adresse change.
    emailInput.addEventListener('input', function () {
        if (controller) {
            controller.abort();
            controller = null;
        }

        emailInput.classList.remove('is-valid', 'is-invalid');
        emailInput.style.color = '';
        feedback.textContent = '';
    });
});

</script>
{% endblock %}

