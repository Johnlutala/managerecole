{% extends 'base.html.twig' %}
{% block title %}Détail de l'inscription{% endblock %}
{% block body %}<div class="wrapper"><div class="content-page"><div class="container-fluid"><div class="page-title-head d-flex justify-content-between"><div><h4 class="fs-xl fw-bold m-0">{{ inscription_eleve.nom }} {{ inscription_eleve.postnom }} {{ inscription_eleve.prenom }}</h4><p class="text-muted mb-0">Demande d'inscription</p></div><span class="badge badge-soft-{{ inscription_eleve.statut == 'validee' ? 'success' : 'warning' }}">{{ inscription_eleve.statut|replace({'_': ' '})|title }}</span></div><div class="row"><div class="col-lg-6"><div class="card"><div class="card-header"><strong>Élève</strong></div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-5">Référence</dt><dd class="col-sm-7">{{ inscription_eleve.reference ?: '—' }}</dd><dt class="col-sm-5">Sexe</dt><dd class="col-sm-7">{{ inscription_eleve.sexe }}</dd><dt class="col-sm-5">Naissance</dt><dd class="col-sm-7">{{ inscription_eleve.dateNaissance|date('d/m/Y') }} à {{ inscription_eleve.lieuNaissance }}</dd><dt class="col-sm-5">Téléphone</dt><dd class="col-sm-7">{{ inscription_eleve.telephone ?: '—' }}</dd><dt class="col-sm-5">Adresse</dt><dd class="col-sm-7">{{ inscription_eleve.adresse }}</dd></dl></div></div></div><div class="col-lg-6"><div class="card"><div class="card-header"><strong>Parent et scolarité</strong></div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-5">Parent</dt><dd class="col-sm-7">{{ inscription_eleve.nomParent }} {{ inscription_eleve.postnomParent }} {{ inscription_eleve.prenomParent }}</dd><dt class="col-sm-5">Lien</dt><dd class="col-sm-7">{{ inscription_eleve.lienParental }}</dd><dt class="col-sm-5">École</dt><dd class="col-sm-7">{{ inscription_eleve.etablissement ? inscription_eleve.etablissement.nom : '—' }}</dd><dt class="col-sm-5">Classe</dt><dd class="col-sm-7">{{ inscription_eleve.classe ? inscription_eleve.classe.nom : '—' }}</dd><dt class="col-sm-5">Année</dt><dd class="col-sm-7">{{ inscription_eleve.anneeScolaire ? inscription_eleve.anneeScolaire.libelle : '—' }}</dd></dl></div></div></div></div><a class="btn btn-light" href="{{ path('app_inscription_eleve_index') }}">Retour à la liste</a></div></div></div>{% endblock %}
