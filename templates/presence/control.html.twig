{% extends 'base.html.twig' %}
{% block title %}Contrôle des présences{% endblock %}
{% block body %}
    <div class="wrapper">
        <div class="content-page">
            <div class="container-fluid">
                <div class="page-title-head d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fs-xl fw-bold m-0">Contrôle des présences</h4>
                        <p class="text-muted mb-0">Validation administrative des saisies quotidiennes.</p>
                    </div>
                    <a class="btn btn-outline-primary" href="{{ path('app_presence_personnel', {date: date|date('Y-m-d')}) }}">Présence du personnel
                    </a>
                </div>

                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'error' ? 'danger' : 'success' }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                <form method="get" class="card card-body mb-4">
                    <div class="row g-3 align-items-end">
                        <div class="col-lg-3">
                            <label class="form-label">École</label>
                            <select class="form-select" name="ecole">
                                {% for item in schools %}
                                    <option value="{{ item.id }}" {{ school and item.id == school.id ? 'selected' }}>
                                        {{ item.nom }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-lg-2">
                            <label class="form-label">Section</label>
                            <select class="form-select" name="section">
                                <option value="">Toutes</option>

                                {% for item in sections %}
                                    <option value="{{ item.id }}" {{ section and item.id == section.id ? 'selected' }}>
                                        {{ item.nom }}
                                    </option>{% endfor %}
                            </select>
                        </div>
                        <div class="col-lg-2">
                            <label class="form-label">Classe</label>
                            <select class="form-select" name="classe">
                                <option value="">Toutes</option>
                                {% for item in classes %}
                                    <option value="{{ item.id }}" {{ selectedClasse and item.id == selectedClasse.id ? 'selected' }}>
                                        {{ item.nom }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-lg-2">
                            <label class="form-label">Option</label>
                            <select class="form-select" name="option">
                                <option value="">Toutes</option>
                                {% for item in options %}
                                    <option value="{{ item.id }}" {{ option and item.id == option.id ? 'selected' }}>
                                        {{ item.nom }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-lg-2">
                            <label class="form-label">Date</label>
                            <input class="form-control" type="date" name="date" value="{{ date|date('Y-m-d') }}">
                        </div><div class="col-lg-1">
                            <button class="btn btn-primary w-100">Filtrer</button>
                        </div>
                    </div>
                </form>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card card-body">
                            <small class="text-muted">Classes concernées</small>
                            <strong class="fs-3">{{ dashboard|length }}</strong>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card card-body">
                            <small class="text-muted">Saisies complètes</small>
                            <strong class="fs-3 text-success">{{ dashboard|filter(item => item.manquants == 0)|length }}</strong>
                        </div></div><div class="col-md-3">
                        <div class="card card-body">
                            <small class="text-muted">Saisies à compléter</small>
                            <strong class="fs-3 text-warning">{{ dashboard|filter(item => item.manquants > 0)|length }}</strong>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card card-body">
                            <small class="text-muted">Classes validées</small>
                            <strong class="fs-3 text-primary">{{ dashboard|filter(item => item.valides == item.total and item.total > 0)|length }}</strong>
                        </div>
                    </div>
                </div>
                <div class="card mb-4">
                    <div class="card-header">
                        <strong>Suivi des classes — {{ school ? school.nom : 'Toutes les écoles' }}</strong>
                        <span class="text-muted ms-2">{{ date|date('d/m/Y') }}</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-custom table-centered mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th>Classe</th>
                                    <th>Élèves</th>
                                    <th>Renseignés</th>
                                    <th>Présents</th>
                                    <th>Absents</th>
                                    <th>Retards</th>
                                    <th>Absents récurrents<br><small>(&gt; 3 jours / 30 j)</small></th>
                                    <th>État</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in dashboard %}
                                    <tr>
                                        <td><strong>{{ item.classe.nom }}</strong> {% if item.classe.section %}<br>
                                                <small class="text-muted">{{ item.classe.section.nom }}</small>
                                            {% endif %}</td>
                                        <td>{{ item.total }}</td>
                                        <td>{{ item.renseignes }}/{{ item.total }}</td>
                                        <td><span class="text-success">{{ item.present }}</span></td>
                                        <td><span class="text-danger">{{ item.absent }}</span></td>
                                        <td><span class="text-warning">{{ item.retard }}</span></td>
                                        <td>{{ item.recurringAbsences }}</td>
                                        <td>{% if item.manquants %}<span class="badge badge-soft-warning">{{ item.manquants }} à compléter</span>{% elseif item.valides == item.total and item.total > 0 %}<span class="badge badge-soft-success">Validée</span>{% else %}<span class="badge badge-soft-info">À valider</span>{% endif %}</td>
                                        <td><a class="btn btn-sm btn-primary" href="{{ path('app_presence_control', {ecole : school ? school.id : '', section : section ? section.id : '', option : option ? option.id : '', classe : item.classe.id, date : date|date('Y-m-d')}) }}">Voir</a></td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="9" class="text-center py-5 text-muted">Aucune classe ne correspond aux filtres.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {% if detail %}
                    <div class="card mt-4">
                        <div class="card-header">
                            <h5 class="mb-0">Modifier les présences — {{ selectedClasse.nom }}</h5>
                            <small class="text-muted">{{ date|date('d/m/Y') }}</small>
                        </div>
                        <form
                            method="post"
                            action="{{ path('app_presence_control', {
                            ecole: school ? school.id : '',
                            section: section ? section.id : '',
                            classe: selectedClasse.id,
                            option: option ? option.id : '',
                            date: date|date('Y-m-d')
                        }) }}"
                        >
                            <input type="hidden" name="_token" value="{{ csrf_token('edit_attendance') }}">
                            <input type="hidden" name="action" value="edit_attendance">
                            <div class="table-responsive">
                                <table class="table table-custom table-centered mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>Nom</th>
                                            <th>Postnom</th>
                                            <th>Prénom</th>
                                            <th>État</th>
                                            <th>Arrivée</th>
                                            <th>Départ</th>
                                            <th>Motif</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for student in detail.students %}
                                            {% set record = detail.records[student.id] ?? null %}
                                            {% set currentStatus = record ? record.statut : '' %}
                                            {% set legacyStatus = record and currentStatus not in ['present', 'absent', 'retard', 'autre'] %}
                                            <tr>
                                                <td>{{ student.nom }}</td>
                                                <td>{{ student.postnom ?: '---' }}</td>
                                                <td>{{ student.prenom }}</td>
                                                <td>
                                                    {% for code, label in {present: 'Présent', absent: 'Absent', retard: 'Retard', autre: 'Autre'} %}
                                                        <div class="form-check form-check-inline">
                                                            <input
                                                                class="form-check-input attendance-status"
                                                                type="radio"
                                                                id="control-{{ student.id }}-{{ code }}"
                                                                name="attendance[{{ student.id }}][statut]"
                                                                value="{{ code }}"
                                                                required
                                                                {{ (currentStatus == code) or (code == 'autre' and legacyStatus) ? 'checked' : '' }}
                                                            >
                                                            <label class="form-check-label" for="control-{{ student.id }}-{{ code }}">{{ label }}</label>
                                                        </div>
                                                    {% endfor %}
                                                </td>
                                                <td><input class="form-control" type="time" name="attendance[{{ student.id }}][arrivee]" value="{{ record and record.heureArrivee ? record.heureArrivee|date('H:i') : '07:30' }}"></td>
                                                <td><input class="form-control" type="time" name="attendance[{{ student.id }}][depart]" value="{{ record and record.heureDepart ? record.heureDepart|date('H:i') : '12:30' }}"></td>
                                                <td>
                                                    <input
                                                        class="form-control attendance-reason"
                                                        type="text"
                                                        name="attendance[{{ student.id }}][motif]"
                                                        value="{{ record ? record.observation }}"
                                                        placeholder="Motif"
                                                        {{ currentStatus == 'autre' or legacyStatus ? 'required' : 'hidden' }}
                                                    >
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr><td colspan="7" class="text-center py-4">Aucun élève actif dans cette classe.</td></tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            <div class="card-footer d-flex justify-content-between align-items-center">
                                <a href="{{ path('app_presence_index') }}" class="btn btn-secondary">
                                    <i class="ti ti-arrow-left me-1"></i>
                                    Retour
                                </a>

                                <button type="submit" class="btn btn-primary">
                                    <i class="ti ti-device-floppy me-1"></i>
                                    Enregistrer les modifications
                                </button>
                            </div>
                         
                        </form>
                    </div>
                {% elseif selectedClasse %}
                    <div class="alert alert-info">
                        Aucune présence n’a encore été enregistrée pour {{ selectedClasse.nom }} à cette date.
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll(".attendance-status").forEach((input) => {
            input.addEventListener("change", () => {
                const row = input.closest("tr");
                const reason = row.querySelector(".attendance-reason");
                const needsReason =
                    row.querySelector(".attendance-status:checked")?.value === "autre";
                reason.hidden = !needsReason;
                reason.required = needsReason;
            });
        });
    </script>
{% endblock %}
