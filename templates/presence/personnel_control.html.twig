{% extends 'base.html.twig' %}

{% block title %}Contrôle des présences du personnel{% endblock %}

{% block body %}
    <div class="wrapper">
        <div class="content-page">
            <div class="container-fluid">
                <div class="page-title-head d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h4 class="fs-xl fw-bold m-0">Modifier les présences du personnel</h4>
                        <p class="text-muted mb-0">{{ date|date('d/m/Y') }}</p>
                    </div>
                    <a class="btn btn-outline-primary" href="{{ path('app_presence_personnel', {date: date|date('Y-m-d')}) }}">Retour au récapitulatif</a>
                </div>

                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'danger' ? 'danger' : 'success' }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}

                {% if presenceAlreadyRecorded %}
                    <form method="post" action="{{ path('app_presence_personnel_control', {date: date|date('Y-m-d')}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('edit_staff_attendance') }}">
                        <div class="card">
                            <div class="table-responsive">
                                <table class="table table-custom table-centered mb-0">
                                    <thead>
                                        <tr>
                                            <th>Personnel</th>
                                            <th>Fonction</th>
                                            <th>État</th>
                                            <th>Arrivée</th>
                                            <th>Départ</th>
                                            <th>Motif</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for key, item in staff %}
                                            {% set record = existing[key] ?? null %}
                                            {% set currentStatus = record ? record.statut : 'present' %}
                                            {% set legacyStatus = record and currentStatus not in ['present', 'absent', 'retard', 'autre'] %}
                                            <tr>
                                                <td>{{ item.label }}</td>
                                                <td>{{ item.role }}</td>
                                                <td>
                                                    {% for code, label in {present: 'Présent', absent: 'Absent', retard: 'Retard', autre: 'Autre'} %}
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input attendance-status" type="radio"
                                                                id="staff-control-{{ key }}-{{ code }}"
                                                                name="attendance[{{ key }}][statut]"
                                                                value="{{ code }}"
                                                                {{ (currentStatus == code) or (code == 'autre' and legacyStatus) ? 'checked' : '' }}
                                                                required>
                                                            <label class="form-check-label" for="staff-control-{{ key }}-{{ code }}">{{ label }}</label>
                                                        </div>
                                                    {% endfor %}
                                                </td>
                                                <td><input class="form-control" type="time" name="attendance[{{ key }}][arrivee]" value="{{ record and record.heureArrivee ? record.heureArrivee|date('H:i') : '07:30' }}"></td>
                                                <td><input class="form-control" type="time" name="attendance[{{ key }}][depart]" value="{{ record and record.heureDepart ? record.heureDepart|date('H:i') : '12:30' }}"></td>
                                                <td>
                                                    <input class="form-control attendance-reason" type="text"
                                                        name="attendance[{{ key }}][motif]"
                                                        value="{{ record ? record.observation }}"
                                                        placeholder="Motif"
                                                        {{ currentStatus == 'autre' or legacyStatus ? 'required' : 'hidden' }}>
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr><td colspan="6" class="text-center py-4">Aucun personnel disponible.</td></tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            <div class="card-footer text-end">
                                <button class="btn btn-primary">Enregistrer les modifications</button>
                            </div>
                        </div>
                    </form>
                {% else %}
                    <div class="alert alert-info">Aucune présence du personnel n’a encore été enregistrée pour cette date.</div>
                {% endif %}
            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll(".attendance-status").forEach((input) => {
            input.addEventListener("change", () => {
                const row = input.closest("tr");
                const reason = row.querySelector(".attendance-reason");
                const needsReason = row.querySelector(".attendance-status:checked")?.value === "autre";
                reason.hidden = !needsReason;
                reason.required = needsReason;
            });
        });
    </script>
{% endblock %}
