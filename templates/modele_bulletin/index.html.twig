{% extends 'base.html.twig' %}

{% block title %}Modèles de bulletins{% endblock %}

{% block body %}
<div class="wrapper">
    <div class="content-page">
        <div class="container-fluid">

            {# Messages flash #}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type in ['success', 'danger', 'warning', 'info'] ? type : 'info' }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {# En-tête #}
            <div class="page-title-head d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
                <div>
                    <h4 class="fs-xl fw-bold m-0">Modèles de bulletins</h4>
                    <p class="text-muted mb-0 mt-1">
                        Gérez les modèles utilisés pour les bulletins scolaires.
                    </p>
                </div>

                <button type="button"
                        class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#modalNouveauModele">
                    <i class="ti ti-plus me-1"></i>
                    Nouveau modèle
                </button>
            </div>

            {# Tableau des modèles #}
            <div class="card border shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-1">Liste des modèles</h5>
                    <p class="text-muted small mb-0">
                        {{ modele_bulletins|length }} modèle(s) enregistré(s)
                    </p>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">N°</th>
                                    <th>Nom</th>
                                    <th>Description</th>
                                    <th>Statut</th>
                                    <th>Date de création</th>
                                    <th class="text-center pe-4">Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                            {% for modele_bulletin in modele_bulletins %}
                                <tr>
                                    <td class="ps-4 text-muted">{{ loop.index }}</td>

                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded border bg-light d-flex align-items-center justify-content-center"
                                                 style="width: 38px; height: 38px;">
                                                <i class="ti ti-file-certificate fs-4 text-primary"></i>
                                            </div>

                                            <div>
                                                <span class="fw-semibold">{{ modele_bulletin.nom }}</span>
                                                <div class="small text-muted">
                                                    Réf. #{{ modele_bulletin.id }}
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        {% if modele_bulletin.description %}
                                            {{ modele_bulletin.description|length > 70
                                                ? modele_bulletin.description|slice(0, 70) ~ '…'
                                                : modele_bulletin.description }}
                                        {% else %}
                                            <span class="text-muted fst-italic">Aucune description</span>
                                        {% endif %}
                                    </td>

                                    <td>
                                        {% if modele_bulletin.statut == 'actif' %}
                                            <span class="badge bg-success-subtle text-success">Actif</span>
                                        {% else %}
                                            <span class="badge bg-secondary-subtle text-secondary">
                                                {{ modele_bulletin.statut|default('inactif')|capitalize }}
                                            </span>
                                        {% endif %}
                                    </td>

                                    <td>
                                        {% if modele_bulletin.createdAt %}
                                            {{ modele_bulletin.createdAt|date('d/m/Y H:i') }}
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </td>

                                    <td class="text-center pe-4">
                                        <div class="d-inline-flex gap-1">
                                            <a href="{{ path('app_modele_bulletin_show', {'id': modele_bulletin.id}) }}"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="Consulter">
                                                <i class="ti ti-eye"></i>
                                            </a>

                                            <a href="{{ path('app_modele_bulletin_edit', {'id': modele_bulletin.id}) }}"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Modifier">
                                                <i class="ti ti-edit"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <i class="ti ti-file-certificate text-muted" style="font-size: 42px;"></i>
                                        <h6 class="mt-2 fw-semibold">Aucun modèle enregistré</h6>
                                        <p class="text-muted mb-3">
                                            Ajoutez un modèle pour commencer la configuration des bulletins.
                                        </p>

                                        <button type="button"
                                                class="btn btn-primary btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalNouveauModele">
                                            <i class="ti ti-plus me-1"></i>
                                            Ajouter un modèle
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            {# Modale de création #}
            <div class="modal fade" id="modalNouveauModele" tabindex="-1"
                 aria-labelledby="modalNouveauModeleLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow">

                        {{ form_start(form, {
                            attr: {
                                class: 'needs-validation'
                            }
                        }) }}

                        <div class="modal-header">
                            <div>
                                <h5 class="modal-title fw-bold" id="modalNouveauModeleLabel">
                                    <i class="ti ti-file-certificate text-primary me-1"></i>
                                    Nouveau modèle de bulletin
                                </h5>
                                <p class="text-muted small mb-0 mt-1">
                                    Renseignez les informations du modèle.
                                </p>
                            </div>

                            <button type="button" class="btn-close"
                                    data-bs-dismiss="modal" aria-label="Fermer"></button>
                        </div>

                        <div class="modal-body">

                            <div class="mb-3">
                                {{ form_label(form.nom, 'Nom du modèle', {
                                    label_attr: {class: 'form-label'}
                                }) }}
                                {{ form_widget(form.nom, {
                                    attr: {
                                        class: 'form-control',
                                        placeholder: 'Ex. Bulletin trimestriel'
                                    }
                                }) }}
                                {{ form_errors(form.nom) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.description, 'Description', {
                                    label_attr: {class: 'form-label'}
                                }) }}
                                {{ form_widget(form.description, {
                                    attr: {
                                        class: 'form-control',
                                        rows: 3,
                                        placeholder: 'Décrivez brièvement ce modèle...'
                                    }
                                }) }}
                                {{ form_errors(form.description) }}
                            </div>

                            <div class="mb-0">
                                {{ form_label(form.statut, 'Statut', {
                                    label_attr: {class: 'form-label'}
                                }) }}
                                {{ form_widget(form.statut, {
                                    attr: {class: 'form-select'}
                                }) }}
                                {{ form_errors(form.statut) }}
                            </div>

                            {# Afficher les éventuelles erreurs globales #}
                            {{ form_errors(form) }}

                        </div>

                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">
                                Annuler
                            </button>

                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i>
                                Enregistrer
                            </button>
                        </div>

                        {{ form_end(form) }}

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

{# Si la soumission échoue, rouvrir la modale pour afficher les erreurs #}
{% if form.vars.submitted and not form.vars.valid %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalElement = document.getElementById('modalNouveauModele');

            if (modalElement && window.bootstrap) {
                bootstrap.Modal.getOrCreateInstance(modalElement).show();
            }
        });
    </script>
{% endif %}
{% endblock %}