{% extends 'base.html.twig' %}

{% block title %}Modifier un modèle de bulletin{% endblock %}

{% block body %}
    <div class="wrapper">
        <div class="content-page">
            <div class="container-fluid">

                {# En-tête #}
                <div class="page-title-head d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
                    <div>
                        <h4 class="fs-xl fw-bold m-0">Modifier un modèle de bulletin</h4>
                        <p class="text-muted mb-0 mt-1">
                            Modifiez les informations du modèle sélectionné.
                        </p>
                    </div>

                    <a
                        href="{{ path('app_modele_bulletin_index') }}"
                        class="btn btn-outline-secondary"
                    >
                        <i class="ti ti-arrow-left me-1"></i>
                        Retour à la liste
                    </a>
                </div>

                {# Messages flash #}
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div
                            class="alert alert-{{ type in ['success', 'danger', 'warning', 'info'] ? type : 'info' }} alert-dismissible fade show"
                            role="alert"
                        >
                            {{ message }}
                            <button
                                type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                aria-label="Fermer"
                            ></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                <div class="row justify-content-center">
                    <div class="col-xl-8 col-lg-10">

                        <div class="card border shadow-sm">
                            <div class="card-header bg-white py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div
                                        class="rounded border bg-light d-flex align-items-center justify-content-center"
                                        style="width: 48px; height: 48px;"
                                    >
                                        <i class="ti ti-file-certificate fs-2 text-primary"></i>
                                    </div>

                                    <div>
                                        <h5 class="card-title mb-1">
                                            {{ modele_bulletin.nom }}
                                        </h5>
                                        <p class="text-muted small mb-0">
                                            Référence #{{ modele_bulletin.id }}
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="card-body p-4">

                                {{ form_start(form, {
                                attr: {
                                    class: 'needs-validation'
                                }
                            }) }}

                               <div class="row g-3">
                                    {# Nom du modèle #}
                                    <div class="col-md-8 mb-3">
                                        {{ form_label(form.nom, 'Nom du modèle', {
                                            label_attr: {class: 'form-label fw-semibold'}
                                        }) }}

                                        {{ form_widget(form.nom, {
                                            attr: {
                                                class: 'form-control',
                                                placeholder: 'Ex. Bulletin trimestriel'
                                            }
                                        }) }}

                                        {{ form_errors(form.nom) }}
                                    </div>

                                    {# Statut #}
                                    <div class="col-md-4 mb-3">
                                        {{ form_label(form.statut, 'Statut', {
                                            label_attr: {class: 'form-label fw-semibold'}
                                        }) }}

                                        {{ form_widget(form.statut, {
                                            attr: {class: 'form-select'}
                                        }) }}

                                        {{ form_errors(form.statut) }}
                                    </div>
                                </div>

                                <div class="mb-3">
                                    {{ form_label(form.description, 'Description', {
                                        label_attr: {class: 'form-label fw-semibold'}
                                    }) }}

                                    {{ form_widget(form.description, {
                                        attr: {
                                            class: 'form-control',
                                            rows: 4,
                                            placeholder: 'Décrivez brièvement ce modèle...'
                                        }
                                    }) }}

                                    {{ form_errors(form.description) }}
                                </div>

                                {{ form_rest(form) }}

                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-3 border-top">
                                    <a
                                        href="{{ path('app_modele_bulletin_index') }}"
                                        class="btn btn-outline-secondary"
                                    >
                                        <i class="ti ti-x me-1"></i>
                                        Annuler
                                    </a>

                                    <button type="submit" class="btn btn-primary">
                                        <i class="ti ti-device-floppy me-1"></i>
                                        Enregistrer les modifications
                                    </button>
                                </div>

                                {{ form_end(form) }}

                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
{% endblock %}
