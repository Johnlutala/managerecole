                    'type': 'domain',
                    'nom': 'DOMAINE DES SCIENCES'
                },
                {
                    'type': 'subdomain',
                    'nom': 'Sous-domaine des mathématiques'
                },
                {'type': 'subject', 'nom': 'Algèbre', 'max': [40, 80, 160, 40, 80, 160, 320]},
                {'type': 'subject', 'nom': 'Arithmétique', 'max': [10, 20, 40, 10, 20, 40, 80]},
                {'type': 'subject', 'nom': 'Géométrie', 'max': [20, 40, 80, 20, 40, 80, 160]},
                {'type': 'subject', 'nom': 'Statistique', 'max': [10, 20, 40, 10, 20, 40, 80]},
                {'type': 'subtotal', 'nom': 'SOUS-TOTAL', 'max': [80, 160, 320, 80, 160, 320, 640]},

                {
                    'type': 'subdomain',
                    'nom': 'Sous-domaine des sciences de la vie et de la terre (SVT)'
                },
                {'type': 'subject', 'nom': 'Anatomie', 'max': [10, 20, 40, 10, 20, 40, 80]},
                {'type': 'subject', 'nom': 'Botanique', 'max': [10, 20, 40, 10, 20, 40, 80]},
                {'type': 'subject', 'nom': 'Zoologie', 'max': [10, 20, 40, 10, 20, 40, 80]},
                {'type': 'subtotal', 'nom': 'SOUS-TOTAL', 'max': [30, 60, 120, 30, 60, 120, 240]},

                {
                    'type': 'subdomain',
                    'nom': 'Sous-domaine des sciences physiques, technologie et TIC'
                },
                {'type': 'subject', 'nom': 'Sciences physiques', 'max': [10, 20, 40, 10, 20, 40, 80]},
                {'type': 'subject', 'nom': 'Technologie', 'max': [10, 20, 40, 10, 20, 40, 80]},
                {'type': 'subject', 'nom': 'Techno. d’Info. & Com. (TIC)', 'max': [10, 20, 40, 10, 20, 40, 80]},
                {'type': 'subtotal', 'nom': 'SOUS-TOTAL', 'max': [30, 60, 120, 30, 60, 120, 240]},

                {'type': 'domain', 'nom': 'DOMAINE DES LANGUES'},
                {'type': 'subject', 'nom': 'Anglais', 'max': [30, 60, 120, 30, 60, 120, 240]},
                {'type': 'subject', 'nom': 'Français', 'max': [70, 140, 280, 70, 140, 280, 560]},
                {'type': 'subtotal', 'nom': 'SOUS-TOTAL', 'max': [100, 200, 400, 100, 200, 400, 800]},

                {'type': 'domain', 'nom': 'DOMAINE DE L’UNIVERS SOCIAL ET ENVIRONNEMENT'},
                {'type': 'subject', 'nom': 'Éducation à la vie (1)', 'max': [20, 40, 80, 20, 40, 80, 160]},
                {'type': 'subject', 'nom': 'Éducation civique et morale', 'max': [20, 40, 80, 20, 40, 80, 160]},
                {'type': 'subject', 'nom': 'Géographie', 'max': [20, 40, 80, 20, 40, 80, 160]},
                {'type': 'subject', 'nom': 'Histoire', 'max': [20, 40, 80, 20, 40, 80, 160]},
                {'type': 'subtotal', 'nom': 'SOUS-TOTAL', 'max': [80, 160, 320, 80, 160, 320, 640]},

                {'type': 'domain', 'nom': 'DOMAINE DES ARTS'},
                {'type': 'subject', 'nom': 'Dessin', 'max': [20, 40, 80, 20, 40, 80, 160]},
                {'type': 'subject', 'nom': 'Musique', 'max': [20, 40, 80, 20, 40, 80, 160]},
                {'type': 'subtotal', 'nom': 'SOUS-TOTAL', 'max': [40, 80, 160, 40, 80, 160, 320]},

                {'type': 'domain', 'nom': 'DOMAINE DU DÉVELOPPEMENT PERSONNEL'},
                {'type': 'subject', 'nom': 'Éducation physique', 'max': [20, 40, 80, 20, 40, 80, 160]},
                {'type': 'subtotal', 'nom': 'SOUS-TOTAL', 'max': [20, 40, 80, 20, 40, 80, 160]}
            ] %}

                <div class="bulletin-wrapper">
                    <div class="bulletin-preview">

                        {# EN-TETE OFFICIEL #}
                        <div class="official-header">
                            <div class="country-name">
                                RÉPUBLIQUE DÉMOCRATIQUE DU CONGO
                            </div>
                            <div class="ministry-name">
                                MINISTÈRE DE L'ENSEIGNEMENT PRIMAIRE, SECONDAIRE<br>
                                ET PROFESSIONNEL
                            </div>
                        </div>

                        {# IDENTIFICATION DE L'ELEVE #}
                        <table class="student-info">
                            <tbody>
                                <tr>
                                    <td colspan="2"><strong>N° ID</strong></td>
                                </tr>
                                <tr>
                                    <td colspan="2"><strong>PROVINCE :</strong></td>
                                </tr>
                                <tr>
                                    <td style="width:65%">
                                        <strong>VILLE :</strong>
                                        ........................................................
                                    </td>
                                    <td>
                                        <strong>ÉLÈVE :</strong>
                                        ........................................
                                        <strong>SEXE :</strong> .......
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>COMMUNE / TER (1) :</strong>
                                        ....................................
                                    </td>
                                    <td>
                                        <strong>NÉ(E) À :</strong>
                                        ...........................
                                        <strong>Le :</strong> .... / .... / ....
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>ÉCOLE :</strong>
                                        ............................................
                                    </td>
                                    <td>
                                        <strong>CLASSE :</strong>
                                        ........................................
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2">
                                        <strong>CODE N° PERM. :</strong>
                                        ........................................................................
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        {# TITRE #}
                        <div class="bulletin-main-title">
                            BULLETIN DE LA 7ème ANNÉE CYCLE TERMINAL DE L'ÉDUCATION DE BASE (CTBE)
                            <div>ANNÉE SCOLAIRE 20........ / 20........</div>
                        </div>

                        {# TABLEAU DES COTATIONS #}
                        <div class="table-scroll">
                            <table class="grades-table">
                                <thead>
                                    <tr>
                                        <th rowspan="3" class="branch-col">BRANCHE</th>

                                        <th colspan="4" class="semester-title">PREMIER SEMESTRE</th>
                                        <th colspan="4" class="semester-title">SECOND SEMESTRE</th>

                                        <th rowspan="3" class="percentage-col">%</th>
                                        <th rowspan="3" class="signature-col">SIGN.<br>PROF.</th>
                                        <th rowspan="3" class="grand-total-col">T.G.</th>
                                        <th rowspan="3" class="repechage-col">EXAMEN DE<br>REPÊCHAGE</th>
                                    </tr>

                                    <tr>
                                        <th colspan="2">TRAVAUX JOURNALIERS</th>
                                        <th rowspan="2">EXAMEN</th>
                                        <th rowspan="2">TOT.</th>

                                        <th colspan="2">TRAVAUX JOURNALIERS</th>
                                        <th rowspan="2">EXAMEN</th>
                                        <th rowspan="2">TOT.</th>
                                    </tr>

                                    <tr>
                                        <th>1ère P</th>
                                        <th>2ème P</th>
                                        <th>3ème P</th>
                                        <th>4ème P</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    {% for ligne in domaines %}

                                        {# DOMAINE #}
                                        {% if ligne.type == 'domain' %}
                                            <tr class="domain-row">
                                                <td colspan="13">{{ ligne.nom }}</td>
                                            </tr>

                                            {# SOUS-DOMAINE #}
                                        {% elseif ligne.type == 'subdomain' %}
                                            <tr class="subdomain-row">
                                                <td colspan="13">{{ ligne.nom }}</td>
                                            </tr>

                                            {# MATIÈRE #}
                                        {% elseif ligne.type == 'subject' %}
                                            <tr class="subject-row">
                                                <td class="subject-name">{{ ligne.nom }}</td>

                                                {# Premier semestre : P1, P2, Examen #}
                                                {% for i in 0..2 %}
                                                    <td class="mark-cell">
                                                        <span class="max-value">{{ ligne.max[i] }}</span>
                                                    </td>
                                                {% endfor %}

                                                {# Total premier semestre #}
                                                <td class="total-cell"></td>

                                                {# Deuxième semestre : P3, P4, Examen #}
                                                {% for i in 3..5 %}
                                                    <td class="mark-cell">
                                                        <span class="max-value">{{ ligne.max[i] }}</span>
                                                    </td>
                                                {% endfor %}

                                                {# Total deuxième semestre #}
                                                <td class="total-cell"></td>

                                                {# Pourcentage #}
                                                <td class="percentage-cell"></td>

                                                {# Signature professeur #}
                                                <td class="signature-cell"></td>

                                                {# Total général #}
                                                <td class="grand-total-cell">
                                                    <span class="max-value">{{ ligne.max[6] }}</span>
                                                </td>

                                                {# Examen de repêchage #}
                                                <td class="repechage-cell"></td>
                                            </tr>

                                            {# SOUS-TOTAL #}
                                        {% elseif ligne.type == 'subtotal' %}
                                            <tr class="subtotal-row">
                                                <td>{{ ligne.nom }}</td>

                                                {% for i in 0..2 %}
                                                    <td>{{ ligne.max[i] }}</td>
                                                {% endfor %}

                                                <td></td>

                                                {% for i in 3..5 %}
                                                    <td>{{ ligne.max[i] }}</td>
                                                {% endfor %}

                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td>{{ ligne.max[6] }}</td>
                                                <td></td>
                                            </tr>
                                        {% endif %}

                                    {% endfor %}

                                    {# MAXIMA GÉNÉRAUX #}
                                    <tr class="general-total-row">
                                        <td>MAXIMA GÉNÉRAUX</td>
                                        <td>380</td>
                                        <td>760</td>
                                        <td>1520</td>
                                        <td>—</td>
                                        <td>380</td>
                                        <td>760</td>
                                        <td>1520</td>
                                        <td>—</td>
                                        <td>100 %</td>
                                        <td></td>
                                        <td>3040</td>
                                        <td></td>
                                    </tr>

                                    {# TOTAUX #}
                                    <tr class="result-row">
                                        <td>TOTAUX</td>
                                        {% for i in 1..12 %}
                                            <td></td>
                                        {% endfor %}
                                    </tr>

                                    {# POURCENTAGE #}
                                    <tr class="result-row">
                                        <td>POURCENTAGE</td>
                                        {% for i in 1..12 %}
                                            <td></td>
                                        {% endfor %}
                                    </tr>

                                    {# PLACE #}
                                    <tr class="result-row">
                                        <td>PLACE / NBRE D'ÉLÈVES</td>
                                        {% for i in 1..12 %}
                                            <td></td>
                                        {% endfor %}
                                    </tr>

                                    {# CONDUITE #}
                                    <tr class="result-row">
                                        <td>CONDUITE</td>
                                        {% for i in 1..12 %}
                                            <td></td>
                                        {% endfor %}
                                    </tr>

                                    {# APPLICATION #}
                                    <tr class="result-row">
                                        <td>APPLICATION</td>
                                        <td colspan="12">Le chef d'établissement</td>
                                    </tr>

                                    {# SIGNATURE #}
                                    <tr class="result-row">
                                        <td>SIGNATURE</td>
                                        <td colspan="12"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        {# DECISION ET SIGNATURES #}
                        <div class="decision-section">
                            <p>
                                - L'élève ne pourra passer dans la classe supérieure s'il n'a subi avec succès
                                un examen de repêchage en :
                                .........................................................................................................
                            </p>

                            <p>- L'élève passe dans la classe supérieure (1)</p>
                            <p>- L'élève double la classe (1)</p>

                            <div class="decision-signatures">
                                <div>
                                    Fait à ........................................ le ....... / ....... / 20.......
                                </div>
                                <div class="signature-space">
                                    <strong>LE CHEF D'ÉTABLISSEMENT</strong>
                                    <br>Sceau de l'école
                                    <br><br><br>
                                    Nom et signature
                                </div>
                            </div>

                            <div class="student-signature">
                                Signature de l'élève
                            </div>
                        </div>

                        <div class="bulletin-legal">
                            (1) Biffer la mention inutile.
                            <br>
                            Note importante : Le bulletin est sans valeur s'il est raturé ou surchargé.
                            <span>IGE/P.S./010</span>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <style>
