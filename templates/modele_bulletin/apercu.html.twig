    <script>
        function imprimerBulletin() {
            const bulletin = document.querySelector(".bulletin-preview");

            if (!bulletin) {
                window.print();
                return;
            }

            bulletin.style.setProperty("--print-scale", "1");

            requestAnimationFrame(() => {
                const pxParMm = 96 / 25.4;

                // Dimensions disponibles sur une feuille A4 paysage
                const largeurDisponible = 287 * pxParMm;
                const hauteurDisponible = 200 * pxParMm;

                const largeur = Math.max(
                    bulletin.scrollWidth,
                    bulletin.getBoundingClientRect().width,
                );

                const hauteur = Math.max(
                    bulletin.scrollHeight,
                    bulletin.getBoundingClientRect().height,
                );

                // Calcul automatique selon la largeur ET la hauteur
                const echelle = Math.min(
                    largeurDisponible / largeur,
                    hauteurDisponible / hauteur,
                );

                bulletin.style.setProperty("--print-scale", echelle);

                requestAnimationFrame(() => {
                    window.print();
                });
            });
        }

        window.addEventListener("afterprint", () => {
            const bulletin = document.querySelector(".bulletin-preview");

            if (bulletin) {
                bulletin.style.removeProperty("--print-scale");
            }
        });
    </script> 
{% endblock %}
