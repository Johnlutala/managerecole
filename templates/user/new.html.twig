{% extends 'base.html.twig' %}

{% block title %}Nouvel utilisateur
{% endblock %}

{% block body %}
	<div class="container-fluid">
		<div class="row justify-content-center">
			<div class="col-xl-8">
				<div class="page-title-head d-flex align-items-center">
					<div class="flex-grow-1">
						<h4 class="fs-xl fw-bold m-0">Créer un utilisateur</h4>
					</div>

					<div class="text-end">
						<ol class="breadcrumb m-0 py-0">
							<li class="breadcrumb-item">
								<a href="javascript: void(0);">ENABEL</a>
							</li>
							<li class="breadcrumb-item">
								<a href="javascript: void(0);">Utilisateurs</a>
							</li>
							<li class="breadcrumb-item active">Nouveau</li>
						</ol>
					</div>
				</div>

				<div class="card">
					<div class="card-header d-flex justify-content-between align-items-center">
						<h4 class="card-title mb-0">
							<i class="ti ti-user-plus me-2"></i>
							Nouvel utilisateur
						</h4>

						<a href="{{ path('app_user_index') }}" class="btn btn-secondary">
							<i class="ti ti-arrow-left"></i>
							Retour
						</a>
					</div>

					<div class="card-body">
						{{ include('user/_form.html.twig', {
                        button_label: 'Enregistrer'
                    }) }}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
