{{ form_start(form) }}

<div class="row g-3">
    <div class="col-6">

        {{ form_row(form.ecole, {
            label: 'École',
            attr: {
                class: 'form-select'
            }
        }) }}
    </div>
    <div class="col-6">
        {{ form_row(form.libelle, {
            label: 'Libellé de l’année scolaire',
            attr: {
                class: 'form-control',
                placeholder: 'Ex. 2026-2027'
            }
        }) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.dateDebut, {
            label: 'Date de début',
            attr: {
                class: 'form-control'
            }
        }) }}

    </div>

    <div class="col-md-6">
        {{ form_row(form.dateFin, {
            label: 'Date de fin',
            attr: {
                class: 'form-control'
            }
        }) }}

    </div>

</div>


<div class="text-end mt-4">
    <button type="submit" class="btn btn-primary">
        <i class="ti ti-device-floppy me-1"></i>
        {{ button_label|default('Enregistrer') }}
    </button>

</div>

{{ form_end(form) }}