{% extends 'base.html.twig' %}

{% block title %}Détail Année scolaire{% endblock %}

{% block body %}

	<div class="wrapper">

		<div class="content-page">

			<div class="container-fluid">

				{# ==================== TITRE ==================== #}

				<div class="page-title-head d-flex align-items-center">

					<div class="flex-grow-1">

						<h4 class="fs-xl fw-bold m-0">
							Détail de l'année scolaire
						</h4>

					</div>

					<div class="text-end">

						<ol class="breadcrumb m-0 py-0">

							<li class="breadcrumb-item">
								<a href="javascript:void(0);">
									ADMIN
								</a>
							</li>

							<li class="breadcrumb-item">
								<a href="{{ path('app_annee_scolaire_index') }}">
									Années scolaires
								</a>
							</li>

							<li class="breadcrumb-item active">
								Détail
							</li>

						</ol>

					</div>

				</div>


				{# ==================== CONTENU ==================== #}

				<div class="row">


					{# ==================== INFORMATIONS RAPIDES ==================== #}

					<div class="col-xl-3">

						<div class="card">

							<div class="card-header">

								<h4 class="card-title">
									Année N° :
									{{ annee_scolaire.id }}
								</h4>

							</div>

							<div class="card-body text-center">

								<div class="avatar-xl mx-auto mb-3">

									<div class="avatar-title bg-primary-subtle text-primary rounded">

										<i class="ti ti-calendar-event fs-1"></i>

									</div>

								</div>

								<h4 class="mb-1">
									{{ annee_scolaire.libelle }}
								</h4>

								<p class="text-muted mb-2">
									Période scolaire
								</p>

								<hr>

								<div class="d-grid gap-2">

									<a href="{{ path('app_annee_scolaire_edit', {'id': annee_scolaire.id}) }}"
									   class="btn btn-warning">

										<i class="ti ti-edit me-1"></i>
										Modifier

									</a>

									{% include 'annee_scolaire/_delete_form.html.twig' %}

									<a href="{{ path('app_annee_scolaire_index') }}"
									   class="btn btn-secondary">

										<i class="ti ti-arrow-left me-1"></i>
										Retour

									</a>

								</div>

							</div>

						</div>

					</div>


					{# ==================== INFORMATIONS ANNÉE SCOLAIRE ==================== #}

					<div class="col-xl-6">

						<div class="card h-100">

							<div class="card-header">

								<h4 class="card-title mb-0">
									Informations de l'année scolaire
								</h4>

							</div>

							<div class="card-body">

								<div class="table-responsive">

									<table class="table table-bordered align-middle mb-0">

										<tbody>

											<tr>

												<th width="40%">
													ID
												</th>

												<td>
													{{ annee_scolaire.id }}
												</td>

											</tr>

											<tr>

												<th>
													Libellé
												</th>

												<td>
													{{ annee_scolaire.libelle }}
												</td>

											</tr>

											<tr>

												<th>
													Date de début
												</th>

												<td>
													{{ annee_scolaire.dateDebut
														? annee_scolaire.dateDebut|date('d/m/Y')
														: '—'
													}}
												</td>

											</tr>

											<tr>

												<th>
													Date de fin
												</th>

												<td>
													{{ annee_scolaire.dateFin
														? annee_scolaire.dateFin|date('d/m/Y')
														: '—'
													}}
												</td>

											</tr>

										</tbody>

									</table>

								</div>

							</div>

						</div>

					</div>


					{# ==================== RÉSUMÉ ==================== #}

					<div class="col-xl-3 mt-1">

						<div class="card">

							<div class="card-header d-flex justify-content-between align-items-center">

								<h4 class="card-title mb-0">

									<i class="ti ti-calendar me-2"></i>
									Période scolaire

								</h4>

							</div>

							<div class="card-body text-center">

								<div class="mb-4">

									<i class="ti ti-calendar-stats fs-1 text-primary"></i>

								</div>

								<h5 class="mb-3">
									{{ annee_scolaire.libelle }}
								</h5>

								<div class="mb-3">

									<div class="text-muted small mb-1">
										Début
									</div>

									<strong>
										{{ annee_scolaire.dateDebut
											? annee_scolaire.dateDebut|date('d/m/Y')
											: '—'
										}}
									</strong>

								</div>

								<div class="mb-3">

									<div class="text-muted small mb-1">
										Fin
									</div>

									<strong>
										{{ annee_scolaire.dateFin
											? annee_scolaire.dateFin|date('d/m/Y')
											: '—'
										}}
									</strong>

								</div>

								<hr>

								<div class="text-muted small">

									<i class="ti ti-info-circle me-1"></i>

									Année scolaire

								</div>

							</div>

						</div>

					</div>

				</div>

			</div>

		</div>

	</div>

{% endblock %}