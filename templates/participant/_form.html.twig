{{ form_start(form) }}

<div class="row">
    <div class="col-md-4 mb-3">
        {{ form_label(form.lastname) }}
        {{ form_widget(form.lastname) }}
        {{ form_errors(form.lastname) }}
    </div>

     <div class="col-md-4 mb-3">
        {{ form_label(form.middlename) }}
        {{ form_widget(form.middlename) }}
        {{ form_errors(form.middlename) }}
    </div>

    <div class="col-md-4 mb-3">
        {{ form_label(form.firstname) }}
        {{ form_widget(form.firstname) }}
        {{ form_errors(form.firstname) }}
       
    </div>

    <div class="col-md-4 mb-3">
        {{ form_label(form.gender) }}
        {{ form_widget(form.gender) }}
        {{ form_errors(form.gender) }}
    </div>
    <div class="col-md-4 mb-3">
        {{ form_label(form.organization) }}
        {{ form_widget(form.organization) }}
        {{ form_errors(form.organization) }}
    </div>
    <div class="col-md-4 mb-3">
        {{ form_label(form.grade) }}
        {{ form_widget(form.grade) }}
        {{ form_errors(form.grade) }}
    </div>

    <div class="col-md-4 mb-3">
        {{ form_label(form.phone) }}
        {{ form_widget(form.phone) }}
        {{ form_errors(form.phone) }}
    </div>

    <div class="col-md-4 mb-3">
        {{ form_label(form.phoneMobileMoney) }}
        {{ form_widget(form.phoneMobileMoney) }}
        {{ form_errors(form.phoneMobileMoney) }}
    </div>


    <div class="col-md-4 mb-3">
        {{ form_label(form.enabled) }}
        {{ form_widget(form.enabled) }}
        {{ form_errors(form.enabled) }}
    </div>

</div>

<div class="text-end mt-4">
    <button class="btn btn-primary">
        <i class="ti ti-device-floppy me-1"></i>
        {{ button_label|default('Enregistrer') }}
    </button>
</div>

{{ form_end(form) }}