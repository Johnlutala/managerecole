{% extends 'base.html.twig' %}

{% block title %}Participant
{% endblock %}

{% block body %}

	<body>
		<div class="wrapper">
			<div class="content-page">
				<div class="container-fluid">
					<div class="page-title-head d-flex align-items-center">
						<div class="flex-grow-1">
							<h4 class="fs-xl fw-bold m-0">Détail du participant</h4>
						</div>

						<div class="text-end">
							<ol class="breadcrumb m-0 py-0">
								<li class="breadcrumb-item">
									<a href="javascript: void(0);">ENABEL</a>
								</li>
								<li class="breadcrumb-item">
									<a href="javascript: void(0);">Participants</a>
								</li>
								<li class="breadcrumb-item active">Détail</li>
							</ol>
						</div>
					</div>

					<div class="row">
						<div class="col-xl-3">
							<div class="card">
								<div class="card-header">
									<h4 class="card-title">Participant N° :
										{{ participant.id }}</h4>
								</div>

								<div class="card-body text-center">
									<h4>{{ participant.fullname ?: participant.code }}</h4>
									<p class="text-muted">
										Code :
										<strong>{{ participant.code }}</strong>
									</p>
									{% if participant.enabled %}
										<span class="badge bg-success">Actif</span>
									{% else %}
										<span class="badge bg-danger">Inactif</span>
									{% endif %}

									<hr>

									<div class="d-grid gap-2">
										<a href="{{ path('app_participant_edit', {'id': participant.id}) }}" class="btn btn-warning">
											<i class="ti ti-edit"></i>
											Modifier
										</a>

										{% include 'participant/_delete_form.html.twig' %}

										<a href="{{ path('app_participant_index') }}" class="btn btn-secondary">
											<i class="ti ti-arrow-left"></i>
											Retour
										</a>
									</div>
								</div>
							</div>
						</div>

						<div class="col-xl-9">
							<div class="card">
								<div class="card-header">
									<h4 class="card-title">Détails du participant</h4>
								</div>
								<div class="card-body">
									<div class="table-responsive">
										<table class="table table-bordered align-middle">
											<tbody>
												<tr>
													<th>Nom</th>
													<td>{{ participant.lastname }}</td>
												</tr>
												<tr>
													<th>Postnom</th>
													<td>{{ participant.middlename ?: '---' }}</td>
												</tr>
												<tr>
													<th>Prénom</th>
													<td>{{ participant.firstname }}</td>
												</tr>
												
												<tr>
													<th>Téléphone</th>
													<td>{{ participant.phone ?: '---' }}</td>
												</tr>
												<tr>
													<th>Téléphone Mobile Money</th>
													<td>{{ participant.phoneMobileMoney ?: '---' }}</td>
												</tr>
												<tr>
													<th>Genre</th>
													<td>{{ participant.gender ?: '---' }}</td>
												</tr>
												<tr>
													<th>Organisation</th>
													<td>{{ participant.organization ?: '---' }}</td>
												</tr>
												<tr>
													<th>Grade</th>
													<td>{{ participant.grade ?: '---' }}</td>
												</tr>
												<tr>
													<th>Créé par</th>
													<td>{{ participant.createdBy ? participant.createdBy.firstname ~ ' ' ~ participant.createdBy.lastname : '---' }}</td>
												</tr>
												<tr>
													<th>Crée le </th>
													<td>{{ participant.createdAt ? participant.createdAt|date('d/m/Y H:i') : '---' }}</td>
												</tr>
												<tr>
													<th>Modifié le</th>
													<td>{{ participant.updatedAt ? participant.updatedAt|date('d/m/Y H:i') : '---' }}</td>
												</tr>
											</tbody>
										</table>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</body>
{% endblock %}
