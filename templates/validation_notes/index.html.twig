{% extends 'base.html.twig' %}

{% block title %}Validation des notes{% endblock %}

{% block body %}
    <div class="content-page">
        <div class="container-fluid">
            <div class="page-title-head d-flex align-items-center mb-3">
                <div class="flex-grow-1">
                    <h4 class="fs-xl fw-bold m-0">Validation administrative des notes</h4>
                    <p class="text-muted mb-0">Contrôlez les saisies soumises avant la clôture de la période.</p>
                </div>
            </div>

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type == 'warning' ? 'warning' : 'success' }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            <div data-table data-table-rows-per-page="8" class="card">
                <div class="card-header border-light d-flex justify-content-between align-items-center gap-2 flex-wrap">
                    <div class="app-search">
                        <input data-table-search type="search" class="form-control" placeholder="Rechercher une note soumise...">
                        <i data-lucide="search" class="app-search-icon text-muted"></i>
                    </div>
                    <span class="text-muted small">Contrôle avant clôture</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-custom table-centered table-hover w-100 mb-0">
                        <thead class="bg-light bg-opacity-25 thead-sm">
                            <tr class="text-uppercase fs-xxs">
                                <th>École</th>
                                <th>Classe</th>
                                <th>Cours</th>
                                <th>Évaluation</th>
                                <th class="text-center">Soumises</th>
                                <th class="text-center">Validées</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ligne in evaluations %}
                                {% set evaluation = ligne.evaluation %}
                                <tr>
                                    <td>{{ evaluation.cours.classe.ecole.nom }}</td>
                                    <td>{{ evaluation.cours.classe.nom }}</td>
                                    <td>{{ evaluation.cours.nom }}</td>
                                    <td>{{ evaluation.nom }} <small class="text-muted">/ {{ evaluation.bareme }}</small></td>
                                    <td class="text-center"><span class="badge bg-warning text-dark">{{ ligne.soumises }}</span></td>
                                    <td class="text-center"><span class="badge bg-success">{{ ligne.validees }}</span></td>
                                    <td>
                                        {% if ligne.soumises > 0 %}
                                            <form method="post" action="{{ path('app_validation_notes_traiter', {id: evaluation.id}) }}" class="d-flex gap-2 justify-content-center">
                                                <input type="hidden" name="_token" value="{{ csrf_token('validation_notes_' ~ evaluation.id) }}">
                                                <button class="btn btn-sm btn-outline-secondary" name="action" value="retourner">Retourner</button>
                                                <button class="btn btn-sm btn-success" name="action" value="valider">Valider</button>
                                            </form>
                                        {% else %}
                                            <span class="text-muted">Aucune action</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="7" class="text-center py-5 text-muted">Aucune note soumise ou validée.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer border-0 d-flex justify-content-between">
                    <div data-table-pagination-info></div>
                    <div data-table-pagination></div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
