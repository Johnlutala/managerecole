<div
	class="wrapper">
	<!-- Begin page --
				            
				  <!-- Sidenav Menu Start -->
	<div
		class="sidenav-menu">
		<!-- Brand Logo -->
		<a href="index-2.html" class="logo">
			<span class="logo logo-light">
				<span class="logo-lg"><img src="assets/images/enabel.png"></span>
			</span>

		</a>

		<!-- Sidebar Hover Menu Toggle Button -->
		<button class="button-on-hover">
			<i class="ti ti-menu-4 fs-22 align-middle"></i>
		</button>

		<!-- Full Sidebar Menu Close Button -->
		<button class="button-close-offcanvas">
			<i class="ti ti-x align-middle"></i>
		</button>

		<div
			class="scrollbar" data-simplebar>
			<!--- Sidenav Menu -->
			<ul class="side-nav">
				<li class="side-nav-title mt-2" data-lang="menu-title">Navigation</li>

				<li class="side-nav-item">
					<a href="{{ path('app_default') }}" class="side-nav-link">
						<span class="menu-icon">
							<i data-lucide="circle-gauge"></i>
						</span>
						<span class="menu-text" data-lang="Dashboard">
							Dashboards
						</span>
					</a>
				</li>

				{# Menu de Siedbar  #}
				<li class="side-nav-title" data-lang="apps-title">Apps</li>

				<li class="side-nav-item">
					<a href="{{ path('app_workshop_index') }}" class="side-nav-link">
						<span class="menu-icon">
							<i data-lucide="graduation-cap"></i>
						</span>
						<span class="menu-text" data-lang="etelier">
							Atéliers
						</span>
					</a>
				</li>
				<li class="side-nav-item">
					<a href="{{ path('app_participant_index') }}" class="side-nav-link">
						<span class="menu-icon">
							<i data-lucide="users"></i>
						</span>
						<span class="menu-text" data-lang="participant">
							Participant
						</span>
					</a>
				</li>
				{% if is_granted('ROLE_ADMIN') %}
					<li class="side-nav-item">
						<a href="{{ path('app_user_index') }}" class="side-nav-link">
							<span class="menu-icon">
								<i data-lucide="user"></i>
							</span>
							<span class="menu-text" data-lang="participant">
								Utilisateurs
							</span>
						</a>
					</li>
				{% endif %}

			</ul>
		</div>
	</div>
	<!-- Sidenav Menu End -->

	<!-- Topbar Start -->
	<header class="app-topbar" style="position:fixed; top:0; left:0; right:0; z-index:1030;">
		<div class="container-fluid topbar-menu">
			<div class="d-flex align-items-center gap-2">
				<button class="sidenav-toggle-button btn btn-default btn-icon">
					<i class="ti ti-menu-4 fs-22"></i>
				</button>
				<button class="topnav-toggle-button px-2" data-bs-toggle="collapse" data-bs-target="#topnav-menu-content">
					<i class="ti ti-menu-4 fs-22"></i>
				</button>
			</div>

			{# Navbar détail #}
			<div
				class="d-flex align-items-center gap-2">
				<!-- Theme Mode Dropdown -->
				<div class="topbar-item">
					<div class="dropdown">
						<button class="topbar-link" data-bs-toggle="dropdown" data-bs-offset="0,24" type="button" aria-haspopup="false" aria-expanded="false">
							<i data-lucide="sun" class="fs-xxl"></i>
						</button>
						<ul class="dropdown-menu dropdown-menu-end thememode-dropdown">
							<li>
								<label class="dropdown-item">
									<i data-lucide="sun" class="align-middle me-1 fs-16"></i>
									<span class="align-middle">Light</span>
									<input class="form-check-input" type="radio" name="data-bs-theme" value="light">
								</label>
							</li>

							<li>
								<label class="dropdown-item">
									<i data-lucide="moon" class="align-middle me-1 fs-16"></i>
									<span class="align-middle">Dark</span>
									<input class="form-check-input" type="radio" name="data-bs-theme" value="dark">
								</label>
							</li>

							<li>
								<label class="dropdown-item">
									<i data-lucide="monitor-cog" class="align-middle me-1 fs-16"></i>
									<span class="align-middle">System</span>
									<input class="form-check-input" type="radio" name="data-bs-theme" value="system">
								</label>
							</li>

						</ul>
					</div>
				</div>


				<!-- Light/Dark Mode Button -->
				<div class="topbar-item d-none">
					<button class="topbar-link" id="light-dark-mode" type="button">
						<i data-lucide="moon" class="fs-xxl mode-light-moon"></i>
					</button>
				</div>


				<!-- User Dropdown -->
				<div class="topbar-item nav-user">
					<div class="dropdown">
						<a class="topbar-link dropdown-toggle drop-arrow-none px-2 d-flex align-items-center" data-bs-toggle="dropdown" data-bs-offset="0,19" href="#!" aria-haspopup="false" aria-expanded="false">

							<!-- Avatar -->
							<div class="avatar avatar-sm rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2" style="width:40px;height:40px;font-weight:600;font-size:15px;">

								{% if app.user %}
									{{ app.user.firstname|first|upper }}{{ app.user.lastname|first|upper }}
								{% else %}
									U
								{% endif %}

							</div>

							<!-- Nom -->
							<div class="d-lg-flex align-items-center gap-1 d-none">
								<h5 class="my-0">
									{% if app.user %}
										{{ app.user.firstname }}
										{{ app.user.lastname }}
									{% else %}
										Utilisateur
									{% endif %}
								</h5>
								<i class="ti ti-chevron-down align-middle"></i>
							</div>

						</a>

						<div class="dropdown-menu dropdown-menu-end" style="min-width: 280px;">

							<div class="px-3 py-0">

								<div class="d-flex align-items-center mb-3">

									<div class="avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width:55px;height:55px;font-size:18px;font-weight:bold;">

										{% if app.user %}
											{{ app.user.firstname|first|upper }}{{ app.user.lastname|first|upper }}
										{% else %}
											U
										{% endif %}

									</div>

									<div>
										<h6 class="mb-1">
											{{ app.user.firstname ? app.user.firstname : '---' }}
											{{ app.user.lastname ? app.user.lastname : '---' }}
										</h6>
										<small class="text-muted">
											Connecté
										</small>
									</div>
								</div>
							</div>

							<div class="dropdown-divider"></div>
							<div class="dropdown-item py-1">
								<small class="text-muted">
									<strong>Username :</strong>
								</small>
								<span class="fw-semibold">{{ app.user.username ? app.user.username : '---' }}</span>
							</div>

							<div class="dropdown-item py-1">
								<small class="text-muted">
									<strong>Rôle :</strong>
								</small>

								{% if 'ROLE_SUPER_ADMIN' in app.user.roles %}
									<span class="fw-semibold text-danger">Super Administrateur</span>
								{% elseif 'ROLE_ADMIN' in app.user.roles %}
									<span class="fw-semibold text-primary">Administrateur</span>
								{% elseif 'ROLE_USER' in app.user.roles %}
									<span class="fw-semibold text-success">Utilisateur</span>
								{% else %}
									<span class="fw-semibold text-secondary">Non défini</span>
								{% endif %}
							</div>

							<div class="dropdown-divider"></div>

							<a href="{{ path('app_user_show', {'id': app.user.id}) }}" class="dropdown-item">
								<i class="ti ti-user-circle me-2"></i>
								Mon profil
							</a>

							<a href="{{ path('app_logout') }}" class="dropdown-item text-danger">
								<i class="ti ti-logout-2 me-2"></i>
								Déconnexion
							</a>
						</div>

					</div>
				</div>
				
			</div>
		</div>
	</header>
	<div style="height:72px; visibility:hidden;"></div>
	
