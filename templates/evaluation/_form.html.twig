
{{ form_start(form, {
    attr: {
        class: 'needs-validation'
    }
}) }}

<div class="row g-3">

    {# Période et type de cotation #}
    <div class="col-md-6">
        {{ form_label(form.nom, 'Période ou examen', {
            label_attr: {class: 'form-label fw-semibold'}
        }) }}
        {{ form_widget(form.nom) }}
        {{ form_errors(form.nom) }}
        {{ form_help(form.nom) }}
    </div>

    <div class="col-md-6">
        {{ form_label(form.type, 'Type de cotation', {
            label_attr: {class: 'form-label fw-semibold'}
        }) }}
        {{ form_widget(form.type) }}
        {{ form_errors(form.type) }}
        {{ form_help(form.type) }}
    </div>

    {# Barème et coefficient #}
    <div class="col-md-6">
        {{ form_label(form.bareme, 'Barème maximal', {
            label_attr: {class: 'form-label fw-semibold'}
        }) }}
        {{ form_widget(form.bareme) }}
        {{ form_errors(form.bareme) }}
    </div>

    <div class="col-md-6">
        {{ form_label(form.coefficient, 'Coefficient', {
            label_attr: {class: 'form-label fw-semibold'}
        }) }}
        {{ form_widget(form.coefficient) }}
        {{ form_errors(form.coefficient) }}
    </div>

    {# Date et cours #}
    <div class="col-md-6">
        {{ form_label(form.dateEvaluation, "Date d'évaluation", {
            label_attr: {class: 'form-label fw-semibold'}
        }) }}
        {{ form_widget(form.dateEvaluation) }}
        {{ form_errors(form.dateEvaluation) }}
    </div>

    <div class="col-md-6">
        {{ form_label(form.cours, 'Cours', {
            label_attr: {class: 'form-label fw-semibold'}
        }) }}
        {{ form_widget(form.cours) }}
        {{ form_errors(form.cours) }}
    </div>

    {# Semestre #}
    <div class="col-md-6">
        {{ form_label(form.configurationBulletin, 'Semestre', {
            label_attr: {class: 'form-label fw-semibold'}
        }) }}
        {{ form_widget(form.configurationBulletin) }}
        {{ form_errors(form.configurationBulletin) }}
    </div>

</div>

{{ form_rest(form) }}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-4 pt-3 border-top">
    <a href="{{ path('app_evaluation_index') }}"
       class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i>
        Retour à la liste
    </a>

    <button type="submit" class="btn btn-primary">
        <i class="ti ti-device-floppy me-1"></i>
        {{ button_label|default('Enregistrer') }}
    </button>
</div>

{{ form_end(form) }}
