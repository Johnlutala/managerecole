
{% extends 'base.html.twig' %}

{% block title %}Détail de l'évaluation{% endblock %}

{% block body %}
    <div class="wrapper">
        <div class="content-page">
            <div class="container-fluid">

                <div class="page-title-head d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
                    <div>
                        <h4 class="fs-xl fw-bold m-0">
                            Détail de l'évaluation
                        </h4>
                        <p class="text-muted mb-0 mt-1">
                            Consultez les informations de l'évaluation sélectionnée.
                        </p>
                    </div>

                    <div class="text-end">
                        <ol class="breadcrumb m-0 py-0">
                            <li class="breadcrumb-item">
                                <a href="javascript:void(0);">ADMIN</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="{{ path('app_evaluation_index') }}">
                                    Évaluations
                                </a>
                            </li>
                            <li class="breadcrumb-item active">Détail</li>
                        </ol>
                    </div>
                </div>

                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type in ['success', 'danger', 'warning', 'info'] ? type : 'info' }} alert-dismissible fade show"
                             role="alert">
                            {{ message }}
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Fermer"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                <div class="row g-3">

                    {# Informations rapides #}
                    <div class="col-xl-3 col-lg-4">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title mb-0">
                                    Évaluation N° : {{ evaluation.id }}
                                </h4>
                            </div>

                            <div class="card-body text-center">
                                <div class="avatar-xl mx-auto mb-3">
                                    <div class="avatar-title bg-primary-subtle text-primary rounded">
                                        <i class="ti ti-clipboard-check fs-1"></i>
                                    </div>
                                </div>

                                <h4 class="mb-2">
                                    {{ evaluation.nom }}
                                </h4>

                                <p class="text-muted small mb-3">
                                    Évaluation scolaire
                                </p>

                                <span class="badge bg-primary-subtle text-primary">
                                    {{ evaluation.type|default('Type non défini') }}
                                </span>

                                <hr>

                                <div class="d-grid gap-2">

                                    <a href="{{ path('app_evaluation_edit', {'id': evaluation.id}) }}"
                                       class="btn btn-warning">
                                        <i class="ti ti-edit me-1"></i>
                                        Modifier
                                    </a>

                                    {{ include('evaluation/_delete_form.html.twig') }}

                                    <a href="{{ path('app_evaluation_index') }}"
                                       class="btn btn-secondary">
                                        <i class="ti ti-arrow-left me-1"></i>
                                        Retour
                                    </a>

                                </div>
                            </div>
                        </div>
                    </div>

                    {# Informations détaillées #}
                    <div class="col-xl-8 col-lg-8">
                        <div class="card h-100">
                            <div class="card-header">
                                <h4 class="card-title mb-0">
                                    <i class="ti ti-info-circle me-2"></i>
                                    Informations de l'évaluation
                                </h4>
                            </div>

                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-bordered align-middle mb-0">
                                        <tbody>
                                            <tr>
                                                <th style="width: 40%;">Référence</th>
                                                <td>#{{ evaluation.id }}</td>
                                            </tr>
                                            <tr>
                                                <th>Nom de l'évaluation</th>
                                                <td class="fw-semibold">
                                                    {{ evaluation.nom }}
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Type</th>
                                                <td>
                                                    {{ evaluation.type|default('Non défini') }}
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Barème</th>
                                                <td>
                                                    {{ evaluation.bareme }}
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Coefficient</th>
                                                <td>
                                                    {{ evaluation.coefficient }}
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Date de l'évaluation</th>
                                                <td>
                                                    {% if evaluation.dateEvaluation %}
                                                        {{ evaluation.dateEvaluation|date('d/m/Y') }}
                                                    {% else %}
                                                        <span class="text-muted">Non renseignée</span>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Date de création</th>
                                                <td>
                                                    {% if evaluation.createdAt %}
                                                        {{ evaluation.createdAt|date('d/m/Y à H:i') }}
                                                    {% else %}
                                                        <span class="text-muted">Non renseignée</span>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
{% endblock %}