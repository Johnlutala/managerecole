{% extends 'base.html.twig' %}
{% block title %}Évaluations{% endblock %}
{% block body %}
    <div class="content-page"><div class="container-fluid">
        <div class="page-title-head d-flex align-items-center mb-3"><div class="flex-grow-1"><h4 class="fs-xl fw-bold m-0">Évaluations</h4></div></div>
        <div data-table data-table-rows-per-page="8" class="card">
            <div class="card-header border-light d-flex justify-content-between align-items-center gap-2 flex-wrap">
                <div class="app-search"><input data-table-search type="search" class="form-control" placeholder="Rechercher une évaluation..."><i data-lucide="search" class="app-search-icon text-muted"></i></div>
                <a href="{{ path('app_evaluation_new') }}" class="btn btn-primary"><i class="ti ti-plus me-1"></i>Nouvelle évaluation</a>
            </div>
            <div class="table-responsive"><table class="table table-custom table-centered table-hover w-100 mb-0">
                <thead class="bg-light bg-opacity-25 thead-sm"><tr class="text-uppercase fs-xxs"><th>Évaluation</th><th>Cours</th><th>Période</th><th>Barème</th><th>Coefficient</th><th>Date</th><th class="text-center">Actions</th></tr></thead>
                <tbody>{% for evaluation in evaluations %}<tr>
                    <td><a class="link-reset fw-semibold" href="{{ path('app_evaluation_show', {id: evaluation.id}) }}">{{ evaluation.nom }}</a><small class="text-muted d-block">{{ evaluation.type }}</small></td>
                    <td>{{ evaluation.cours ? evaluation.cours.nom : '—' }}</td><td>{{ evaluation.configurationBulletin ? evaluation.configurationBulletin.nom : '—' }}</td><td>/ {{ evaluation.bareme }}</td><td>{{ evaluation.coefficient }}</td><td>{{ evaluation.dateEvaluation ? evaluation.dateEvaluation|date('d/m/Y') : '—' }}</td>
                    <td><div class="d-flex justify-content-center gap-1"><a href="{{ path('app_evaluation_show', {id: evaluation.id}) }}" class="btn btn-default btn-icon btn-sm rounded-circle" title="Voir"><i class="ti ti-eye fs-lg"></i></a><a href="{{ path('app_evaluation_edit', {id: evaluation.id}) }}" class="btn btn-default btn-icon btn-sm rounded-circle" title="Modifier"><i class="ti ti-edit fs-lg"></i></a></div></td>
                </tr>{% else %}<tr><td colspan="7" class="text-center py-5 text-muted">Aucune évaluation configurée.</td></tr>{% endfor %}</tbody>
            </table></div>
            <div class="card-footer border-0 d-flex justify-content-between"><div data-table-pagination-info></div><div data-table-pagination></div></div>
        </div>
    </div></div>
{% endblock %}
