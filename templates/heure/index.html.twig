{% extends 'base.html.twig' %}

{% block title %}Heures{% endblock %}

{% block body %}

<div class="wrapper">
    <div class="content-page">
        <div class="container-fluid">


        {# =========================
           TITRE
        ========================= #}
        <div class="page-title-head d-flex align-items-center">

            <div class="flex-grow-1">
                <h4 class="fs-xl fw-bold m-0">
                    Heures
                </h4>

                <p class="text-muted mb-0">
                    Gestion des heures scolaires.
                </p>
            </div>

        </div>


        {# =========================
           TABLEAU
        ========================= #}
        <div
            data-table
            data-table-rows-per-page="8"
            class="card"
        >

            {# HEADER #}
            <div class="card-header border-light d-flex justify-content-between">

                <div class="app-search">

                    <input
                        data-table-search
                        type="search"
                        class="form-control"
                        placeholder="Rechercher..."
                    >

                    <i
                        data-lucide="search"
                        class="app-search-icon text-muted"
                    ></i>

                </div>


                <button
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#addModal"
                >
                    <i class="ti ti-plus me-1"></i>
                    Ajouter
                </button>

            </div>


            {# TABLE #}
            <div class="table-responsive">

                <table class="table table-custom table-centered table-hover w-100 mb-0">

                    <thead class="bg-light bg-opacity-25 thead-sm">

                        <tr class="text-uppercase fs-xxs">

                            <th>Nom</th>
                            <th>Heure de début</th>
                            <th>Heure de fin</th>
                            <th>Ordre</th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                    {% for heure in heures %}

                        <tr>

                            <td>
                                <span class="fw-semibold">
                                    {{ heure.nom }}
                                </span>
                            </td>

                            <td>
                                {{ heure.heureDebut
                                    ? heure.heureDebut|date('H:i')
                                    : '—'
                                }}
                            </td>

                            <td>
                                {{ heure.heureFin
                                    ? heure.heureFin|date('H:i')
                                    : '—'
                                }}
                            </td>

                            <td>
                                <span class="badge badge-soft-primary">
                                    {{ heure.ordre }}
                                </span>
                            </td>


                            {# ACTIONS #}
                            <td>

                                <div class="d-flex justify-content-center gap-1">

                                    <a
                                        href="{{ path('app_heure_show', {'id': heure.id}) }}"
                                        class="btn btn-default btn-icon btn-sm rounded-circle"
                                        title="Voir"
                                    >
                                        <i class="ti ti-eye fs-lg"></i>
                                    </a>


                                    <a
                                        href="{{ path('app_heure_edit', {'id': heure.id}) }}"
                                        class="btn btn-default btn-icon btn-sm rounded-circle"
                                        title="Modifier"
                                    >
                                        <i class="ti ti-edit fs-lg"></i>
                                    </a>

                                </div>

                            </td>

                        </tr>

                    {% else %}

                        <tr>

                            <td colspan="5" class="text-center py-5 text-muted">
                                Aucune heure enregistrée.
                            </td>
                        </tr>
                    {% endfor %}

                    </tbody>

                </table>

            </div>

            {# PAGINATION #}
            <div class="card-footer border-0 d-flex justify-content-between">

                <div data-table-pagination-info></div>

                <div data-table-pagination></div>

            </div>

        </div>

    </div>
</div>

</div>

<div class="modal fade" id="addModal" tabindex="-1" aria-hidden="true">
<div class="modal-dialog modal-lg">
    <div class="modal-content">
        {{ form_start(form) }}
        {# HEADER #}
        <div class="modal-header">
            <div>
                <h5 class="modal-title">
                    Nouvelle heure
                </h5>
                <small class="text-muted">
                    Ajouter une nouvelle plage horaire.
                </small>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" ></button>
        </div>

        {# BODY #}
        <div class="modal-body">
            {% include 'heure/_form.html.twig' with {
                form: form,
                button_label: 'Enregistrer'
            } only %}

        </div>

        {# FOOTER #}
        <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                Annuler
            </button>
            <button type="submit" class="btn btn-primary"  >
                <i class="ti ti-device-floppy me-1"></i>
                Enregistrer
            </button>
        </div>
        {{ form_end(form) }}
    </div>
</div>
</div>

{% endblock %}
