{% extends 'base.html.twig' %}

{% block title %}Résultats — {{ classe.nom }}{% endblock %}

{% block body %}
    <div class="content-page">
        <div class="container-fluid">
            <div class="page-title-head d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                <div>
                    <a href="{{ path('app_bulletin_index', {ecole: classe.ecole.id, classe: classe.id, annee: annee.id, option: option ? option.id : 0}) }}" class="text-muted">← Retour aux bulletins</a>
                    <h4 class="fs-xl fw-bold mt-2 mb-1">{{ classe.nom }}{% if option %} — {{ option.nom }}{% endif %}</h4>
                    <p class="text-muted mb-0">{{ classe.ecole.nom }} · Année scolaire {{ annee.libelle }}</p>
                </div>
                <a class="btn btn-outline-danger" href="{{ path('app_bulletin_pdf_classe', {id: classe.id, annee: annee.id, option: option ? option.id : 0}) }}">
                    <i data-lucide="file-down" class="me-1"></i>Télécharger tous les bulletins PDF
                </a>
            </div>

            <div class="card">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr><th>#</th><th>Nom de l’élève</th><th>Pourcentage cumulé</th><th>Décision</th><th class="text-end">Bulletin</th></tr>
                        </thead>
                        <tbody>
                            {% for bulletin in bulletins %}
                                <tr>
                                    <td>{{ loop.index }}</td>
                                    <td class="fw-semibold">{{ bulletin.eleve.nom }} {{ bulletin.eleve.postnom }} {{ bulletin.eleve.prenom }}</td>
                                    <td>{{ bulletin.pourcentage|number_format(2, ',', ' ') }} %</td>
                                    <td><span class="badge {{ bulletin.decision == 'admis' ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' }}">{{ bulletin.decision == 'admis' ? 'Admis(e)' : 'Ajourné(e)' }}</span></td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_bulletin_eleve', {id: bulletin.id}) }}" aria-label="Ouvrir le bulletin de {{ bulletin.eleve.nom }} {{ bulletin.eleve.prenom }}">
                                            <i data-lucide="eye"></i> Voir
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
