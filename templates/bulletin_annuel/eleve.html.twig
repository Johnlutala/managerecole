{% extends 'base.html.twig' %}

{% block title %}Bulletin de {{ bulletin.eleve.nom }} {{ bulletin.eleve.prenom }}{% endblock %}

{% block body %}
    <style>
        .bulletin-sheet {
            background: #fff;
            border: 1px solid #d7dce1;
            padding: 1.5rem;
            color: #17212b;
            font-family: Arial, sans-serif;
            font-size: 0.72rem;
        }
        .official-header,
        .student-info,
        .bulletin-grades,
        .bulletin-result,
        .signatures {
            width: 100%;
            border-collapse: collapse;
        }
        .official-header {
            margin-bottom: 0.5rem;
        }
        .official-header td {
            vertical-align: middle;
        }
        .header-logo,
        .header-right {
            width: 13%;
        }
        .header-logo img {
            width: 55px;
            height: 55px;
        }
        .header-text {
            width: 74%;
            text-align: center;
        }
        .header-right {
            text-align: right;
            font-weight: bold;
        }
        .country-name,
        .ministry-name,
        .education-name,
        .document-title,
        .school-name,
        .results-title {
            font-weight: bold;
        }
        .country-name {
            font-size: 1rem;
        }
        .ministry-name {
            margin-top: 0.25rem;
        }
        .education-name {
            margin-top: 0.2rem;
        }
        .document-title,
        .results-title {
            text-align: center;
            border: 1px solid #111;
            padding: 0.35rem;
        }
        .school-name {
            text-align: center;
            margin: 0.4rem 0;
            text-transform: uppercase;
        }
        .student-info {
            margin-bottom: 0.4rem;
        }
        .student-info td,
        .bulletin-grades th,
        .bulletin-grades td {
            border: 1px solid #111;
            padding: 0.2rem;
        }
        .student-label {
            font-weight: bold;
        }
        .results-title {
            background: #dedede;
        }
        .bulletin-grades {
            table-layout: fixed;
            font-size: 0.62rem;
        }
        .bulletin-grades th,
        .bulletin-grades td {
            text-align: center;
            vertical-align: middle;
        }
        .bulletin-grades thead th,
        .bulletin-grades .cumul-column,
        .bulletin-grades .rep-heading,
        .bulletin-grades .rep-subtitle {
            background: #dedede;
            font-weight: bold;
        }
        .bulletin-grades .course-column {
            width: 17%;
            text-align: left;
        }
        .bulletin-grades .domain-row th {
            background: #c8c8c8;
            text-align: left;
        }
        .bulletin-grades .subtotal-row th,
        .bulletin-grades .subtotal-row td {
            background: #e5e5e5;
            font-weight: bold;
        }
        .bulletin-grades .total-row th,
        .bulletin-grades .total-row td {
            background: #bdbdbd;
            font-weight: bold;
        }
        .bulletin-grades .rep-cell,
        .bulletin-grades .rep-heading,
        .bulletin-grades .rep-subtitle {
            border-left: 2px solid #111;
        }
        .bulletin-result {
            margin-top: 0.4rem;
        }
        .bulletin-result td {
            border: 1px solid #111;
            padding: 0.35rem;
            text-align: center;
        }
        .bulletin-result strong {
            display: block;
            margin-top: 0.2rem;
        }
        .signatures {
            margin-top: 1.6rem;
        }
        .signatures td {
            width: 33.33%;
            text-align: center;
            font-weight: bold;
            padding-top: 0.35rem;
        }
        .signature-space {
            height: 2rem;
        }
        .footer-note {
            font-size: 0.65rem;
            margin: 0.25rem 0;
        }
        .decision {
            text-transform: uppercase;
        }
        @media print {
            @page {
                size: A4 landscape;
                margin: 7mm 6mm;
            }
            .content-page {
                margin: 0 !important;
                padding: 0 !important;
            }
            .bulletin-sheet {
                border: 0;
                padding: 0;
            }
        }
    </style>
    <div class="content-page">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <a
                    class="btn btn-outline-secondary"
                    href="{{ path('app_bulletin_classe', {id : bulletin.classe.id, annee : bulletin.anneeScolaire.id, option : bulletin.option ? bulletin.option.id : 0}) }}"
                >
                    ← Retour</a>
                <button type="button" class="btn btn-primary" onclick="window.print()">
                    <i data-lucide="printer" class="me-1"></i>
                    Imprimer
                </button>
            </div>
            {% include 'bulletin_annuel/_fiche.html.twig' with {bulletin: bulletin, position: position, effectif: effectif, periode_headers: periode_headers} only %}
        </div>
    </div>
{% endblock %}
