
{{ form_start(form) }}

<div class="row gx-3 gy-3">

    <div class="col-md-6">
        {{ form_row(form.nom, {
            'label': 'Nom du jour',
            'attr': {
                'placeholder': 'Ex. : Lundi',
                'class': 'form-control'
            }
        }) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.ordre, {
            'label': 'Ordre',
            'attr': {
                'placeholder': 'Ex. : 1',
                'class': 'form-control',
                'min': 1
            }
        }) }}
    </div>

</div>

<div class="d-flex justify-content-end gap-2 mt-4">

    <a href="{{ path('app_jour_index') }}"
       class="btn btn-light">
        <i class="ti ti-arrow-left me-1"></i>
        Annuler
    </a>

    <button type="submit" class="btn btn-primary">
        <i class="ti ti-device-floppy me-1"></i>
        {{ button_label|default('Enregistrer') }}
    </button>

</div>

{{ form_end(form) }}

