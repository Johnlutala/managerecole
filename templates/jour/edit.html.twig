
{% extends 'base.html.twig' %}

{% block title %}Modifier un jour{% endblock %}

{% block body %}

<div class="wrapper">
    <div class="content-page">
        <div class="container-fluid">

            {# Titre de la page #}
            <div class="page-title-head d-flex align-items-center mb-3">

                <div class="flex-grow-1">
                    <h4 class="fs-xl fw-bold m-0">
                        Modifier un jour
                    </h4>

                    <p class="text-muted mb-0">
                        Modifier les informations de ce jour de la semaine.
                    </p>
                </div>

                <div>
                    <a href="{{ path('app_jour_index') }}"
                       class="btn btn-light">
                        <i class="ti ti-arrow-left me-1"></i>
                        Retour à la liste
                    </a>
                </div>

            </div>

            {# Contenu principal #}
            <div class="row">

                {# Formulaire de modification #}
                <div class="col-lg-8">

                    <div class="card">

                        <div class="card-header">
                            <h5 class="card-title mb-0">
                                Informations du jour
                            </h5>
                        </div>

                        <div class="card-body">

                            {{ include('jour/_form.html.twig', {
                                'button_label': 'Enregistrer les modifications'
                            }) }}

                        </div>

                    </div>

                </div>

                {# Actions complémentaires #}
                <div class="col-lg-4">

                    <div class="card">

                        <div class="card-header">
                            <h5 class="card-title mb-0">
                                Actions
                            </h5>
                        </div>

                        <div class="card-body">

                            <div class="d-grid gap-2">

                                <a href="{{ path('app_jour_index') }}"
                                   class="btn btn-light">
                                    <i class="ti ti-list me-1"></i>
                                    Retour à la liste
                                </a>

                            </div>

                            <hr>

                            <div>
                                <h6 class="text-danger">
                                    <i class="ti ti-alert-triangle me-1"></i>
                                    Zone dangereuse
                                </h6>

                                <p class="text-muted small mb-3">
                                    La suppression de ce jour peut affecter
                                    les horaires qui lui sont associés.
                                </p>

                                {{ include('jour/_delete_form.html.twig') }}
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

{% endblock %}

