
{{ form_start(form, {
     attr: {
        class: 'needs-validation'
    }
}) }}

<div class="row g-3">

    {# Nom et statut #}
    <div class="col-md-6">
        {{ form_label(form.nom, 'Nom de la période', {
            label_attr: {class: 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.nom) }}
        {{ form_errors(form.nom) }}
    </div>

    <div class="col-md-6">
        {{ form_label(form.statut, 'Statut de la période', {
            label_attr: {class: 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.statut) }}
        {{ form_errors(form.statut) }}
    </div>

    {# Modèle et école #}
    <div class="col-md-6">
        {{ form_label(form.modeleBulletin, 'Modèle de bulletin', {
            label_attr: {class: 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.modeleBulletin) }}
        {{ form_errors(form.modeleBulletin) }}
    </div>

    <div class="col-md-6">
        {{ form_label(form.ecole, 'École', {
            label_attr: {class: 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.ecole) }}
        {{ form_errors(form.ecole) }}
    </div>

    {# Année scolaire et classe #}
    <div class="col-md-6">
        {{ form_label(form.anneeScolaire, 'Année scolaire', {
            label_attr: {class: 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.anneeScolaire) }}
        {{ form_errors(form.anneeScolaire) }}
    </div>

    <div class="col-md-6">
        {{ form_label(form.classe, 'Classe', {
            label_attr: {class: 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.classe) }}
        {{ form_errors(form.classe) }}
    </div>

    {# Option facultative #}
    <div class="col-md-6">
        {{ form_label(form.options, 'Option', {
            label_attr: {class: 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.options) }}
        {{ form_errors(form.options) }}

        <small class="text-muted">
            Facultative, selon l'organisation de la classe.
        </small>
    </div>

</div>

{{ form_rest(form) }}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-4 pt-3 border-top">
    <a
        href="{{ path('app_configuration_bulletin_index') }}"
        class="btn btn-outline-secondary"
    >
        <i class="ti ti-arrow-left me-1"></i>
        Retour à la liste
    </a>

    <button type="submit" class="btn btn-primary">
        <i class="ti ti-device-floppy me-1"></i>
        {{ button_label|default('Enregistrer') }}
    </button>
</div>

{{ form_end(form) }}
