{% extends 'base.html.twig' %}
{% block title %}Périodes de bulletin{% endblock %}
{% block body %}
    <div class="content-page"><div class="container-fluid">
        <div class="page-title-head d-flex align-items-center mb-3"><div class="flex-grow-1"><h4 class="fs-xl fw-bold m-0">Périodes de bulletin</h4></div></div>
        <div data-table data-table-rows-per-page="8" class="card">
            <div class="card-header border-light d-flex justify-content-between align-items-center gap-2 flex-wrap">
                <div class="app-search"><input data-table-search type="search" class="form-control" placeholder="Rechercher une période..."><i data-lucide="search" class="app-search-icon text-muted"></i></div>
                <a href="{{ path('app_configuration_bulletin_new') }}" class="btn btn-primary"><i class="ti ti-plus me-1"></i>Nouvelle période</a>
            </div>
            <div class="table-responsive"><table class="table table-custom table-centered table-hover w-100 mb-0">
                <thead class="bg-light bg-opacity-25 thead-sm"><tr class="text-uppercase fs-xxs"><th>Période</th><th>École</th><th>Classe / Option</th><th>Année scolaire</th><th>Statut</th><th class="text-center">Actions</th></tr></thead>
                <tbody>{% for configuration in configuration_bulletins %}<tr>
                    <td><a class="link-reset fw-semibold" href="{{ path('app_configuration_bulletin_show', {id: configuration.id}) }}">{{ configuration.nom }}</a></td>
                    <td>{{ configuration.ecole ? configuration.ecole.nom : '—' }}</td>
                    <td>{{ configuration.classe ? configuration.classe.nom : '—' }}{% if configuration.options %}<small class="text-muted d-block">{{ configuration.options.nom }}</small>{% endif %}</td>
                    <td>{{ configuration.anneeScolaire ? configuration.anneeScolaire.libelle : '—' }}</td>
                    <td>{% set badges = {autorise: 'success', ferme: 'danger', brouillon: 'secondary'} %}<span class="badge badge-soft-{{ badges[configuration.statut]|default('secondary') }}">{{ configuration.statut|capitalize }}</span></td>
                    <td><div class="d-flex justify-content-center gap-1"><a href="{{ path('app_configuration_bulletin_show', {id: configuration.id}) }}" class="btn btn-default btn-icon btn-sm rounded-circle" title="Voir"><i class="ti ti-eye fs-lg"></i></a><a href="{{ path('app_configuration_bulletin_edit', {id: configuration.id}) }}" class="btn btn-default btn-icon btn-sm rounded-circle" title="Modifier"><i class="ti ti-edit fs-lg"></i></a></div></td>
                </tr>{% else %}<tr><td colspan="6" class="text-center py-5 text-muted">Aucune période de bulletin configurée.</td></tr>{% endfor %}</tbody>
            </table></div>
            <div class="card-footer border-0 d-flex justify-content-between"><div data-table-pagination-info></div><div data-table-pagination></div></div>
        </div>
    </div></div>
{% endblock %}
