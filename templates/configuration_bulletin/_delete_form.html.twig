

<form method="post" action="{{ path('app_configuration_bulletin_delete', {'id': configuration_bulletin.id}) }}"onsubmit="return confirm('Confirmer la suppression ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ configuration_bulletin.id) }}">
    <button class="btn btn-danger w-100">
        <i class="ti ti-trash me-1"></i>
        Supprimer
    </button>
</form>
