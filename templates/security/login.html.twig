{% extends 'security/baselogin.html.twig' %}

{% block title %}
	- Connexion
{% endblock %}

{% block stylesheets %}
	<style>
		body {
			background: linear-gradient(rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.35)), url("{{ asset('assets/images/pages/im1.jpg') }}") center / cover no-repeat fixed;
		}

		.authentication-inner {
			width: 100%;
			max-width: 450px;
		}

		.authentication-inner .card {
			border-radius: 15px;
			background: rgba(255, 255, 255, 0.95);
			box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
		}
	</style>
{% endblock %}

{% block body %}
	<div class="container-xxl">
		<div class="authentication-wrapper authentication-basic container-p-y">
			<div class="authentication-inner">
				<div class="card">
					<div
						class="card-body">
						{# <div class="app-brand justify-content-center mb-4">
												<a href="#" class="app-brand-link gap-2 d-flex align-items-center">
													<img src="{{ asset('s.jpg') }}" alt="FlexPaie Logo" style="height: 130px; margin-right: 30px; display: block;">
													<h1
														class="mb-0">
														<span class="text-center demo text-body fw-bolder">FlexPaie</span>
													</h1>
												</a>
											</div> #}

						<h2 class="mb-2 text-center">Connexion</h2>
						<p class="mb-4 text-center">Connectez-vous à votre compte</p>
						<br>

						{% if error %}
							<div class="alert alert-danger text-center" role="alert">
								Nom d'utilisateur ou mot de passe incorrect.
							</div>
						{% endif %}

						<form method="post" action="{{ path('app_login') }}">
							<div class="mb-3">

								<label for="username" class="form-label">Nom d'utilisateur</label>
								<input type="text" class="form-control" id="username" name="_username" value="{{ last_username }}" placeholder="Ex: john.jk@gmail.com " autofocus required>
							</div>
							<div class="mb-3 form-password-toggle">
								<label class="form-label" for="password">Mot de passe</label>
								<div class="input-group input-group-merge">
									<input type="password" id="password" class="form-control" name="_password" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" required>
									<span class="input-group-text cursor-pointer" id="toggle-password">
										<i class="bx bx-hide" id="password-icon"></i>
									</span>
								</div>
							</div>

							<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

							<div class="mb-3">
								<button class="btn btn-primary d-grid w-100" type="submit">
									<i class="bx bx-log-in me-1"></i>
									Se connecter
								</button>
							</div>
						</form>

						{# <p class="text-center">
																			<span>Vous n'avez pas de compte ?</span>
																			<a href="{{ path('app_user_register') }}">
																				<span>Inscrivez-vous</span>
																			</a>
																		</p> #}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	<script src="{{ asset('login/assets/js/password-toggle.js') }}"></script>
{% endblock %}
