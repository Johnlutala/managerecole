<form method="post" action="{{ path('app_section_delete', {'id': section.id}) }}" onsubmit="return confirm('Confirmer la suppression ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ section.id) }}">
    <button class="btn btn-danger w-100">
        <i class="ti ti-trash me-1"></i>
        Supprimer
    </button>
</form>



