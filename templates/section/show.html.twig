
{% extends 'base.html.twig' %}

{% block title %}Détail Section{% endblock %}

{% block body %}

    <div class="wrapper">

        <div class="content-page">

            <div class="container-fluid">

                {# ==================== TITRE ==================== #}

                <div class="page-title-head d-flex align-items-center">

                    <div class="flex-grow-1">

                        <h4 class="fs-xl fw-bold m-0">
                            Détail de la section
                        </h4>

                    </div>

                    <div class="text-end">

                        <ol class="breadcrumb m-0 py-0">

                            <li class="breadcrumb-item">
                                <a href="javascript:void(0);">
                                    ADMIN
                                </a>
                            </li>

                            <li class="breadcrumb-item">
                                <a href="{{ path('app_section_index') }}">
                                    Sections
                                </a>
                            </li>

                            <li class="breadcrumb-item active">
                                Détail
                            </li>

                        </ol>

                    </div>

                </div>


                {# ==================== CONTENU ==================== #}

                <div class="row">

                    {# ==================== INFORMATIONS RAPIDES ==================== #}

                    <div class="col-xl-3">

                        <div class="card">

                            <div class="card-header">

                                <h4 class="card-title">
                                    Section N° : {{ section.id }}
                                </h4>

                            </div>

                            <div class="card-body text-center">

                                <div class="avatar-xl mx-auto mb-3">

                                    <div class="avatar-title bg-primary-subtle text-primary rounded">

                                        <i class="ti ti-category fs-1"></i>

                                    </div>

                                </div>

                                <h4 class="mb-1">
                                    {{ section.nom }}
                                </h4>

                                <p class="text-muted mb-2">

                                    École :

                                    <strong>
                                        {{ section.ecole ? section.ecole.nom : '—' }}
                                    </strong>

                                </p>

                                <hr>

                                <div class="d-grid gap-2">

                                    <a href="{{ path('app_section_edit', {'id': section.id}) }}"
                                       class="btn btn-warning">

                                        <i class="ti ti-edit me-1"></i>
                                        Modifier

                                    </a>

                                    {% include 'section/_delete_form.html.twig' %}

                                    <a href="{{ path('app_section_index') }}"
                                       class="btn btn-secondary">

                                        <i class="ti ti-arrow-left me-1"></i>
                                        Retour

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>


                    {# ==================== INFORMATIONS SECTION ==================== #}

                    <div class="col-xl-6">

                        <div class="card h-100">

                            <div class="card-header">

                                <h4 class="card-title mb-0">

                                    Informations de la section

                                </h4>

                            </div>

                            <div class="card-body">

                                <div class="table-responsive">

                                    <table class="table table-bordered align-middle mb-0">

                                        <tbody>

                                            <tr>

                                                <th width="40%">
                                                    Nom
                                                </th>

                                                <td>
                                                    {{ section.nom }}
                                                </td>

                                            </tr>

                                            <tr>

                                                <th>
                                                    École
                                                </th>

                                                <td>

                                                    {% if section.ecole %}

                                                        <a href="{{ path('app_ecole_show', {'id': section.ecole.id}) }}">

                                                            {{ section.ecole.nom }}

                                                        </a>

                                                    {% else %}

                                                        —

                                                    {% endif %}

                                                </td>

                                            </tr>

                                            <tr>

                                                <th>
                                                    Nombre de classes
                                                </th>

                                                <td>

                                                    <span class="badge badge-soft-primary">

                                                        {{ section.classes|length }}

                                                        classe{{ section.classes|length > 1 ? 's' : '' }}

                                                    </span>

                                                </td>

                                            </tr>

                                        </tbody>

                                    </table>

                                </div>

                            </div>

                        </div>

                    </div>


                    {# ==================== CLASSES ==================== #}

                    <div class="col-xl-3 mt-1">

                        <div class="card">

                            <div class="card-header d-flex justify-content-between align-items-center">

                                <h4 class="card-title mb-0">

                                    <i class="ti ti-school me-2"></i>

                                    Classes de la section

                                </h4>

                                <span class="badge bg-primary">

                                    {{ section.classes|length }}

                                    classe{{ section.classes|length > 1 ? 's' : '' }}

                                </span>

                            </div>

                            <div class="table-responsive">

                                {% if section.classes|length > 0 %}

                                    <table class="table table-custom table-centered table-hover w-100 mb-0">

                                        <thead class="bg-light bg-opacity-25 thead-sm">

                                            <tr class="text-uppercase fs-xxs">

                                                <th>Code</th>

                                                <th>Nom</th>

                                                <th class="text-center">
                                                    Actions
                                                </th>

                                            </tr>

                                        </thead>

                                        <tbody>

                                            {% for classe in section.classes %}

                                                <tr>

                                                    <td>
                                                        {{ classe.code ?: '—' }}
                                                    </td>

                                                    <td>
                                                        {{ classe.nom }}
                                                    </td>

                                                    <td>

                                                        <div class="d-flex justify-content-center gap-1">

                                                            <a href="{{ path('app_classe_show', {'id': classe.id}) }}"
                                                               class="btn btn-default btn-icon btn-sm rounded-circle"
                                                               title="Voir">

                                                                <i class="ti ti-eye fs-lg"></i>

                                                            </a>

                                                        </div>

                                                    </td>

                                                </tr>

                                            {% endfor %}

                                        </tbody>

                                    </table>

                                {% else %}

                                    <div class="text-center py-5 text-muted">

                                        <i class="ti ti-school fs-1 d-block mb-2"></i>

                                        <p class="mb-0">

                                            Aucune classe n'est encore enregistrée pour cette section.

                                        </p>

                                    </div>

                                {% endif %}

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

{% endblock %}

