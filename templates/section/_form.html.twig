{{ form_start(form) }}

<div class="row g-3">

    {# École #}
    <div class="col-md-6">
        {{ form_row(form.ecole, {
            label: 'École',
            attr: {
                class: 'form-select'
            }
        }) }}
    </div>

    {# Nom de la section #}
    <div class="col-md-6">
        {{ form_row(form.nom, {
            label: 'Nom de la section',
            attr: {
                class: 'form-control',
                placeholder: 'Ex. Primaire'
            }
        }) }}
    </div>

</div>

<div class="mt-3">
    <button class="btn btn-primary">
        {{ button_label|default('Enregistrer') }}
    </button>
</div>

{{ form_end(form) }}