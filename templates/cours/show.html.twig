{% extends 'base.html.twig' %}{% block title %}Détail Cours{% endblock %}{% block body %}<div class="container-fluid"><div class="page-title-head d-flex justify-content-between align-items-center"><h4 class="fs-xl fw-bold m-0">Détail Cours</h4><a href="{{ path('app_cours_' ~ 'index') }}" class="btn btn-secondary"><i class="ti ti-arrow-left me-1"></i>Retour</a></div><div class="row"><div class="col-lg-3"><div class="card"><div class="card-body d-grid gap-2"><a href="{{ path('app_cours_' ~ 'edit', {id: cour.id}) }}" class="btn btn-warning">Modifier</a>{% include 'cours/_delete_form.html.twig' %}</div></div></div><div class="col-lg-9"><div class="card"><div class="table-responsive"><table class="table table-bordered align-middle mb-0"><tbody><tr><th>Code</th><td>{{ cour.code }}</td></tr><tr><th>Nom</th><td>{{ cour.nom }}</td></tr><tr><th>Description</th><td>{{ cour.description ?: '—' }}</td></tr><tr><th>Classe</th><td>{{ cour.classe ? cour.classe.nom : '—' }}</td></tr><tr><th>Professeur</th><td>{{ cour.professeur ? cour.professeur.nom ~ ' ' ~ cour.professeur.prenom : '—' }}</td></tr><tr><th>Créé le</th><td>{{ cour.createdAt ? cour.createdAt|date('d/m/Y H:i') : '—' }}</td></tr><tr><th>Créé par</th><td>{{ cour.createdBy ? cour.createdBy.firstname ~ ' ' ~ cour.createdBy.lastname : '—' }}</td></tr><tr><th>Mis à jour le</th><td>{{ cour.updatedAt ? cour.updatedAt|date('d/m/Y H:i') : '—' }}</td></tr></tbody></table></div></div></div></div></div>{% endblock %}