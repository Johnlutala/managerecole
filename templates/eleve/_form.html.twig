
{{ form_start(form) }}

{# Informations personnelles #}
<div class="row">
    <div class="col-md-6">
        {{ form_row(form.matricule) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.nom) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.postnom) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.prenom) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.sexe) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.dateNaissance) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.lieuNaissance) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.adresse) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.phone) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.email) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.dateInscription) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.statut) }}
    </div>
</div>

<hr class="my-4">

<h5 class="mb-3">Affectation scolaire</h5>

<div class="row">
    <div class="col-md-6">
        {{ form_row(form.ecole, {
            attr: {
                id: 'eleve_ecole'
            }
        }) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.section, {
            attr: {
                id: 'eleve_section'
            }
        }) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.classe, {
            attr: {
                id: 'eleve_classe'
            }
        }) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.option, {
            attr: {
                id: 'eleve_option'
            }
        }) }}
    </div>
</div>

<div class="text-end mt-4">
    <button type="submit" class="btn btn-primary">
        <i class="ti ti-device-floppy me-1"></i>
        {{ button_label|default('Enregistrer') }}
    </button>
</div>

{{ form_end(form) }}
