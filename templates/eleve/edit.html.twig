{% extends 'base.html.twig' %}

{% block title %}Modifier | Élève{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-xl-8">

                <div class="page-title-head d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h4 class="fs-xl fw-bold m-0">Mise à jour de l'élève</h4>
                    </div>

                    <div class="text-end">
                        <ol class="breadcrumb m-0 py-0">
                            <li class="breadcrumb-item">
                                <a href="javascript:void(0);">ADMIN</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="{{ path('app_eleve_index') }}">Élèves</a>
                            </li>
                            <li class="breadcrumb-item active">Modifier</li>
                        </ol>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h4 class="card-title mb-0">
                            <i class="ti ti-user-edit me-2"></i>
                            Modifier l'élève
                        </h4>

                        <a
                            href="{{ path('app_eleve_show', {'id': eleve.id}) }}"
                            class="btn btn-secondary"
                        >
                            <i class="ti ti-arrow-left me-1"></i>
                            Retour
                        </a>
                    </div>

                    <div class="card-body">
                        {{ form_start(form) }}

                        <h5 class="mb-3">Informations personnelles</h5>

                        <div class="row">
                            <div class="col-md-6">{{ form_row(form.nom) }}</div>
                            <div class="col-md-6">{{ form_row(form.postnom) }}</div>
                            <div class="col-md-6">{{ form_row(form.prenom) }}</div>
                            <div class="col-md-6">{{ form_row(form.sexe) }}</div>
                            <div class="col-md-6">{{ form_row(form.dateNaissance) }}</div>
                            <div class="col-md-6">{{ form_row(form.lieuNaissance) }}</div>
                            <div class="col-md-6">{{ form_row(form.adresse) }}</div>
                            <div class="col-md-6">{{ form_row(form.phone) }}</div>
                            <div class="col-md-6">{{ form_row(form.email) }}</div>
                            <div class="col-md-6">{{ form_row(form.dateInscription) }}</div>
                            <div class="col-md-6">{{ form_row(form.statut) }}</div>
                        </div>

                        <hr class="my-4">

                        <h5 class="mb-3">Affectation scolaire</h5>

                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.ecole, {
                                    attr: {
                                        id: 'eleve_ecole'
                                    }
                                }) }}
                            </div>

                            <div class="col-md-6">
                                {{ form_row(form.section, {
                                    attr: {
                                        id: 'eleve_section'
                                    }
                                }) }}
                            </div>

                            <div class="col-md-6">
                                {{ form_row(form.classe, {
                                    attr: {
                                        id: 'eleve_classe'
                                    }
                                }) }}
                            </div>

                            <div class="col-md-6">
                                {{ form_row(form.option, {
                                    attr: {
                                        id: 'eleve_option'
                                    }
                                }) }}
                            </div>

                            <div class="text-end mt-4">
                                <button type="submit" class="btn btn-primary">
                                    <i class="ti ti-device-floppy me-1"></i>
                                    Mettre à jour
                                </button>
                            </div>

                            {{ form_end(form) }}
                        </div>
                    </div>

                </div>
            </div>
        </div>
{% endblock %}

    {% block javascripts %}
        {{ parent() }}
        <script src="{{ asset('js/eleve-form.js') }}"></script>
    {% endblock %}
