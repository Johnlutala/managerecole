{% extends 'base.html.twig' %}{% block title %}Détail Élève{% endblock %}{% block body %}<div class="container-fluid"><div class="page-title-head d-flex justify-content-between align-items-center"><h4 class="fs-xl fw-bold m-0">Détail Élève</h4><a href="{{ path('app_eleve_' ~ 'index') }}" class="btn btn-secondary"><i class="ti ti-arrow-left me-1"></i>Retour</a></div><div class="row"><div class="col-lg-3"><div class="card"><div class="card-body d-grid gap-2"><a href="{{ path('app_eleve_' ~ 'edit', {id: eleve.id}) }}" class="btn btn-warning">Modifier</a>{% include 'eleve/_delete_form.html.twig' %}</div></div></div><div class="col-lg-9"><div class="card"><div class="table-responsive"><table class="table table-bordered align-middle mb-0"><tbody><tr><th>Matricule</th><td>{{ eleve.matricule }}</td></tr><tr><th>Nom complet</th><td>{{ eleve.nom }} {{ eleve.postnom }} {{ eleve.prenom }}</td></tr><tr><th>Sexe</th><td>{{ eleve.sexe }}</td></tr><tr><th>Date de naissance</th><td>{{ eleve.dateNaissance|date('d/m/Y') }}</td></tr><tr><th>Lieu de naissance</th><td>{{ eleve.lieuNaissance }}</td></tr><tr><th>Classe</th><td>{{ eleve.classe ? eleve.classe.nom : '—' }}</td></tr><tr><th>École</th><td>{{ eleve.ecole ? eleve.ecole.nom : '—' }}</td></tr><tr><th>Créé le</th><td>{{ eleve.createdAt ? eleve.createdAt|date('d/m/Y H:i') : '—' }}</td></tr><tr><th>Créé par</th><td>{{ eleve.createdBy ? eleve.createdBy.firstname ~ ' ' ~ eleve.createdBy.lastname : '—' }}</td></tr><tr><th>Mis à jour le</th><td>{{ eleve.updatedAt ? eleve.updatedAt|date('d/m/Y H:i') : '—' }}</td></tr></tbody></table></div></div></div></div></div>{% endblock %}