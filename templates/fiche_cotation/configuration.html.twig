{% extends 'base.html.twig' %}

{% block title %}{{ authorization_page ? 'Autorisations de cotation' : 'Maxima des cours' }}{% endblock %}

{% block body %}
    <div class="content-page">
        <div class="container-fluid">
            <div class="page-title-head d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
                <div>
                    <h4 class="fs-xl fw-bold m-0">{{ authorization_page ? 'Autorisations de cotation' : 'Maxima des cours' }}</h4>
                    <p class="text-muted mb-0 mt-1">
                        {{ authorization_page
                            ? 'Choisissez les périodes que les professeurs sont autorisés à saisir.'
                            : 'Définissez le maximum de points de chaque cours pour chaque période.' }}
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    {% if authorization_page %}
                        <a class="btn btn-primary" href="{{ path('app_fiche_cotation_config_index', query) }}">
                            <i class="ti ti-adjustments me-1"></i>Configurer les maxima des cours
                        </a>
                    {% else %}
                        <a class="btn btn-outline-primary" href="{{ path('app_fiche_cotation_config_autorisations', {structure: structure_autorisation}) }}">
                            <i class="ti ti-lock-open me-1"></i>Configurer les autorisations
                        </a>
                    {% endif %}
                    <a class="btn btn-outline-secondary" href="{{ path('app_fiche_cotation_index') }}">
                        <i class="ti ti-arrow-left me-1"></i>Retour aux fiches
                    </a>
                </div>
            </div>

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type in ['success', 'danger', 'warning', 'info'] ? type : 'info' }}" role="alert">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% if not authorization_page %}
            <div class="card mb-4" id="filtres-maxima">
                <div class="card-header"><h5 class="mb-0">Filtrer les maxima par école, section, classe et option</h5></div>
                <div class="card-body">
                    <form method="get" action="{{ path('app_fiche_cotation_config_index') }}" id="cotation-course-filters" class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label for="filter-ecole" class="form-label">École</label>
                            <select class="form-select" id="filter-ecole" name="ecole">
                                <option value="">Choisir une école</option>
                                {% for item in ecoles %}
                                    <option value="{{ item.id }}" {{ ecole and item.id == ecole.id ? 'selected' : '' }}>{{ item.nom }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="filter-section" class="form-label">Section</label>
                            <select class="form-select" id="filter-section" name="section" {{ ecole is null ? 'disabled' : '' }}>
                                <option value="">Choisir une section</option>
                                {% for item in sections %}
                                    <option value="{{ item.id }}" {{ section and item.id == section.id ? 'selected' : '' }}>{{ item.nom }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="filter-classe" class="form-label">Classe</label>
                            <select class="form-select" id="filter-classe" name="classe" {{ section is null ? 'disabled' : '' }}>
                                <option value="">Choisir une classe</option>
                                {% for item in classes %}
                                    <option value="{{ item.id }}" {{ classe and item.id == classe.id ? 'selected' : '' }}>{{ item.nom }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="filter-option" class="form-label">Option</label>
                            <select class="form-select" id="filter-option" name="option" {{ classe is null ? 'disabled' : '' }}>
                                <option value="">Toutes les options de la classe</option>
                                {% for item in options %}
                                    <option value="{{ item.id }}" {{ optionId == item.id ? 'selected' : '' }}>{{ item.nom }}</option>
                                {% endfor %}
                                {% if hasNoOption %}
                                    <option value="0" {{ optionId is same as(0) ? 'selected' : '' }}>Sans option</option>
                                {% endif %}
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="filter-annee" class="form-label">Année scolaire</label>
                            <select class="form-select" id="filter-annee" name="annee" {{ ecole is null ? 'disabled' : '' }}>
                                <option value="">Choisir une année</option>
                                {% for item in annees %}
                                    <option value="{{ item.id }}" {{ annee and item.id == annee.id ? 'selected' : '' }}>{{ item.libelle }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <input type="hidden" name="structure" value="{{ structure_autorisation }}">
                        <div class="col-12 d-flex justify-content-end">
                            <button class="btn btn-primary" type="submit" id="filter-submit">
                                <i class="ti ti-filter me-1"></i>Filtrer et afficher les cours
                            </button>
                        </div>
                    </form>
                    <div class="small text-muted mt-2" id="filter-status" aria-live="polite"></div>
                    {% if ficheConfiguration is null and ecole %}
                        <div class="alert alert-warning mt-3 mb-0">
                            Le modèle de fiche n’est pas encore défini pour cette école.
                            <a href="{{ path('app_fiche_cotation_index') }}">Configurer d’abord son modèle.</a>
                        </div>
                    {% endif %}
                </div>
            </div>

            {% if classe and ficheConfiguration %}
                {% if cours is empty %}
                    <div class="alert alert-info">
                        Aucun cours n’est attribué à {{ option ? 'cette classe et cette option' : 'cette classe' }}.
                    </div>
                {% else %}
                    {% if not periodsConfigured %}
                        <div class="alert alert-info">
                            Les configurations de périodes manquantes seront créées automatiquement avec les maxima que vous enregistrerez.
                        </div>
                    {% endif %}
                    <form method="post" action="{{ path('app_fiche_cotation_config_index', query) }}" class="card mb-4" id="maxima-cours">
                        <input type="hidden" name="_token" value="{{ csrf_token('configuration_maxima_cotation') }}">
                        <input type="hidden" name="action" value="save_course_maxima">
                        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <h5 class="mb-1">Maxima par cours — {{ classe.nom }}{% if option %} · {{ option.nom }}{% endif %}</h5>
                                <span class="text-muted small">{{ ecole.nom }} · {{ annee.libelle }}</span>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i>Enregistrer les maxima
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th rowspan="2">Cours</th>
                                        {% for groupe in groupes %}
                                            <th class="text-center" colspan="{{ groupe.periodes|length + 1 }}">{{ groupe.nom }}</th>
                                        {% endfor %}
                                    </tr>
                                    <tr>
                                        {% for groupe in groupes %}
                                            {% for periode in groupe.periodes %}
                                                <th class="text-center">{{ periode.libelle }}</th>
                                            {% endfor %}
                                            <th class="text-center">{{ groupe.total }}</th>
                                        {% endfor %}
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for ligne in matrice_cours %}
                                        <tr>
                                            <th>{{ ligne.cours.nom }}</th>
                                            {% for groupe in groupes %}
                                                {% for periode in groupe.periodes %}
                                                    {% set evaluations = ligne.evaluations[groupe.configuration][periode.nom]|default([]) %}
                                                    <td class="text-center" style="min-width: 100px">
                                                        {% if evaluations|length > 1 %}
                                                            {% set total = 0 %}
                                                            {% for evaluation in evaluations %}{% set total = total + evaluation.bareme %}{% endfor %}
                                                            <span class="badge bg-warning text-dark">Doublon · max {{ total }}</span>
                                                        {% elseif evaluations|length == 1 %}
                                                            <input class="form-control form-control-sm text-center" type="number" min="1" max="1000"
                                                                   name="baremes[{{ ligne.cours.id }}][{{ groupe.configuration }}][{{ periode.nom }}]"
                                                                   value="{{ evaluations[0].bareme }}" aria-label="Maximum {{ ligne.cours.nom }} {{ periode.libelle }}">
                                                        {% else %}
                                                            <input class="form-control form-control-sm text-center" type="number" min="1" max="1000"
                                                                   name="baremes[{{ ligne.cours.id }}][{{ groupe.configuration }}][{{ periode.nom }}]"
                                                                   placeholder="Max." aria-label="Maximum {{ ligne.cours.nom }} {{ periode.libelle }}">
                                                        {% endif %}
                                                    </td>
                                                {% endfor %}
                                                <td class="text-center fw-semibold">{{ ligne.totaux[groupe.configuration]|default('—') }}</td>
                                            {% endfor %}
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer text-muted small">
                            Les valeurs sont enregistrées comme barèmes de la période. Les doublons historiques restent verrouillés pour éviter de modifier des notes déjà saisies.
                        </div>
                    </form>
                {% endif %}
            {% endif %}
            {% endif %}

            {% if authorization_page %}
            <div class="card" id="autorisations">
                <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div>
                        <h5 class="mb-1">Autorisations de saisie des professeurs</h5>
                        <p class="small text-muted mb-0">Ces autorisations sont globales pour toutes les écoles utilisant la même structure.</p>
                    </div>
                    <form method="get" action="{{ path('app_fiche_cotation_config_autorisations') }}" class="d-flex align-items-center gap-2">
                        {% for key, value in query %}{% if value is not null %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endif %}{% endfor %}
                        <label for="authorization-structure" class="form-label mb-0">Structure</label>
                        <select id="authorization-structure" class="form-select" name="structure" onchange="this.form.submit()">
                            <option value="semestre" {{ structure_autorisation == 'semestre' ? 'selected' : '' }}>Semestrielle</option>
                            <option value="trimestre" {{ structure_autorisation == 'trimestre' ? 'selected' : '' }}>Trimestrielle</option>
                        </select>
                    </form>
                </div>
                <div class="card-body pb-0">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Progression des autorisations</span>
                        <span>{{ nombre_periodes_autorisees }} / {{ nombre_periodes_autorisation }} période(s)</span>
                    </div>
                    <div class="progress" role="progressbar" aria-valuenow="{{ nombre_periodes_autorisation ? (nombre_periodes_autorisees * 100 / nombre_periodes_autorisation)|round : 0 }}" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: {{ nombre_periodes_autorisation ? (nombre_periodes_autorisees * 100 / nombre_periodes_autorisation)|round : 0 }}%"></div>
                    </div>
                </div>
                <form method="post" action="{{ path('app_fiche_cotation_config_autorisations', {structure: structure_autorisation}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('autorisation_cotation_' ~ structure_autorisation) }}">
                    <input type="hidden" name="action" value="save_authorisations">
                    <input type="hidden" name="structure" value="{{ structure_autorisation }}">
                    <input type="hidden" name="ecole" value="{{ ecole ? ecole.id : '' }}">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle text-center mb-0">
                            <thead class="table-light">
                                <tr>{% for groupe in groupes_autorisation %}<th colspan="{{ groupe.periodes|length }}">{{ groupe.nom }}</th>{% endfor %}</tr>
                                <tr>{% for groupe in groupes_autorisation %}{% for periode in groupe.periodes %}<th>{{ periode.libelle }}</th>{% endfor %}{% endfor %}</tr>
                            </thead>
                            <tbody>
                                <tr>
                                    {% for groupe in groupes_autorisation %}
                                        {% for periode in groupe.periodes %}
                                            <td>
                                                <label class="form-check d-inline-flex justify-content-center mb-0">
                                                    <input class="form-check-input" type="checkbox" name="autorisations[{{ periode.nom }}]" value="1"
                                                           {{ autorisations[periode.nom]|default(false) ? 'checked' : '' }}
                                                           aria-label="Autoriser {{ periode.libelle }}">
                                                </label>
                                            </td>
                                        {% endfor %}
                                    {% endfor %}
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer text-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-lock-open me-1"></i>Enregistrer les autorisations
                        </button>
                    </div>
                </form>
            </div>
            {% endif %}
        </div>
    </div>

    <script>
        (() => {
            const form = document.getElementById('cotation-course-filters');
            if (!form) return;
            const school = document.getElementById('filter-ecole');
            const section = document.getElementById('filter-section');
            const classSelect = document.getElementById('filter-classe');
            const option = document.getElementById('filter-option');
            const status = document.getElementById('filter-status');
            const submitButton = document.getElementById('filter-submit');
            const clearAndDisable = (select, placeholder) => {
                select.replaceChildren(new Option(placeholder, ''));
                select.value = '';
                select.disabled = true;
            };
            const loadNextFilter = () => {
                status.textContent = 'Chargement des filtres...';
                form.requestSubmit();
            };
            form.addEventListener('submit', () => {
                submitButton.disabled = true;
                submitButton.textContent = 'Chargement...';
                status.textContent = 'Chargement des cours et des périodes...';
            });
            school?.addEventListener('change', () => {
                clearAndDisable(section, 'Choisir une section');
                clearAndDisable(classSelect, 'Choisir une classe');
                clearAndDisable(option, 'Toutes les options de la classe');
                loadNextFilter();
            });
            section?.addEventListener('change', () => {
                clearAndDisable(classSelect, 'Choisir une classe');
                clearAndDisable(option, 'Toutes les options de la classe');
                loadNextFilter();
            });
            classSelect?.addEventListener('change', () => {
                clearAndDisable(option, 'Toutes les options de la classe');
                loadNextFilter();
            });
        })();
    </script>
{% endblock %}
