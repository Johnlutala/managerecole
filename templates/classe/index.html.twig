{% extends 'base.html.twig' %}

{% block title %}Classes{% endblock %}

{% block body %}

    <div class="wrapper">
        <div class="content-page">
            <div class="container-fluid">
               
                <div class="page-title-head d-flex align-items-center">

                    <div class="flex-grow-1">
                        <h4 class="fs-xl fw-bold m-0">
                            Classes
                        </h4>
                    </div>

                </div>
                {% for message in app.flashes('success') %}

                    <div class="d-flex justify-content-center">

                        <div
                            class="alert alert-success alert-dismissible fade show"
                            role="alert"
                            style="width: 500px;"
                        >
                            {{ message }}

                            <button
                                type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                aria-label="Fermer"
                            ></button>

                        </div>

                    </div>

                {% endfor %}
                <div data-table data-table-rows-per-page="8" class="card" >
                    <div class="card-header border-light">

                        <div class="row align-items-center g-2">

                            {# Recherche #}

                            <div class="col-md-4">
                                <div class="app-search">
                                    <input data-table-search type="search" class="form-control" placeholder="Rechercher..." >
                                    <i
                                        data-lucide="search"
                                        class="app-search-icon text-muted"
                                    ></i>
                                </div>

                            </div>


                            {# Sélection école #}

                            <div class="col-md-5">

                                <div class="d-flex align-items-center gap-2">

                                    <label
                                        for="classe-filter-ecole"
                                        class="form-label mb-0 text-nowrap"
                                    >
                                        École
                                    </label>

                                    <select
                                        id="classe-filter-ecole"
                                        class="form-select"
                                    >

                                        {% for ecole in ecoles %}

                                            <option
                                                value="{{ ecole.id }}"
                                                {% if classe.ecole and classe.ecole.id == ecole.id %}
                                                selected
                                                {% endif %}
                                            >
                                                {{ ecole.nom }}
                                            </option>

                                        {% endfor %}

                                    </select>

                                </div>

                            </div>


                            {# Bouton Ajouter #}

                            <div class="col-md-3 text-md-end">

                                <button
                                    type="button"
                                    class="btn btn-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#addModal"
                                >
                                    <i class="ti ti-plus me-1"></i>
                                    Ajouter
                                </button>

                            </div>

                        </div>

                    </div>


                    {# --------------------------------------------------------
                       TABLE
                    --------------------------------------------------------- #}

                    <div class="table-responsive">

                        <table
                            class="table table-custom table-centered table-hover w-100 mb-0"
                        >

                            <thead class="bg-light bg-opacity-25 thead-sm">

                                <tr class="text-uppercase fs-xxs">

                                    <th>Code</th>

                                    <th>Nom</th>

                                    <th>Section</th>

                                    <th>École</th>

                                    <th>Capacité</th>

                                    <th class="text-center">
                                        Actions
                                    </th>

                                </tr>

                            </thead>


                            <tbody id="classes-table-body">

                                {% for classeItem in classes %}

                                    <tr
                                        data-ecole-id="{{ classeItem.ecole ? classeItem.ecole.id : '' }}"
                                    >

                                        <td>
                                            {{ classeItem.code }}
                                        </td>

                                        <td>
                                            {{ classeItem.nom }}
                                        </td>

                                        <td>
                                            {{ classeItem.section
                                                ? classeItem.section.nom
                                                : '—'
                                            }}
                                        </td>

                                        <td>
                                            {{ classeItem.ecole
                                                ? classeItem.ecole.nom
                                                : '—'
                                            }}
                                        </td>

                                        <td>
                                            {{ classeItem.capacite ?: '—' }}
                                        </td>

                                        <td>

                                            <div class="d-flex justify-content-center gap-1">

                                                <a
                                                    href="{{ path('app_classe_show', {id: classeItem.id}) }}"
                                                    class="btn btn-default btn-icon btn-sm rounded-circle"
                                                >
                                                    <i class="ti ti-eye fs-lg"></i>
                                                </a>

                                                <a
                                                    href="{{ path('app_classe_edit', {id: classeItem.id}) }}"
                                                    class="btn btn-default btn-icon btn-sm rounded-circle"
                                                >
                                                    <i class="ti ti-edit fs-lg"></i>
                                                </a>

                                            </div>

                                        </td>

                                    </tr>

                                {% else %}

                                    <tr id="no-class-row">

                                        <td
                                            colspan="6"
                                            class="text-center py-5 text-muted"
                                        >
                                            Aucune classe trouvée.
                                        </td>

                                    </tr>

                                {% endfor %}

                            </tbody>

                        </table>

                    </div>


                    {# --------------------------------------------------------
                       PAGINATION
                    --------------------------------------------------------- #}

                    <div class="card-footer border-0 d-flex justify-content-between">

                        <div data-table-pagination-info></div>

                        <div data-table-pagination></div>

                    </div>

                </div>

            </div>
        </div>
    </div>


    {# ================================================================
       MODAL AJOUT CLASSE
    ================================================================ #}

    <div
        class="modal fade"
        id="addModal"
        tabindex="-1"
    >

        <div class="modal-dialog modal-xl">

            <div class="modal-content">

                {{ form_start(form) }}


                {# ------------------------------------------------------------
                   HEADER
                ------------------------------------------------------------- #}

                <div class="modal-header">

                    <div>

                        <h5 class="modal-title">

                            <i class="ti ti-school me-2 text-primary"></i>

                            Ajouter une classe

                        </h5>

                        <small class="text-muted">
                            Ajouter une nouvelle classe
                        </small>

                    </div>


                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fermer"
                    ></button>

                </div>


                {# ------------------------------------------------------------
                   BODY
                ------------------------------------------------------------- #}

                <div class="modal-body">

                    <div class="row g-3">


                        {# ====================================================
                           FORMULAIRE
                        ==================================================== #}

                        <div class="col-lg-8">

                            <div class="row g-3">


                                {# École #}

                                <div class="col-md-6">

                                    {{ form_row(form.ecole, {
                                        label: 'École',
                                        attr: {
                                            class: 'form-select'
                                        }
                                    }) }}

                                </div>


                                {# Section #}

                                <div class="col-md-6">

                                    {{ form_row(form.section, {
                                        label: 'Section',
                                        attr: {
                                            class: 'form-select'
                                        }
                                    }) }}

                                </div>


                                {# Nom #}

                                <div class="col-md-6">

                                    {{ form_row(form.nom, {
                                        label: 'Nom de la classe',
                                        attr: {
                                            class: 'form-control',
                                            placeholder: 'Ex. 4e Primaire'
                                        }
                                    }) }}

                                </div>


                                {# Capacité #}

                                <div class="col-md-6">

                                    {{ form_row(form.capacite, {
                                        label: 'Capacité',
                                        attr: {
                                            class: 'form-control',
                                            placeholder: 'Ex. 40'
                                        }
                                    }) }}

                                </div>

                            </div>

                        </div>


                        {# ====================================================
                           CLASSES EXISTANTES
                        ==================================================== #}

                        <div class="col-lg-4">

                            <div
                                id="classesCard"
                                class="card border shadow-none"
                                style="display: none;"
                            >

                                <div class="card-header bg-light">

                                    <h5 class="mb-0 fs-md">

                                        <i class="ti ti-list-check me-1"></i>

                                        Classes existantes

                                    </h5>

                                </div>


                                <div class="card-body">


                                    {# Chargement #}

                                    <div
                                        id="classesLoading"
                                        class="text-center py-3"
                                        style="display: none;"
                                    >

                                        <div
                                            class="spinner-border spinner-border-sm text-primary"
                                            role="status"
                                        ></div>

                                        <span class="ms-2 text-muted">
                                            Chargement...
                                        </span>

                                    </div>


                                    {# Aucune classe #}

                                    <div
                                        id="noClasses"
                                        class="text-center text-muted py-3"
                                        style="display: none;"
                                    >

                                        <i
                                            class="ti ti-info-circle fs-2 d-block mb-2"
                                        ></i>

                                        <span>
                                            Aucune classe n'est encore
                                            associée à cette section.
                                        </span>

                                    </div>


                                    {# Liste #}

                                    <div id="classesList"></div>


                                    {# Doublon #}

                                    <div
                                        id="classeDuplicateMessage"
                                        class="alert alert-warning mt-3 mb-0"
                                        style="display: none;"
                                    >

                                        <i class="ti ti-alert-triangle me-1"></i>

                                        Cette classe existe déjà
                                        dans cette section.

                                    </div>

                                </div>

                            </div>


                            {# Message initial #}

                            <div
                                id="selectSectionMessage"
                                class="text-center text-muted py-5"
                            >

                                <i
                                    class="ti ti-school fs-1 d-block mb-2"
                                ></i>

                                <span>
                                    Sélectionnez une section pour voir
                                    les classes disponibles.
                                </span>

                            </div>

                        </div>

                    </div>

                </div>


                {# ------------------------------------------------------------
                   FOOTER
                ------------------------------------------------------------- #}

                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal"
                    >
                        Annuler
                    </button>


                    <button
                        type="submit"
                        class="btn btn-primary"
                        id="saveClasseButton"
                    >

                        <i class="ti ti-device-floppy me-1"></i>

                        Enregistrer

                    </button>

                </div>


                {{ form_end(form) }}

            </div>

        </div>

    </div>


    {# ================================================================
       DONNEES DES CLASSES POUR JAVASCRIPT
    ================================================================ #}

    <script
        type="application/json"
        id="classes-data"
    >
        [
            {% for classeItem in classes %}
                {
                    "id": {{ classeItem.id }},
                    "nom": {{ classeItem.nom|json_encode|raw }},
                    "ecole": {{ classeItem.ecole ? classeItem.ecole.id : 'null' }},
                    "section": {{ classeItem.section ? classeItem.section.id : 'null' }}
                }{% if not loop.last %},{% endif %}
            {% endfor %}
        ]
    </script>


    {# ================================================================
       JAVASCRIPT
    ================================================================ #}

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            /* ============================================================
                       ELEMENTS
                    ============================================================ */

            const ecoleFilter = document.querySelector("#classe-filter-ecole");

            const ecoleForm = document.querySelector("#classe_ecole");

            const sectionSelect = document.querySelector("#classe_section");

            const nomInput = document.querySelector("#classe_nom");

            const classesCard = document.querySelector("#classesCard");

            const classesList = document.querySelector("#classesList");

            const noClasses = document.querySelector("#noClasses");

            const selectSectionMessage = document.querySelector(
                "#selectSectionMessage",
            );

            const duplicateMessage = document.querySelector("#classeDuplicateMessage");

            const saveButton = document.querySelector("#saveClasseButton");

            const classesDataElement = document.querySelector("#classes-data");

            if (!classesDataElement) {
                return;
            }

            const classesData = JSON.parse(classesDataElement.textContent);

            /* ============================================================
                       ECOLE DU FORMULAIRE
                    ============================================================ */

            if (ecoleForm) {
                /*
                 * Le select du formulaire doit toujours commencer
                 * avec la même école que le select du haut.
                 */

                if (ecoleFilter && ecoleFilter.value) {
                    ecoleForm.value = ecoleFilter.value;
                }
            }

            /* ============================================================
                       FILTRER LE TABLEAU PAR ECOLE
                    ============================================================ */

            function filtrerTableau() {
                if (!ecoleFilter) {
                    return;
                }

                const ecoleId = ecoleFilter.value;

                const rows = document.querySelectorAll(
                    "#classes-table-body tr[data-ecole-id]",
                );

                let nombreVisible = 0;

                rows.forEach(function (row) {
                    const rowEcoleId = row.dataset.ecoleId;

                    if (!ecoleId || String(rowEcoleId) === String(ecoleId)) {
                        row.style.display = "";

                        nombreVisible++;
                    } else {
                        row.style.display = "none";
                    }
                });

                /*
                 * On laisse le système data-table gérer sa pagination.
                 * Ici on masque simplement les classes des autres écoles.
                 */
            }

            /* ============================================================
                       CHANGEMENT ECOLE DU HAUT
                    ============================================================ */

            if (ecoleFilter) {
                ecoleFilter.addEventListener("change", function () {
                    const ecoleId = this.value;

                    /* Synchroniser le formulaire */

                    if (ecoleForm) {
                        ecoleForm.value = ecoleId;

                        ecoleForm.dispatchEvent(new Event("change"));
                    }

                    /* Filtrer le tableau */

                    filtrerTableau();
                });
            }

            /* ============================================================
                       SECTION DESACTIVEE AU DEPART
                    ============================================================ */

            if (sectionSelect) {
                sectionSelect.disabled = true;
            }

            /* ============================================================
                       CHANGEMENT ECOLE DANS LE FORMULAIRE
                    ============================================================ */

            if (ecoleForm) {
                ecoleForm.addEventListener("change", function () {
                    const ecoleId = this.value;

                    /*
                     * Réinitialiser la section
                     */

                    if (sectionSelect) {
                        sectionSelect.value = "";
                    }

                    /*
                     * Aucune école
                     */

                    if (!ecoleId) {
                        if (sectionSelect) {
                            sectionSelect.disabled = true;
                        }

                        cacherClasses();

                        return;
                    }

                    /*
                     * Activer la section
                     */

                    if (sectionSelect) {
                        sectionSelect.disabled = false;

                        /*
                         * Filtrer les sections
                         */

                        Array.from(sectionSelect.options).forEach(function (option) {
                            if (option.value === "") {
                                option.hidden = false;

                                return;
                            }

                            option.hidden = option.dataset.ecole !== ecoleId;
                        });
                    }

                    cacherClasses();
                });
            }

            /* ============================================================
                       CHANGEMENT SECTION
                    ============================================================ */

            if (sectionSelect) {
                sectionSelect.addEventListener("change", function () {
                    afficherClasses();
                });
            }

            /* ============================================================
                       SAISIE NOM
                    ============================================================ */

            if (nomInput) {
                nomInput.addEventListener("input", function () {
                    verifierDoublon();
                });
            }

            /* ============================================================
                       AFFICHER LES CLASSES
                    ============================================================ */

            function afficherClasses() {
                if (!ecoleForm || !sectionSelect) {
                    return;
                }

                const ecoleId = ecoleForm.value;

                const sectionId = sectionSelect.value;

                classesList.innerHTML = "";

                duplicateMessage.style.display = "none";

                if (!ecoleId || !sectionId) {
                    cacherClasses();

                    return;
                }

                selectSectionMessage.style.display = "none";

                classesCard.style.display = "block";

                const classesFiltrees = classesData.filter(function (classe) {
                    return (
                        String(classe.ecole) === String(ecoleId) &&
                        String(classe.section) === String(sectionId)
                    );
                });

                if (classesFiltrees.length === 0) {
                    noClasses.style.display = "block";

                    return;
                }

                noClasses.style.display = "none";

                classesFiltrees.forEach(function (classe) {
                    const item = document.createElement("div");

                    item.className =
                        "d-flex justify-content-between align-items-center border-bottom py-2";

                    item.innerHTML = `

                            <div>

                                <i class="ti ti-school me-1 text-primary"></i>

                                ${classe.nom}

                            </div>

                            <span class="badge bg-light text-dark">

                                Existe

                            </span>

                        `;

                    classesList.appendChild(item);
                });

                verifierDoublon();
            }

            /* ============================================================
                       CACHER LES CLASSES
                    ============================================================ */

            function cacherClasses() {
                if (classesCard) {
                    classesCard.style.display = "none";
                }

                if (selectSectionMessage) {
                    selectSectionMessage.style.display = "block";
                }

                if (classesList) {
                    classesList.innerHTML = "";
                }

                if (noClasses) {
                    noClasses.style.display = "none";
                }

                if (duplicateMessage) {
                    duplicateMessage.style.display = "none";
                }

                if (saveButton) {
                    saveButton.disabled = false;
                }
            }

            /* ============================================================
                       VERIFIER DOUBLON
                    ============================================================ */

            function verifierDoublon() {
                if (!ecoleForm || !sectionSelect || !nomInput) {
                    return;
                }

                const ecoleId = ecoleForm.value;

                const sectionId = sectionSelect.value;

                const nom = nomInput.value.trim().toLowerCase();

                if (!ecoleId || !sectionId || !nom) {
                    duplicateMessage.style.display = "none";

                    if (saveButton) {
                        saveButton.disabled = false;
                    }

                    return;
                }

                const existe = classesData.some(function (classe) {
                    return (
                        String(classe.ecole) === String(ecoleId) &&
                        String(classe.section) === String(sectionId) &&
                        classe.nom.trim().toLowerCase() === nom
                    );
                });

                if (existe) {
                    duplicateMessage.style.display = "block";

                    if (saveButton) {
                        saveButton.disabled = true;
                    }
                } else {
                    duplicateMessage.style.display = "none";

                    if (saveButton) {
                        saveButton.disabled = false;
                    }
                }
            }

            /* ============================================================
                       INITIALISATION AUTOMATIQUE
                    ============================================================ */

            /*
             * Le contrôleur sélectionne déjà la première école
             * dans $classe->setEcole($ecoles[0]).
             *
             * On récupère cette valeur et on synchronise les deux selects.
             */

            if (ecoleFilter && ecoleFilter.value && ecoleForm) {
                ecoleForm.value = ecoleFilter.value;

                /*
                 * Déclencher le filtrage des sections
                 */

                ecoleForm.dispatchEvent(new Event("change"));
            }

            /*
             * Filtrer le tableau dès le chargement.
             */

            filtrerTableau();
        });
    </script>

{% endblock %}
