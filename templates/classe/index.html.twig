{% extends 'base.html.twig' %}
{% block title %}Classes
{% endblock %}
{% block body %}
    <div class="wrapper">
        <div class="content-page">
            <div class="container-fluid">
                <div class="page-title-head d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h4 class="fs-xl fw-bold m-0">Classes</h4>
                    </div>
                </div>
                <div data-table data-table-rows-per-page="8" class="card">
                    <div class="card-header border-light d-flex justify-content-between">
                        <div class="app-search"><input data-table-search type="search" class="form-control" placeholder="Rechercher..."><i data-lucide="search" class="app-search-icon text-muted"></i>
                        </div>
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
                            <i class="ti ti-plus me-1"></i>Ajouter</button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-custom table-centered table-hover w-100 mb-0">
                            <thead class="bg-light bg-opacity-25 thead-sm">
                                <tr class="text-uppercase fs-xxs">
                                    <th>Code</th>
                                    <th>Nom</th>
                                    <th>Secion</th>
                                    <th>École</th>
                                    <th>Capacité</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for classe in classes %}
                                    <tr>
                                        <td>{{ classe.code }}</td>
                                        <td>{{ classe.nom }}</td>
                                        <td>{{ classe.ecole ? classe.section.nom : '—' }}</td>
                                        <td>{{ classe.ecole ? classe.ecole.nom : '—' }}</td>
                                        <td>{{ classe.capacite ?: '—' }}</td>
                                        <td>
                                            <div class="d-flex justify-content-center gap-1">
                                                <a href="{{ path('app_classe_show', {id: classe.id}) }}" class="btn btn-default btn-icon btn-sm rounded-circle">
                                                    <i class="ti ti-eye fs-lg"></i>
                                                </a>
                                                <a href="{{ path('app_classe_edit', {id: classe.id}) }}" class="btn btn-default btn-icon btn-sm rounded-circle">
                                                    <i class="ti ti-edit fs-lg"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="10" class="text-center py-5 text-muted">Aucun enregistrement trouvé.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer border-0 d-flex justify-content-between">
                        <div data-table-pagination-info></div>
                        <div data-table-pagination></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">

                {{ form_start(form) }}

                <div class="modal-header">
                    <div>
                        <h5 class="modal-title fw-bold" id="addModalLabel">
                            <i class="ti ti-school me-2 text-primary"></i>
                            Nouvelle classe
                        </h5>
                        <small class="text-muted">
                            Ajouter une nouvelle classe
                        </small>
                    </div>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fermer"
                    ></button>
                </div>

                <div class="modal-body">
                    
                    <div class="row g-3">

                        <div class="col-6">
                            {{ form_row(form.ecole, {
                                label: 'École',
                                attr: {
                                    class: 'form-select'
                                }
                            }) }}
                        </div>

                        <div class="col-6">
                            {{ form_row(form.section, {
                                label: 'Section',
                                attr: {
                                    class: 'form-select'
                                }
                            }) }}
                        </div>

                        <div class="col-6">
                            {{ form_row(form.nom, {
                                label: 'Nom de la classe',
                                attr: {
                                    class: 'form-control',
                                    placeholder: 'Ex. 4e Primaire'
                                }
                            }) }}
                        </div>

                        <div class="col-6">
                            {{ form_row(form.capacite, {
                                label: 'Capacité',
                                attr: {
                                    class: 'form-control',
                                    placeholder: 'Ex. 40'
                                }
                            }) }}
                        </div>

                    </div>
                 

                </div>

                <div class="modal-footer">
                    <button
                        type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal"
                    >
                        Annuler
                    </button>

                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-1"></i>
                        Enregistrer
                    </button>
                </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ecoleSelect = document.querySelector("#classe_ecole");
            const sectionSelect = document.querySelector("#classe_section");

            if (!ecoleSelect || !sectionSelect) {
                return;
            }

            // Au démarrage : section désactivée
            sectionSelect.disabled = true;

            ecoleSelect.addEventListener("change", function () {
                const ecoleId = this.value;

                // Aucune école sélectionnée
                if (!ecoleId) {
                    sectionSelect.disabled = true;
                    sectionSelect.value = "";
                    return;
                }

                // Activer la section
                sectionSelect.disabled = false;

                // Filtrer les sections
                Array.from(sectionSelect.options).forEach(function (option) {
                    if (option.value === "") {
                        option.hidden = false;
                        return;
                    }

                    option.hidden = option.dataset.ecole !== ecoleId;
                });

                // Réinitialiser la sélection
                sectionSelect.value = "";
            });
        });
    </script>
{% endblock %}
