{{ form_start(form) }}

<div class="row g-3">

    <div class="col-6">
        {{ form_row(form.ecole, {
            label: 'Sélectionnez une école',
            attr: {
                class: 'form-select',
                id: 'ecole'
            }
        }) }}
    </div>

    <div class="col-6">
        {{ form_row(form.section, {
            label: 'Sélectionnez une section',
            attr: {
                class: 'form-select',
                id: 'section'
            }
        }) }}
    </div>

    <div class="col-6">
        {{ form_row(form.nom, {
            label: 'Nom de la classe',
            attr: {
                class: 'form-control',
                placeholder: 'Ex. 4e Primaire'
            }
        }) }}
    </div>

    <div class="col-6">
        {{ form_row(form.capacite, {
            label: 'Capacité',
            attr: {
                class: 'form-control',
                placeholder: 'Ex. 40'
            }
        }) }}
    </div>

</div>

<div class="text-end mt-4">
    <button type="submit" class="btn btn-primary">
        <i class="ti ti-device-floppy me-1"></i>
        {{ button_label|default('Enregistrer') }}
    </button>
</div>

{{ form_end(form) }}