
{% extends 'base.html.twig' %}

{% block title %}Préparations de cours{% endblock %}

{% block body %}
<style>
    .prep-page {
        --prep-primary: #253b60;
        --prep-muted: #718096;
        --prep-border: #e8edf3;
        --prep-bg: #f7f9fc;
    }

    .prep-page .page-heading {
        margin-bottom: 28px;
    }

    .prep-page .page-heading h2 {
        color: var(--prep-primary);
        font-weight: 700;
        font-size: 23px;
    }

    .prep-page .page-heading p {
        color: var(--prep-muted);
        font-size: 13px;
    }

    .prep-page .course-card,
    .prep-page .submission-card {
        border: 1px solid var(--prep-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 3px 12px rgba(31, 45, 61, .035);
        overflow: hidden;
        transition: box-shadow .2s ease, transform .2s ease;
    }

    .prep-page .course-card:hover,
    .prep-page .submission-card:hover {
        box-shadow: 0 7px 22px rgba(31, 45, 61, .075);
    }

    .prep-page .course-header {
        padding: 20px 22px;
        background: #fff;
        border-bottom: 1px solid var(--prep-border);
    }

    .prep-page .course-icon,
    .prep-page .teacher-avatar {
        width: 46px;
        height: 46px;
        min-width: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #edf3fc;
        color: #3568a8;
        font-size: 20px;
    }

    .prep-page .course-title {
        color: var(--prep-primary);
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .prep-page .course-meta {
        color: var(--prep-muted);
        font-size: 12px;
    }

    .prep-page .schedule-area {
        padding: 12px 22px;
        background: #fafbfd;
        border-bottom: 1px solid var(--prep-border);
    }

    .prep-page .schedule-label {
        font-size: 11px;
        font-weight: 700;
        color: #8793a4;
        text-transform: uppercase;
        margin-right: 8px;
    }

    .prep-page .schedule-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 9px;
        margin: 3px 4px 3px 0;
        border-radius: 6px;
        background: #edf2f8;
        color: #425875;
        font-size: 11px;
        font-weight: 600;
    }

    .prep-page .history-section {
        padding: 18px 22px 22px;
    }

    .prep-page .history-title {
        font-size: 13px;
        font-weight: 700;
        color: #475569;
        margin-bottom: 14px;
    }

    .prep-page .preparation-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 13px 15px;
        border: 1px solid #edf0f4;
        border-radius: 9px;
        margin-bottom: 9px;
        background: #fff;
        transition: background .2s ease;
    }

    .prep-page .preparation-item:hover {
        background: #fafbfd;
    }

    .prep-page .prep-number {
        width: 39px;
        height: 39px;
        min-width: 39px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #edf3fc;
        color: #3568a8;
        font-size: 13px;
        font-weight: 700;
    }

    .prep-page .prep-subject {
        color: #334155;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .prep-page .prep-date {
        color: #8a96a6;
        font-size: 11px;
    }

    .prep-page .status-badge {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .prep-page .status-brouillon {
        background: #edf0f3;
        color: #64748b;
    }

    .prep-page .status-soumise {
        background: #e7f1ff;
        color: #2863a6;
    }

    .prep-page .status-validee {
        background: #e5f6ed;
        color: #218653;
    }

    .prep-page .status-a_corriger {
        background: #fff3dc;
        color: #b7791f;
    }

    .prep-page .empty-history {
        text-align: center;
        padding: 25px 15px;
        background: #fafbfd;
        border: 1px dashed #dce3eb;
        border-radius: 9px;
    }

    .prep-page .empty-history i {
        font-size: 27px;
        color: #a5b2c2;
        margin-bottom: 8px;
    }

    .prep-page .empty-history p {
        color: #8793a4;
        font-size: 12px;
        margin-bottom: 0;
    }

    .prep-page .submission-card {
        padding: 20px;
        height: 100%;
    }

    .prep-page .submission-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 15px;
        border-bottom: 1px solid var(--prep-border);
    }

    .prep-page .submission-info {
        padding: 15px 0;
    }

    .prep-page .info-label {
        color: #94a0ae;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .prep-page .info-value {
        color: #334155;
        font-size: 13px;
        font-weight: 600;
    }

    .prep-page .review-area {
        padding-top: 15px;
        border-top: 1px solid var(--prep-border);
    }

    .prep-page .review-area textarea {
        font-size: 12px;
        resize: vertical;
        border-color: #e2e8f0;
    }

    .prep-page .section-label {
        color: #8793a4;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .6px;
        text-transform: uppercase;
        margin-bottom: 15px;
    }

    .prep-page .btn-primary {
        background: var(--prep-primary);
        border-color: var(--prep-primary);
    }

    .prep-page .btn-primary:hover {
        background: #1c2d49;
        border-color: #1c2d49;
    }

    @media(max-width: 767px) {
        .prep-page .course-header {
            padding: 16px;
        }

        .prep-page .history-section {
            padding: 15px;
        }

        .prep-page .preparation-item {
            flex-wrap: wrap;
        }

        .prep-page .prep-actions {
            width: 100%;
            justify-content: flex-end;
        }
    }
</style>

<div class="wrapper">
    <div class="content-page">
        <div class="container-fluid py-4 prep-page">

            {# EN-TÊTE #}
            <div class="page-heading d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="text-primary">
                            <i class="fas fa-chalkboard-teacher"></i>
                        </span>
                        <small class="text-muted fw-semibold text-uppercase">
                            Espace pédagogique
                        </small>
                    </div>

                    <h2 class="mb-1">
                        {{ direction ? 'Préparations à examiner' : 'Mes préparations de cours' }}
                    </h2>

                    <p class="mb-0">
                        {{ direction
                            ? 'Consultez les préparations transmises par les enseignants et prenez une décision.'
                            : 'Organisez vos préparations pédagogiques et retrouvez leur historique par cours.'
                        }}
                    </p>
                </div>

                {% if direction %}
                    <a class="btn btn-outline-secondary" href="{{ path('app_preparation_cours_index') }}">
                        <i class="fas fa-arrow-left me-1"></i> Espace enseignant
                    </a>
                {% else %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <a class="btn btn-outline-primary" href="{{ path('app_preparation_cours_direction') }}">
                            <i class="fas fa-inbox me-1"></i> Soumissions à examiner
                        </a>
                    {% endif %}
                {% endif %}
            </div>

            {# ===================================================== #}
            {# ESPACE DIRECTION #}
            {# ===================================================== #}

            {% if direction %}

                {% if preparations_soumises is empty %}

                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center py-5">
                            <i class="fas fa-clipboard-check fa-3x text-muted mb-3"></i>
                            <h5 class="fw-bold">Tout est à jour !</h5>
                            <p class="text-muted mb-0">
                                Aucune préparation n'attend actuellement la validation de la direction.
                            </p>
                        </div>
                    </div>

                {% else %}

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <div class="section-label mb-1">BOÎTE DE RÉCEPTION</div>
                            <h5 class="fw-bold mb-0">
                                Préparations reçues
                                <span class="badge bg-primary ms-1">{{ preparations_soumises|length }}</span>
                            </h5>
                        </div>
                    </div>

                    <div class="row g-3">

                        {% for preparation in preparations_soumises %}

                            <div class="col-12 col-xl-6">
                                <div class="submission-card">

                                    <div class="submission-heading">
                                        <div class="teacher-avatar">
                                            <i class="fas fa-user-tie"></i>
                                        </div>

                                        <div class="flex-grow-1">
                                            <div class="fw-bold text-dark">
                                                {{ preparation.professeur.prenom }} {{ preparation.professeur.nom }}
                                            </div>
                                            <small class="text-muted">
                                                Enseignant
                                            </small>
                                        </div>

                                        <span class="status-badge status-soumise">
                                            <i class="fas fa-clock me-1"></i> En attente
                                        </span>
                                    </div>

                                    <div class="submission-info">
                                        <div class="row g-3">

                                            <div class="col-6">
                                                <div class="info-label">Cours</div>
                                                <div class="info-value">{{ preparation.cours.nom }}</div>
                                            </div>

                                            <div class="col-6">
                                                <div class="info-label">Classe</div>
                                                <div class="info-value">{{ preparation.cours.classe.nom }}</div>
                                            </div>

                                            <div class="col-6">
                                                <div class="info-label">Établissement</div>
                                                <div class="info-value">{{ preparation.cours.classe.ecole.nom }}</div>
                                            </div>

                                            <div class="col-6">
                                                <div class="info-label">Soumise le</div>
                                                <div class="info-value">
                                                    {{ preparation.soumiseLe ? preparation.soumiseLe|date('d/m/Y H:i') : '—' }}
                                                </div>
                                            </div>

                                        </div>

                                        <div class="mt-3">
                                            <div class="info-label">
                                                Préparation n°{{ preparation.numero }}
                                            </div>
                                            <div class="fw-bold text-dark">
                                                {{ preparation.sujet }}
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <a class="btn btn-sm btn-outline-primary"
                                           href="{{ path('app_preparation_cours_show', {id: preparation.id}) }}">
                                            <i class="fas fa-eye me-1"></i> Consulter la fiche
                                        </a>
                                    </div>

                                    <div class="review-area">

                                        <div class="small fw-bold text-muted mb-3">
                                            <i class="fas fa-gavel me-1"></i>
                                            Décision pédagogique
                                        </div>

                                        <form method="post"
                                              action="{{ path('app_preparation_cours_review', {id: preparation.id, decision: 'valider'}) }}"
                                              class="mb-3">

                                            <input type="hidden" name="_token"
                                                   value="{{ csrf_token('preparation-review-' ~ preparation.id) }}">

                                            <textarea class="form-control form-control-sm mb-2"
                                                      name="commentaire"
                                                      rows="2"
                                                      placeholder="Commentaire facultatif..."></textarea>

                                            <button class="btn btn-sm btn-success" type="submit">
                                                <i class="fas fa-check me-1"></i> Valider la préparation
                                            </button>
                                        </form>

                                        <form method="post"
                                              action="{{ path('app_preparation_cours_review', {id: preparation.id, decision: 'corriger'}) }}">

                                            <input type="hidden" name="_token"
                                                   value="{{ csrf_token('preparation-review-' ~ preparation.id) }}">

                                            <textarea class="form-control form-control-sm mb-2"
                                                      name="commentaire"
                                                      rows="2"
                                                      placeholder="Précisez les corrections attendues..."
                                                      required></textarea>

                                            <button class="btn btn-sm btn-warning" type="submit">
                                                <i class="fas fa-undo me-1"></i> Retourner pour correction
                                            </button>
                                        </form>

                                    </div>
                                </div>
                            </div>

                        {% endfor %}

                    </div>

                {% endif %}

            {# ===================================================== #}
            {# ESPACE ENSEIGNANT #}
            {# ===================================================== #}

            {% else %}

                {% if cours is empty %}

                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center py-5">
                            <i class="fas fa-book-open fa-3x text-muted mb-3"></i>
                            <h5 class="fw-bold">Aucun cours attribué</h5>
                            <p class="text-muted mb-0">
                                Aucun cours n'est associé à votre profil.
                                Contactez la direction pour vérifier votre charge horaire.
                            </p>
                        </div>
                    </div>

                {% else %}

                    <div class="section-label">
                        <i class="fas fa-book me-1"></i>
                        MES COURS ET LEURS PRÉPARATIONS
                    </div>

                    {% for item in cours %}

                        {% set historique = preparations_par_cours[item.id] ?? [] %}

                        {% set couleurs = {
                            'brouillon': 'secondary',
                            'soumise': 'info',
                            'validee': 'success',
                            'a_corriger': 'warning'
                        } %}

                        {% set libelles = {
                            'brouillon': 'Brouillon',
                            'soumise': 'Soumise à la direction',
                            'validee': 'Validée',
                            'a_corriger': 'À corriger'
                        } %}

                        <div class="course-card mb-4">

                            {# EN-TÊTE DU COURS #}

                            <div class="course-header d-flex flex-wrap justify-content-between align-items-center gap-3">

                                <div class="d-flex align-items-center gap-3">

                                    <div class="course-icon">
                                        <i class="fas fa-book-open"></i>
                                    </div>

                                    <div>
                                        <h4 class="course-title">
                                            {{ item.nom }}
                                        </h4>

                                        <div class="course-meta">
                                            <i class="fas fa-users me-1"></i>
                                            {{ item.classe.nom }}

                                            <span class="mx-1">·</span>

                                            <i class="fas fa-school me-1"></i>
                                            {{ item.classe.ecole.nom }}

                                            {% if item.option %}
                                                <span class="mx-1">·</span>
                                                <i class="fas fa-layer-group me-1"></i>
                                                {{ item.option.nom }}
                                            {% endif %}
                                        </div>
                                    </div>

                                </div>

                                <div class="d-flex flex-wrap gap-2">

                                    {% if historique is not empty %}
                                        <a class="btn btn-sm btn-outline-secondary"
                                           href="{{ path('app_preparation_cours_history_pdf', {cours: item.id}) }}">
                                            <i class="fas fa-file-pdf me-1"></i>
                                            Historique PDF
                                        </a>
                                    {% endif %}

                                    <a class="btn btn-sm btn-primary"
                                       href="{{ path('app_preparation_cours_new', {cours: item.id}) }}">
                                        <i class="fas fa-plus me-1"></i>
                                        Nouvelle préparation
                                    </a>

                                </div>

                            </div>

                            {# CHARGE HORAIRE #}

                            {% if item.horaires is not empty %}

                                <div class="schedule-area">
                                    <span class="schedule-label">
                                        <i class="fas fa-calendar-alt me-1"></i>
                                        Charge horaire
                                    </span>

                                    {% for creneau in item.horaires %}
                                        {% if creneau.jour and creneau.heure %}
                                            <span class="schedule-badge">
                                                {{ creneau.jour.nom }}
                                                {{ creneau.heure.heureDebut|date('H:i') }}
                                                –
                                                {{ creneau.heure.heureFin|date('H:i') }}
                                            </span>
                                        {% endif %}
                                    {% endfor %}
                                </div>

                            {% endif %}

                            {# HISTORIQUE DES PRÉPARATIONS #}

                            <div class="history-section">

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="history-title mb-0">
                                        <i class="fas fa-history me-1"></i>
                                        Historique des préparations
                                    </div>

                                    <span class="badge bg-light text-dark border">
                                        {{ historique|length }}
                                        préparation(s)
                                    </span>
                                </div>

                                {% if historique is empty %}

                                    <div class="empty-history">
                                        <i class="fas fa-folder-open d-block"></i>
                                        <p class="fw-semibold text-dark mb-1">
                                            Aucune préparation pour ce cours
                                        </p>
                                        <p>
                                            Commencez par créer votre première fiche de préparation.
                                        </p>
                                    </div>

                                {% else %}

                                    {% for preparation in historique %}

                                        <div class="preparation-item">

                                            <div class="d-flex align-items-center gap-3 flex-grow-1">

                                                <div class="prep-number">
                                                    #{{ preparation.numero }}
                                                </div>

                                                <div class="flex-grow-1">
                                                    <div class="prep-subject">
                                                        {{ preparation.sujet }}
                                                    </div>

                                                    <div class="prep-date">
                                                        <i class="far fa-calendar-alt me-1"></i>
                                                        {{ preparation.dateCours|date('d/m/Y') }}
                                                    </div>
                                                </div>

                                            </div>

                                            <div class="d-flex align-items-center flex-wrap gap-2 prep-actions">

                                                <span class="status-badge status-{{ preparation.statut }}">
                                                    {{ libelles[preparation.statut] ?? preparation.statut }}
                                                </span>

                                                <a class="btn btn-sm btn-outline-primary"
                                                   href="{{ path('app_preparation_cours_show', {id: preparation.id}) }}"
                                                   title="Consulter la préparation">
                                                    <i class="fas fa-eye"></i>
                                                </a>

                                                <a class="btn btn-sm btn-outline-secondary"
                                                   href="{{ path('app_preparation_cours_pdf', {id: preparation.id}) }}"
                                                   title="Télécharger le PDF">
                                                    <i class="fas fa-file-pdf"></i>
                                                </a>

                                            </div>

                                        </div>

                                    {% endfor %}

                                {% endif %}

                            </div>

                        </div>

                    {% endfor %}

                {% endif %}

            {% endif %}

        </div>
    </div>
</div>
{% endblock %}
