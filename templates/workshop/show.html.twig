{% extends 'base.html.twig' %}

{% block title %}Workshop
{% endblock %}

{% block body %}


	<!-- Begin page -->
	<div class="wrapper">


		<div class="content-page">

			<div class="container-fluid">

				<div class="page-title-head d-flex align-items-center">
					<div class="flex-grow-1">
						<h4 class="fs-xl fw-bold m-0">Détail de l'Atélier</h4>
					</div>

					<div class="text-end">
						<ol class="breadcrumb m-0 py-0">
							<li class="breadcrumb-item">
								<a href="javascript: void(0);">ENABEL</a>
							</li>

							<li class="breadcrumb-item">
								<a href="javascript: void(0);">Workshop</a>
							</li>

							<li class="breadcrumb-item active">Détail</li>
						</ol>
					</div>
				</div>


				<div class="container-fluid">
					<div
						class="row">
						<!-- Informations rapides -->
						<div class="col-xl-3">
							<div class="card">
								<div class="card-header">
									<h4 class="card-title">
										Atelier N° :
										{{ workshop.id }}
									</h4>
								</div>

								<div class="card-body text-center">
									<h4>{{ workshop.name }}</h4>
									<p class="text-muted">
										Code :
										<strong>{{ workshop.code }}</strong>
									</p>

									<hr>

									<div class="d-grid gap-2">
										<a href="{{ path('app_workshop_edit', {'id': workshop.id}) }}" class="btn btn-warning">
											<i class="ti ti-edit"></i>
											Modifier
										</a>

										{% include 'workshop/_delete_form.html.twig' %}

										<a href="{{ path('app_workshop_index') }}" class="btn btn-secondary">
											<i class="ti ti-arrow-left"></i>
											Retour
										</a>
									</div>
								</div>

							</div>

						</div>
						<div class="col-xl-3">
							<div class="card h-100">

								<div class="card-header d-flex justify-content-between align-items-center">

									<h4 class="card-title mb-0">
										Programme de l'atelier
									</h4>

									<span class="badge bg-primary">
										{{ workshop.workshopDays|length }}
										Jour{{ workshop.workshopDays|length > 1 ? 's' : '' }}
									</span>

								</div>

								<div class="card-body p-0">

									{% if workshop.workshopDays|length > 0 %}

										<table class="table table-hover table-bordered mb-0">

											<thead class="table-light">

												<tr>
													<th>Jour</th>
													<th>Date</th>
													<th>Statut</th>
												</tr>

											</thead>

											<tbody>

												{% for day in workshop.workshopDays %}

													<tr>

														<td>
															Jour
															{{ loop.index }}
														</td>

														<td>
															{{ day.date|date('d/m/Y') }}
														</td>

														<td>

															{% if day.isClosed %}

																<span class="badge bg-danger">
																	Terminé
																</span>

															{% else %}

																<span class="badge bg-success">
																	En cours
																</span>

															{% endif %}

														</td>

													</tr>

												{% endfor %}

											</tbody>

										</table>

									{% else %}

										<div class="text-center py-4 text-muted">
											Aucun jour enregistré.
										</div>

									{% endif %}

								</div>

							</div>
						</div>
						<!-- Détails -->
						<div class="col-xl-6">
							<div class="card">
								<div class="card-header">

									<h4 class="card-title">
										Détails de l'atelier
									</h4>

								</div>

								<div class="card-body">

									<div class="table-responsive">

										<table class="table table-bordered align-middle">

											<tbody>

												<tr>
													<th>Description</th>
													<td>{{ workshop.description }}</td>
												</tr>

												<tr>
													<th>Montant à Payer
													</th>
													<td>{{ workshop.dailyAmount|number_format(2,'.',' ') }}</td>
												</tr>

												<tr>
													<th>Devise</th>
													<td>
														<span class="badge bg-info">
															{{ workshop.currency }}
														</span>
													</td>
												</tr>

												<tr>
													<th>Code</th>
													<td>{{ workshop.code }}</td>
												</tr>
<tr>
												<th>Crée par</th>
													<td>{{ workshop.createdBy ? workshop.createdBy.firstname ~ ' ' ~ workshop.createdBy.lastname : '---' }}</td>
												</tr>

												<tr>
													<th>Crée le </th>
													<td>
														{{ workshop.createdAt ? workshop.createdAt|date('d/m/Y H:i') : '---' }}
													</td>
												</tr>

												<tr>
													<th>Modifié le</th>
													<td>
														{{ workshop.updatedAt ? workshop.updatedAt|date('d/m/Y H:i') : '---' }}
													</td>
												</tr>

											</tbody>

										</table>

									</div>

								</div>

							</div>

						</div>
					</div>

				</div>

			</div>

		</div>
		<!-- container -->

	</div>
</div>{% endblock %}
