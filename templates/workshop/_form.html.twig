{{ form_start(form) }}

<div class="row">

    <div class="col-md-6 mb-3">
        {{ form_label(form.name) }}
        {{ form_widget(form.name) }}
        {{ form_errors(form.name) }}
    </div>

    <div class="col-md-6 mb-3">
        {{ form_label(form.configuration) }}
        {{ form_widget(form.configuration) }}
        {{ form_errors(form.configuration) }}
    </div>

    <div class="col-md-12 mb-3">
        {{ form_label(form.description) }}
        {{ form_widget(form.description) }}
        {{ form_errors(form.description) }}
    </div>

    <div class="col-md-4 mb-3">
        {{ form_label(form.dailyAmount) }}
        {{ form_widget(form.dailyAmount) }}
        {{ form_errors(form.dailyAmount) }}
    </div>

    <div class="col-md-4 mb-3">
        {{ form_label(form.currency) }}
        {{ form_widget(form.currency) }}
        {{ form_errors(form.currency) }}
    </div>

    <div class="col-md-4 mb-3">
        {{ form_label(form.isEnded) }}
        {{ form_widget(form.isEnded) }}
        {{ form_errors(form.isEnded) }}
    </div>

</div>

<div class="text-end mt-4">

    <button class="btn btn-primary">
        <i class="ti ti-device-floppy me-1"></i>
        {{ button_label|default('Enregistrer') }}
    </button>

</div>

{{ form_end(form) }}