{% extends 'base.html.twig' %}

{% block title %}Workshop{% endblock %}

{% block body %}
    <h1>Workshop</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ workshop.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ workshop.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ workshop.description }}</td>
            </tr>
            <tr>
                <th>DailyAmount</th>
                <td>{{ workshop.dailyAmount }}</td>
            </tr>
            <tr>
                <th>Currency</th>
                <td>{{ workshop.currency }}</td>
            </tr>
            <tr>
                <th>IsEnded</th>
                <td>{{ workshop.isEnded ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Code</th>
                <td>{{ workshop.code }}</td>
            </tr>
            <tr>
                <th>Enabled</th>
                <td>{{ workshop.enabled ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Deleted</th>
                <td>{{ workshop.deleted ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ workshop.createdAt ? workshop.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ workshop.updatedAt ? workshop.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_workshop_index') }}">back to list</a>

    <a href="{{ path('app_workshop_edit', {'id': workshop.id}) }}">edit</a>

    {{ include('workshop/_delete_form.html.twig') }}
{% endblock %}












{% extends 'base.html.twig' %}

{% block title %}Workshops{% endblock %}

{% block body %}

<div class="container-fluid">

    <div class="row mb-3">
        <div class="col-sm-6">
            <h4 class="mb-0">Liste des ateliers</h4>
        </div>

        <div class="col-sm-6">
            <div class="text-sm-end">
                <a href="{{ path('app_workshop_new') }}" class="btn btn-success">
                    <i class="ti ti-plus"></i>
                    Nouvel atelier
                </a>
            </div>
        </div>
    </div>

    <div class="card">

        <div class="card-header">
            <h5 class="card-title mb-0">
                Ateliers
            </h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover table-centered align-middle mb-0">

                    <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Nom</th>
                        <th>Description</th>
                        <th>Montant</th>
                        <th>Devise</th>
                        <th>Statut</th>
                        <th>Date création</th>
                        <th width="120">Actions</th>
                    </tr>
                    </thead>

                    <tbody>

                    {% for workshop in workshops %}

                        <tr>

                            <td>{{ workshop.id }}</td>

                            <td>
                                <strong>{{ workshop.name }}</strong>
                            </td>

                            <td>
                                {{ workshop.description|slice(0,60) }}
                                {% if workshop.description|length > 60 %}
                                    ...
                                {% endif %}
                            </td>

                            <td>
                                {{ workshop.dailyAmount|number_format(2,'.',' ') }}
                            </td>

                            <td>
                                <span class="badge bg-info">
                                    {{ workshop.currency }}
                                </span>
                            </td>

                            <td>

                                {% if workshop.isEnded %}
                                    <span class="badge bg-danger">
                                        Terminé
                                    </span>
                                {% else %}
                                    <span class="badge bg-success">
                                        En cours
                                    </span>
                                {% endif %}

                            </td>

                            <td>
                                {{ workshop.createdAt ? workshop.createdAt|date('d/m/Y') : '-' }}
                            </td>

                            <td>

                                <a href="{{ path('app_workshop_show', {'id': workshop.id}) }}"
                                   class="btn btn-sm btn-outline-info">

                                    <i class="ti ti-eye"></i>

                                </a>

                                <a href="{{ path('app_workshop_edit', {'id': workshop.id}) }}"
                                   class="btn btn-sm btn-outline-warning">

                                    <i class="ti ti-edit"></i>

                                </a>

                            </td>

                        </tr>

                    {% else %}

                        <tr>

                            <td colspan="8" class="text-center text-muted py-5">

                                Aucun atelier trouvé.

                            </td>

                        </tr>

                    {% endfor %}

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

{% endblock %}
