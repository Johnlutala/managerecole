{% extends 'base.html.twig' %}

{% block title %}Modifier un atelier{% endblock %}

{% block body %}

<div class="container-fluid">
             

    <div class="row justify-content-center">

        <div class="col-xl-8">
         <div class="page-title-head d-flex align-items-center">
					<div class="flex-grow-1">
						<h4 class="fs-xl fw-bold m-0">Mis à Jour de l'Atélier</h4>
					</div>

					<div class="text-end">
						<ol class="breadcrumb m-0 py-0">
							
                            <li class="breadcrumb-item">
								<a href="javascript: void(0);">ENABEL</a>
							</li>

							<li class="breadcrumb-item">
								<a href="javascript: void(0);">Workshop</a>
							</li>

							<li class="breadcrumb-item active">Modifier</li>
						</ol>
					</div>
				</div>

            <div class="card">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <h4 class="card-title mb-0">
                        <i class="ti ti-edit me-2"></i>
                        Modifier l'atelier
                    </h4>

                    <a href="{{ path('app_workshop_index') }}" class="btn btn-secondary">
                        <i class="ti ti-arrow-left"></i>
                        Retour
                    </a>

                </div>

                <div class="card-body">

                    {{ include('workshop/_form.html.twig', {
                        button_label: 'Mettre à jour'
                    }) }}

                </div>
            </div>

        </div>

    </div>

</div>

{% endblock %}