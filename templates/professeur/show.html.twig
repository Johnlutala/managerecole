{% extends 'base.html.twig' %}

{% block title %}Détail Professeur{% endblock %}

{% block body %}

    <div class="wrapper">

        <div class="content-page">

            <div class="container-fluid">

                {# ==================== TITRE ==================== #}

                <div class="page-title-head d-flex align-items-center">

                    <div class="flex-grow-1">

                        <h4 class="fs-xl fw-bold m-0">
                            Détail du professeur
                        </h4>

                    </div>

                    <div class="text-end">

                        <ol class="breadcrumb m-0 py-0">

                            <li class="breadcrumb-item">
                                <a href="javascript:void(0);">
                                    ADMIN
                                </a>
                            </li>

                            <li class="breadcrumb-item">
                                <a href="{{ path('app_professeur_index') }}">
                                    Professeurs
                                </a>
                            </li>

                            <li class="breadcrumb-item active">
                                Détail
                            </li>

                        </ol>

                    </div>

                </div>


                {# ==================== CONTENU ==================== #}

                <div class="row">
                    {# ==================== INFORMATIONS RAPIDES ==================== #}
                    <div class="col-xl-2">

                        <div class="card">

                            <div class="card-header">

                                <h4 class="card-title">
                                    Professeur N° :
                                    {{ professeur.id }}
                                </h4>

                            </div>

                            <div class="card-body text-center">

                                <div class="avatar-xl mx-auto mb-3">

                                    <div class="avatar-title bg-primary-subtle text-primary rounded">

                                        <i class="ti ti-user fs-1"></i>

                                    </div>

                                </div>

                                <h4 class="mb-1">

                                    {{ professeur.nom }}

                                    {% if professeur.postnom %}
                                        {{ professeur.postnom }}
                                    {% endif %}

                                    {{ professeur.prenom }}

                                </h4>

                                <p class="text-muted mb-2">

                                    Matricule :

                                    <strong>
                                        {{ professeur.matricule }}
                                    </strong>

                                </p>

                                <hr>

                                <div class="d-grid gap-2">

                                    {% if app.user and app.user.professeur and app.user.professeur.id == professeur.id %}
                                        <a href="{{ path('app_professeur_notes_index') }}" class="btn btn-primary">
                                            <i class="ti ti-clipboard-pen-line me-1"></i>
                                            Gérer les notes
                                        </a>
                                    {% endif %}

                                    <a
                                        href="{{ path('app_professeur_edit', {'id': professeur.id}) }}"
                                        class="btn btn-warning"
                                    >

                                        <i class="ti ti-edit me-1"></i>
                                        Modifier

                                    </a>

                                    {% if is_granted('ROLE_ADMIN') %}
                                        <button
                                            type="button"
                                            class="btn btn-primary"
                                            onclick="resetAccountPassword(
                                                    '{{ path('app_account_reset_password', {
                                                        type: 'professeur',
                                                        id: professeur.id
                                                    }) }}',
                                                    '{{ csrf_token('reset_password_professeur_' ~ professeur.id) }}'
                                                )"
                                        >
                                            <i class="ti ti-key me-1"></i>
                                            Réinitialiser le mot de passe
                                        </button>
                                    {% endif %}

                                    {% include 'professeur/_delete_form.html.twig' %}

                                    <a
                                        href="{{ path('app_professeur_index') }}"
                                        class="btn btn-secondary"
                                    >

                                        <i class="ti ti-arrow-left me-1"></i>
                                        Retour

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>
                    {# ==================== INFORMATIONS PROFESSEUR ==================== #}
                    <div class="col-xl-5">

                        <div class="card h-100">

                            <div class="card-header">

                                <h4 class="card-title mb-0">
                                    Informations du professeur
                                </h4>

                            </div>

                            <div class="card-body">

                                <div class="table-responsive">

                                    <table class="table table-bordered align-middle mb-0">

                                        <tbody>

                                            <tr>

                                                <th width="40%">
                                                    Matricule
                                                </th>

                                                <td>
                                                    {{ professeur.matricule }}
                                                </td>

                                            </tr>

                                            <tr>

                                                <th>
                                                    Nom complet
                                                </th>

                                                <td>

                                                    {{ professeur.nom }}

                                                    {% if professeur.postnom %}
                                                        {{ professeur.postnom }}
                                                    {% endif %}

                                                    {{ professeur.prenom }}

                                                </td>

                                            </tr>

                                            <tr>

                                                <th>
                                                    Sexe
                                                </th>

                                                <td>
                                                    {{ professeur.sexe }}
                                                </td>

                                            </tr>

                                            <tr>

                                                <th>
                                                    Date de naissance
                                                </th>

                                                <td>

                                                    {{ professeur.dateNaissance
														? professeur.dateNaissance|date('d/m/Y')
														: '—'
													}}

                                                </td>

                                            </tr>

                                            <tr>

                                                <th>
                                                    Téléphone
                                                </th>

                                                <td>
                                                    {{ professeur.phone ?: '—' }}
                                                </td>

                                            </tr>

                                            <tr>

                                                <th>
                                                    E-mail
                                                </th>

                                                <td>
                                                    {{ professeur.email ?: '—' }}
                                                </td>

                                            </tr>

                                            <tr>

                                                <th>
                                                    Adresse
                                                </th>

                                                <td>
                                                    {{ professeur.adresse ?: '—' }}
                                                </td>

                                            </tr>

                                            <tr>

                                                <th>
                                                    Spécialité
                                                </th>

                                                <td>
                                                    {{ professeur.specialite ?: '—' }}
                                                </td>

                                            </tr>

                                            <tr>

                                                <th>
                                                    Grade
                                                </th>

                                                <td>

                                                    {{ professeur.grade ? : '—'
													}}

                                                </td>

                                            </tr>

                                            <tr>

                                                <th>
                                                    Statut
                                                </th>

                                                <td>

                                                    {% if professeur.statut == 'Actif' %}

                                                        <span class="badge bg-success">
                                                            Actif
                                                        </span>

                                                    {% else %}

                                                        <span class="badge bg-secondary">
                                                            {{ professeur.statut ?: '—' }}
                                                        </span>

                                                    {% endif %}

                                                </td>

                                            </tr>

                                        </tbody>

                                    </table>

                                </div>

                            </div>

                        </div>

                    </div>
                    {# ==================== AFFECTATION ==================== #}
                    <div class="col-xl-5 mt-1">
                        {# ==================== AFFECTATION SCOLAIRE ==================== #}
                        <div class="card">

                            <div class="card-header">

                                <h4 class="card-title mb-0">

                                    <i class="ti ti-school me-2"></i>

                                    Affectation scolaire

                                </h4>

                            </div>

                            <div class="table-responsive">

                                <table class="table table-bordered align-middle mb-0">

                                    <tbody>

                                        <tr>
                                            <th>École</th>

                                            <td>

                                                {% if professeur.ecole %}

                                                    <a href="{{ path('app_ecole_show', {'id': professeur.ecole.id}) }}">

                                                        {{ professeur.ecole.nom }}

                                                    </a>

                                                {% else %}

                                                    —

                                                {% endif %}

                                            </td>
                                        </tr>

                                        <tr>
                                            <th>Année scolaire</th>

                                            <td>

                                                {% if professeur.anneeScolaire %}
                                                    {{ professeur.anneeScolaire.libelle }}
                                                {% else %}
                                                    —
                                                {% endif %}

                                            </td>
                                        </tr>

                                        <tr>
                                            <th>Section</th>

                                            <td>

                                                {% if professeur.section %}
                                                    {{ professeur.section.nom }}
                                                {% else %}
                                                    —
                                                {% endif %}

                                            </td>
                                        </tr>

                                        <tr>
                                            <th>Date d'embauche</th>

                                            <td>
                                                {{ professeur.dateEmbauche
                                ? professeur.dateEmbauche|date('d/m/Y')
                                : '—'
                            }}
                                            </td>
                                        </tr>

                                        <tr>
                                            <th>Créé le</th>

                                            <td>
                                                {{ professeur.createdAt
                                ? professeur.createdAt|date('d/m/Y H:i')
                                : '—'
                            }}
                                            </td>
                                        </tr>

                                        <tr>
                                            <th>Créé par</th>

                                            <td>
                                                {{ professeur.createdBy
                                ? professeur.createdBy.firstname ~ ' ' ~ professeur.createdBy.lastname
                                : '—'
                            }}
                                            </td>
                                        </tr>

                                        <tr>
                                            <th>Mis à jour le</th>

                                            <td>
                                                {{ professeur.updatedAt
                                ? professeur.updatedAt|date('d/m/Y H:i')
                                : '—'
                            }}
                                            </td>
                                        </tr>

                                    </tbody>

                                </table>

                            </div>

                        </div>
                        {# ==================== COURS ATTRIBUÉS ==================== #}

                        <div class="card mt-3">

                            <div class="card-header">

                                <h4 class="card-title mb-0">

                                    <i class="ti ti-book me-2"></i>

                                    Cours attribués

                                </h4>

                            </div>

                            <div class="table-responsive">

                                <table class="table table-bordered table-hover align-middle mb-0">

                                    <thead>
                                        <tr>
                                            <th style="width: 50px;">#</th>
                                            <th>Cours</th>
                                            <th>Classe</th>
                                            <th>École</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        {% if cours is not empty %}

                                            {% for cour in cours %}

                                                <tr>

                                                    <td>
                                                        {{ loop.index }}
                                                    </td>

                                                    <td>
                                                        <strong>
                                                            {{ cour.nom }}
                                                        </strong>
                                                    </td>
                                                    <td>
                                                        {% if cour.classe %}
                                                            {{ cour.classe.nom }}
                                                        {% else %}
                                                            —
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        {% if cour.classe and cour.classe.ecole %}
                                                            {{ cour.classe.ecole.nom }}
                                                        {% else %}
                                                            —
                                                        {% endif %}
                                                    </td>
                                                </tr>

                                            {% endfor %}

                                        {% else %}

                                            <tr>

                                                <td colspan="4" class="text-center text-muted py-4">

                                                    <i class="ti ti-book-off fs-3 d-block mb-2"></i>

                                                    Aucun cours attribué.

                                                </td>

                                            </tr>

                                        {% endif %}

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    
<script>
    async function resetAccountPassword(url, csrfToken) {

        const confirmation = await Swal.fire({
            title: "Réinitialiser le mot de passe ?",
            text: "Le mot de passe actuel sera remplacé par un nouveau.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Oui, réinitialiser",
            cancelButtonText: "Annuler",
            confirmButtonColor: "#dc3545",
            cancelButtonColor: "#6c757d"
        });

        if (!confirmation.isConfirmed) {
            return;
        }

        Swal.fire({
            title: "Réinitialisation...",
            text: "Veuillez patienter.",
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => Swal.showLoading()
        });

        try {

            const response = await fetch(url, {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded",
                    "Accept": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                },
                body: new URLSearchParams({
                    _token: csrfToken
                })
            });

            const responseText = await response.text();

            console.log("Statut HTTP :", response.status);
            console.log("Réponse serveur :", responseText);

            let data;

            try {
                data = JSON.parse(responseText);
            } catch (error) {
                throw new Error("Réponse invalide du serveur.");
            }

            Swal.close();

            if (!response.ok) {
                throw new Error(
                    data.message || "Erreur HTTP : " + response.status
                );
            }

            if (data.success) {

                const username = data.username ?? "Non disponible";
                const password = data.password ?? "Non disponible";

                await Swal.fire({
                    icon: "success",
                    title: "Réinitialisation réussie",

                    html: `
                        <div class="text-start mt-3">

                            <p class="text-muted mb-3">
                                Les identifiants du compte ont été renouvelés avec succès.
                            </p>

                            <!-- Nom d'utilisateur -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="ti ti-user me-1"></i>
                                    Nom d'utilisateur
                                </label>

                                <div class="input-group">
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="resetUsername"
                                        readonly
                                    >

                                    <button
                                        class="btn btn-outline-primary"
                                        type="button"
                                        id="copyUsername"
                                        title="Copier le nom d'utilisateur"
                                    >
                                        <i class="ti ti-copy"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Nouveau mot de passe -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="ti ti-lock me-1"></i>
                                    Nouveau mot de passe
                                </label>

                                <div class="input-group">
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="resetPassword"
                                        readonly
                                    >

                                    <button
                                        class="btn btn-outline-primary"
                                        type="button"
                                        id="copyPassword"
                                        title="Copier le mot de passe"
                                    >
                                        <i class="ti ti-copy"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Statut de l'envoi du mail -->
                            <div class="alert ${data.mailSent ? 'alert-success' : 'alert-warning'} d-flex align-items-start gap-2 mt-3 mb-0">

                                <i class="ti ${data.mailSent ? 'ti-mail-check' : 'ti-alert-triangle'} fs-4"></i>

                                <div class="text-start small">
                                    ${data.mailSent
                                        ? "Les nouveaux identifiants ont également été envoyés par e-mail."
                                        : "Le mot de passe a été modifié, mais le courriel n’a pas pu être envoyé."
                                    }
                                </div>

                            </div>

                            <p class="text-muted small mt-3 mb-0">
                                Veuillez communiquer ces identifiants au titulaire
                                du compte de manière sécurisée.
                            </p>

                        </div>
                    `,

                    width: "520px",
                    confirmButtonText: "Fermer",
                    confirmButtonColor: "#25324B",

                    didOpen: () => {

                        // Afficher les identifiants
                        document.getElementById("resetUsername").value = username;
                        document.getElementById("resetPassword").value = password;

                        // Copier le nom d'utilisateur
                        document.getElementById("copyUsername").addEventListener("click", async () => {
                            await copyCredential(username);
                        });

                        // Copier le mot de passe
                        document.getElementById("copyPassword").addEventListener("click", async () => {
                            await copyCredential(password);
                        });
                    }
                });

            } else {

                Swal.fire({
                    icon: "error",
                    title: "Échec de la réinitialisation",
                    text: data.message || "Une erreur est survenue."
                });

            }

        } catch (error) {

            Swal.close();

            console.error("Erreur de réinitialisation :", error);

            Swal.fire({
                icon: "error",
                title: "Erreur de communication",
                text: error.message || "Impossible de contacter le serveur. Veuillez réessayer."
            });

        }
    }

    // Fonction de copie des identifiants
    async function copyCredential(value) {

        try {

            await navigator.clipboard.writeText(value);

        } catch (error) {

            const textarea = document.createElement("textarea");
            textarea.value = value;
            textarea.style.position = "fixed";
            textarea.style.opacity = "0";

            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand("copy");
            textarea.remove();

        }

        Swal.fire({
            toast: true,
            position: "top-end",
            icon: "success",
            title: "Copié dans le presse-papiers",
            showConfirmButton: false,
            timer: 1500
        });
    }
</script>

{% endblock %}

