{% extends 'base.html.twig' %}{% block title %}Détail Professeur{% endblock %}{% block body %}<div class="container-fluid"><div class="page-title-head d-flex justify-content-between align-items-center"><h4 class="fs-xl fw-bold m-0">Détail Professeur</h4><a href="{{ path('app_professeur_' ~ 'index') }}" class="btn btn-secondary"><i class="ti ti-arrow-left me-1"></i>Retour</a></div><div class="row"><div class="col-lg-3"><div class="card"><div class="card-body d-grid gap-2"><a href="{{ path('app_professeur_' ~ 'edit', {id: professeur.id}) }}" class="btn btn-warning">Modifier</a>{% include 'professeur/_delete_form.html.twig' %}</div></div></div><div class="col-lg-9"><div class="card"><div class="table-responsive"><table class="table table-bordered align-middle mb-0"><tbody><tr><th>Matricule</th><td>{{ professeur.matricule }}</td></tr><tr><th>Nom complet</th><td>{{ professeur.nom }} {{ professeur.postnom }} {{ professeur.prenom }}</td></tr><tr><th>Sexe</th><td>{{ professeur.sexe }}</td></tr><tr><th>Spécialité</th><td>{{ professeur.specialite ?: '—' }}</td></tr><tr><th>Écoles</th><td>{{ professeur.ecoles|map(e => e.nom)|join(', ') ?: '—' }}</td></tr><tr><th>Créé le</th><td>{{ professeur.createdAt ? professeur.createdAt|date('d/m/Y H:i') : '—' }}</td></tr><tr><th>Créé par</th><td>{{ professeur.createdBy ? professeur.createdBy.firstname ~ ' ' ~ professeur.createdBy.lastname : '—' }}</td></tr><tr><th>Mis à jour le</th><td>{{ professeur.updatedAt ? professeur.updatedAt|date('d/m/Y H:i') : '—' }}</td></tr></tbody></table></div></div></div></div></div>{% endblock %}