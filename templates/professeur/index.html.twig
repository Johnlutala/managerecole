{% extends 'base.html.twig' %}

{% block title %}Professeurs{% endblock %}

{% block body %}

    <div class="wrapper">
        <div class="content-page">
            <div class="container-fluid">

                {# =========================================================
               TITRE
               ========================================================= #}

                <div class="page-title-head d-flex align-items-center mb-3">
                    <div class="flex-grow-1">
                        <h4 class="fs-xl fw-bold m-0">
                            Professeurs
                        </h4>
                    </div>
                </div>


                {# =========================================================
               TABLEAU
               ========================================================= #}

                <div
                    data-table
                    data-table-rows-per-page="8"
                    class="card"
                >

                    <div class="card-header border-light d-flex justify-content-between">

                        <div class="app-search">

                            <input
                                data-table-search
                                type="search"
                                class="form-control"
                                placeholder="Rechercher..."
                            >

                            <i
                                data-lucide="search"
                                class="app-search-icon text-muted"
                            >
                            </i>

                        </div>

                        <button
                            type="button"
                            class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#addModal"
                        >

                            <i class="ti ti-plus me-1"></i>

                            Nouveau

                        </button>

                    </div>


                    {# =====================================================
                   TABLE
                   ===================================================== #}

                    <div class="table-responsive">

                        <table class="table table-custom table-centered table-hover w-100 mb-0">

                            <thead class="bg-light bg-opacity-25 thead-sm">

                                <tr class="text-uppercase fs-xxs">

                                    <th>Nom complet</th>

                                    <th>Spécialité</th>

                                    <th>Statut</th>

                                    <th class="text-center">
                                        Actions
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                {% for professeur in professeurs %}

                                    <tr>

                                        <td>
                                            {{ professeur.nom }}
                                            {{ professeur.postnom }}
                                            {{ professeur.prenom }}
                                        </td>

                                        <td>
                                            {{ professeur.specialite ?: '—' }}
                                        </td>

                                        <td>
                                            {{ professeur.statut ?: '—' }}
                                        </td>

                                        <td>

                                            <div class="d-flex justify-content-center gap-1">

                                                <a
                                                    href="{{ path('app_professeur_show', {
                                                id: professeur.id
                                            }) }}"
                                                    class="btn btn-default btn-icon btn-sm rounded-circle"
                                                    title="Voir"
                                                >

                                                    <i class="ti ti-eye fs-lg"></i>

                                                </a>

                                                <a
                                                    href="{{ path('app_professeur_edit', {
                                                id: professeur.id
                                            }) }}"
                                                    class="btn btn-default btn-icon btn-sm rounded-circle"
                                                    title="Modifier"
                                                >

                                                    <i class="ti ti-edit fs-lg"></i>

                                                </a>

                                            </div>

                                        </td>

                                    </tr>

                                {% else %}

                                    <tr>

                                        <td
                                            colspan="4"
                                            class="text-center py-5 text-muted"
                                        >

                                            Aucun enregistrement trouvé.

                                        </td>

                                    </tr>

                                {% endfor %}

                            </tbody>

                        </table>

                    </div>


                    {# PAGINATION #}

                    <div class="card-footer border-0 d-flex justify-content-between">

                        <div data-table-pagination-info></div>

                        <div data-table-pagination></div>

                    </div>

                </div>

            </div>
        </div>
    </div>


    {# ================================================================
   MODAL AJOUT PROFESSEUR
   ================================================================ #}

    <div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel"  aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                {{ form_start(form) }}

                {# =====================================================
               HEADER
               ===================================================== #}

                <div class="modal-header">

                    <div>

                        <h5
                            class="modal-title fw-bold"
                            id="addModalLabel"
                        >

                            Ajouter un professeur

                        </h5>

                        <small
                            id="stepTitle"
                            class="text-muted"
                        >

                            Informations personnelles

                        </small>

                    </div>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                    >
                    </button>

                </div>


                {# =====================================================
               INDICATEUR DES ÉTAPES
               ===================================================== #}

                <div class="px-4 pt-3">

                    <div class="d-flex align-items-center">

                        {# ÉTAPE 1 #}

                        <div class="d-flex align-items-center">

                            <div
                                id="stepCircle1"
                                class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                style="width:35px;height:35px;"
                            >

                                <i class="ti ti-user"></i>

                            </div>

                            <span
                                id="stepLabel1"
                                class="ms-2 fw-semibold"
                            >

                                Personnel

                            </span>

                        </div>


                        {# PROGRESSION #}
                        <div class="flex-grow-1 mx-3">

                            <div
                                class="progress"
                                style="height:4px;"
                            >

                                <div
                                    id="stepProgress"
                                    class="progress-bar"
                                    style="width:50%;"
                                >
                                </div>

                            </div>

                        </div>


                        {# ÉTAPE 2 #}

                        <div class="d-flex align-items-center">

                            <div
                                id="stepCircle2"
                                class="rounded-circle bg-light text-muted d-flex align-items-center justify-content-center"
                                style="width:35px;height:35px;"
                            >

                                <i class="ti ti-school"></i>

                            </div>

                            <span
                                id="stepLabel2"
                                class="ms-2 fw-semibold text-muted"
                            >

                                Établissement

                            </span>

                        </div>

                    </div>

                </div>


                {# =====================================================
               BODY
               ===================================================== #}

                <div class="modal-body">


                    {# =================================================
                   ÉTAPE 1
                   INFORMATIONS PERSONNELLES
                   ================================================= #}

                    <div id="step1">

                        <div class="mb-4">

                            <h5 class="fw-bold mb-1">
                                Informations personnelles
                            </h5>

                            <p class="text-muted mb-0">
                                Renseignez les informations personnelles du professeur.
                            </p>

                        </div>


                        <div class="row">
                            <div class="col-md-4 mb-0">
                                {{ form_row(form.nom) }}
                            </div>
                            <div class="col-md-4 mb-0">
                                {{ form_row(form.postnom) }}
                            </div>
                            <div class="col-md-4 mb-0">
                                {{ form_row(form.prenom) }}
                            </div>

                            <div class="col-md-4 mb-0">
                                {{ form_row(form.sexe) }}
                            </div>
                            <div class="col-md-4 mb-0">
                                {{ form_row(form.email) }}
                            </div>
                            <div class="col-md-4 mb-0">
                                {{ form_row(form.dateNaissance) }}
                            </div>

                            <div class="col-md-6 mb-0">
                                {{ form_row(form.phone) }}
                            </div>
                            <div class="col-md-6 mb-0">
                                {{ form_row(form.adresse) }}
                            </div>
                        </div>
                    </div>

                    <div id="step2" class="d-none">
                        <div class="mb-4">
                            <h5 class="fw-bold mb-1">
                                Informations établissement
                            </h5>
                            <p class="text-muted mb-0">
                                Renseignez les informations professionnelles du professeur.
                            </p>
                        </div>

                        {# INFORMATIONS ÉTABLISSEMENT #}
                        <div class="row g-3">

                            {# ÉCOLE #}
                            <div class="col-md-4">
                                {{ form_row(form.ecole) }}
                            </div>

                            {# SECTION #}
                            <div class="col-md-4">
                                {{ form_row(form.section) }}
                            </div>

                             {# ANNÉE ACADÉMIQUE #}
                            <div class="col-md-4">
                                {{ form_row(form.anneeScolaire) }}
                            </div>

                        </div>

                        {# INFORMATIONS PROFESSIONNELLES #}
                        <div class="row g-3 mt-1">

                            {# SPÉCIALITÉ #}
                            <div class="col-md-4">
                                {{ form_row(form.specialite) }}
                            </div>
                            {# STATUT #}
                            <div class="col-md-4">
                                {{ form_row(form.grade) }}
                            </div>
                            {# DATE D'EMBAUCHE #}
                            <div class="col-md-4">
                                {{ form_row(form.dateEmbauche) }}
                            </div>


                        </div>

                    </div>

                </div>


                {# =====================================================
               FOOTER
               ===================================================== #}

                <div class="modal-footer">

                    {# ANNULER #}

                    <button
                        type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal"
                    >

                        Annuler

                    </button>


                    {# RETOUR #}

                    <button
                        type="button"
                        id="btnPrevious"
                        class="btn btn-light d-none"
                    >

                        <i class="ti ti-arrow-left me-1"></i>

                        Retour

                    </button>


                    {# SUIVANT #}

                    <button
                        type="button"
                        id="btnNext"
                        class="btn btn-primary"
                    >

                        Suivant

                        <i class="ti ti-arrow-right ms-1"></i>

                    </button>


                    {# ENREGISTRER #}

                    <button
                        type="submit"
                        id="btnSubmit"
                        class="btn btn-primary d-none"
                    >

                        <i class="ti ti-device-floppy me-1"></i>

                        Enregistrer

                    </button>

                </div>
               {{ form_end(form) }}
            </div>

        </div>

    </div>


    {# ================================================================
   JAVASCRIPT
   ================================================================ #}

    <script>
document.addEventListener("DOMContentLoaded", function () {

    /* ==========================================================
     * WIZARD
     * ========================================================== */

    const step1 = document.getElementById("step1");
    const step2 = document.getElementById("step2");

    const btnNext = document.getElementById("btnNext");
    const btnPrevious = document.getElementById("btnPrevious");
    const btnSubmit = document.getElementById("btnSubmit");

    const progress = document.getElementById("stepProgress");

    const stepTitle = document.getElementById("stepTitle");

    const stepCircle1 = document.getElementById("stepCircle1");
    const stepCircle2 = document.getElementById("stepCircle2");

    const stepLabel1 = document.getElementById("stepLabel1");
    const stepLabel2 = document.getElementById("stepLabel2");

    const modal = document.getElementById("addModal");


    /* ==========================================================
     * CHAMPS FORMULAIRE
     * ========================================================== */

    const ecoleSelect = document.getElementById("{{ form.ecole.vars.id }}");
    const anneeSelect = document.getElementById("{{ form.anneeScolaire.vars.id }}");
    const sectionSelect = document.getElementById("{{ form.section.vars.id }}");


    /* ==========================================================
     * ÉTAPE 1
     * ========================================================== */

    function showStep1() {

        step1.classList.remove("d-none");
        step2.classList.add("d-none");

        btnNext.classList.remove("d-none");
        btnPrevious.classList.add("d-none");
        btnSubmit.classList.add("d-none");

        progress.style.width = "50%";

        stepTitle.textContent = "Informations personnelles";


        stepCircle1.classList.remove(
            "bg-success",
            "bg-light",
            "text-muted"
        );

        stepCircle1.classList.add(
            "bg-primary",
            "text-white"
        );


        stepCircle2.classList.remove(
            "bg-primary",
            "text-white"
        );

        stepCircle2.classList.add(
            "bg-light",
            "text-muted"
        );


        stepLabel1.classList.remove(
            "text-muted",
            "text-success"
        );

        stepLabel1.classList.add("text-dark");


        stepLabel2.classList.remove("text-dark");

        stepLabel2.classList.add("text-muted");
    }


    /* ==========================================================
     * ÉTAPE 2
     * ========================================================== */

    function showStep2() {

        step1.classList.add("d-none");
        step2.classList.remove("d-none");

        btnNext.classList.add("d-none");
        btnPrevious.classList.remove("d-none");
        btnSubmit.classList.remove("d-none");

        progress.style.width = "100%";

        stepTitle.textContent = "Informations établissement";


        stepCircle1.classList.remove(
            "bg-primary",
            "bg-light",
            "text-muted"
        );

        stepCircle1.classList.add(
            "bg-success",
            "text-white"
        );


        stepCircle2.classList.remove(
            "bg-light",
            "text-muted"
        );

        stepCircle2.classList.add(
            "bg-primary",
            "text-white"
        );


        stepLabel1.classList.remove(
            "text-muted",
            "text-dark"
        );

        stepLabel1.classList.add("text-success");


        stepLabel2.classList.remove("text-muted");

        stepLabel2.classList.add("text-dark");
    }


    /* ==========================================================
     * SUIVANT
     * ========================================================== */

    btnNext.addEventListener("click", function () {
        showStep2();
    });


    /* ==========================================================
     * RETOUR
     * ========================================================== */

    btnPrevious.addEventListener("click", function () {
        showStep1();
    });


    /* ==========================================================
     * OUVERTURE DU MODAL
     * ========================================================== */

    modal.addEventListener("show.bs.modal", function () {

        showStep1();

        /*
         * Réinitialisation des dépendances
         */

        anneeSelect.innerHTML =
            '<option value="">Sélectionner une année scolaire</option>';

        sectionSelect.innerHTML =
            '<option value="">Sélectionner une section</option>';

        anneeSelect.disabled = true;
        sectionSelect.disabled = true;

    });


    /* ==========================================================
     * ÉTAT INITIAL
     * ========================================================== */

    anneeSelect.disabled = true;
    sectionSelect.disabled = true;


    /* ==========================================================
     * CHANGEMENT D'ÉCOLE
     * ========================================================== */

    ecoleSelect.addEventListener("change", function () {

        const ecoleId = this.value;


        /*
         * Aucune école sélectionnée
         */

        if (!ecoleId) {

            anneeSelect.innerHTML =
                '<option value="">Sélectionner une année scolaire</option>';

            sectionSelect.innerHTML =
                '<option value="">Sélectionner une section</option>';

            anneeSelect.disabled = true;
            sectionSelect.disabled = true;

            return;
        }


        /*
         * Chargement
         */

        anneeSelect.disabled = true;
        sectionSelect.disabled = true;

        anneeSelect.innerHTML =
            '<option value="">Chargement...</option>';

        sectionSelect.innerHTML =
            '<option value="">Chargement...</option>';


        /* ======================================================
         * AJAX
         * ====================================================== */

        const url =
            "{{ path('app_professeur_dependances', {id: 0}) }}"
            .replace("/0", "/" + ecoleId);


        fetch(url, {
            method: "GET",

            headers: {
                "X-Requested-With": "XMLHttpRequest",
                "Accept": "application/json"
            }
        })

        .then(function (response) {

            if (!response.ok) {

                throw new Error(
                    "Erreur HTTP " + response.status
                );
            }

            return response.json();
        })

        .then(function (data) {

            if (!data.success) {

                throw new Error(
                    data.message || "Erreur inconnue."
                );
            }


            /* ==================================================
             * ANNÉES SCOLAIRES
             * ================================================== */

            anneeSelect.innerHTML =
                '<option value="">Sélectionner une année scolaire</option>';

            data.annees.forEach(function (annee) {

                const option =
                    document.createElement("option");

                option.value = annee.id;

                option.textContent = annee.label;

                anneeSelect.appendChild(option);
            });


            /* ==================================================
             * SECTIONS
             * ================================================== */

            sectionSelect.innerHTML =
                '<option value="">Sélectionner une section</option>';

            data.sections.forEach(function (section) {

                const option =
                    document.createElement("option");

                option.value = section.id;

                option.textContent = section.label;

                sectionSelect.appendChild(option);
            });


            /* ==================================================
             * ACTIVATION
             * ================================================== */

            anneeSelect.disabled = false;
            sectionSelect.disabled = false;

        })

        .catch(function (error) {

            console.error(
                "Erreur dépendances professeur :",
                error
            );

            anneeSelect.innerHTML =
                '<option value="">Erreur de chargement</option>';

            sectionSelect.innerHTML =
                '<option value="">Erreur de chargement</option>';

            anneeSelect.disabled = true;
            sectionSelect.disabled = true;
        });

    });

});
</script>

{% endblock %}
