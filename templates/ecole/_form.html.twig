{{ form_start(form) }}

<div class="row gx-3 gy-1">

    <div class="col-md-6">
        {{ form_row(form.nom) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.adresse) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.phone) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.email) }}
    </div>

</div>

<div class="text-end mt-4">

    <button class="btn btn-primary">
        <i class="ti ti-device-floppy me-1"></i>
        {{ button_label|default('Enregistrer') }}
    </button>

</div>

{{ form_end(form) }}